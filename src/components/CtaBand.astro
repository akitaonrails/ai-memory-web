---
import { site } from '@/data/site';
import { useI18n } from '@/i18n';
interface Props { title?: string; text?: string }
const { t, href } = useI18n(Astro);
const { title = t('cta.title'), text = t('cta.text') } = Astro.props;
---
<section class="band">
  <div class="wrap">
    <div class="cta signal-panel">
      <h2 class="relative text-3xl max-w-[16ch]">{title}</h2>
      <p class="relative lede mt-5">{text}</p>
      <div class="relative mt-9 flex flex-wrap gap-3">
        <a href={href('/install/')} class="btn btn-primary">{t('cta.primary')}</a>
        <a href={site.repo} class="btn cta-ghost">{t('cta.secondary')}</a>
      </div>
    </div>
  </div>
</section>
<style>
  .cta { position: relative; padding: clamp(2rem, 6vw, 5rem); border-top: 3px solid var(--amber); clip-path: polygon(0 0,calc(100% - 24px) 0,100% 24px,100% 100%,0 100%); }
  .cta-ghost { border: 1px solid var(--panel-line); color: var(--panel-text); }
  .cta-ghost:hover { border-color: currentColor; }
</style>

---
// One slide of a Carousel. `id` is the carousel id, `index` is zero-based, `total` the slide count.
import { useI18n } from '@/i18n';
interface Props { id: string; index: number; total: number }
const { id, index, total } = Astro.props;
const { t } = useI18n(Astro);
---
<div class="slide" id={`${id}-s${index}`} role="group" aria-roledescription="slide" aria-label={t('a11y.slideOf', { n: index + 1, total })}>
  <slot />
</div>

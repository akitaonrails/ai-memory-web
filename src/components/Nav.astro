---
import { Image } from 'astro:assets';
import logo from '@/assets/img/logo.png';
import { nav, site } from '@/data/site';
import { getGithub, compact } from '@/data/github';
const gh = await getGithub();
const path = Astro.url.pathname;
---
<header class="site-nav fixed inset-x-0 top-0 z-50" data-nav>
  <div class="wrap flex h-16 items-center gap-6">
    <a href="/" class="flex items-center gap-2.5 shrink-0" aria-label="ai-memory home">
      <Image src={logo} alt="" width={40} height={40} class="size-10 -my-1" loading="eager" />
      <span class="font-display text-[1.35rem] font-semibold tracking-tight" style="font-variation-settings:'opsz' 24,'wdth' 90">ai-memory</span>
    </a>

    <nav class="hidden lg:flex items-center gap-1 ml-4" aria-label="Main">
      {nav.map((group) => (
        <div class="nav-group relative" data-nav-group>
          <button type="button" class="nav-trigger" aria-expanded="false" aria-haspopup="true">
            {group.label}
            <svg width="10" height="10" viewBox="0 0 10 10" aria-hidden="true"><path d="M1.5 3.5 5 7l3.5-3.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
          <div class="nav-panel" role="group" aria-label={group.label}>
            {group.links.map((l) => (
              <a href={l.href} data-hue={l.hue} class="nav-item" aria-current={path === l.href ? 'page' : undefined}>
                <span class="nav-dot" aria-hidden="true"></span>
                <span>
                  <span class="block font-semibold leading-tight">{l.label}</span>
                  <span class="block text-sm text-muted leading-snug mt-0.5">{l.note}</span>
                </span>
              </a>
            ))}
          </div>
        </div>
      ))}
    </nav>

    <div class="ml-auto flex items-center gap-2">
      <a href={site.repo} class="gh-pill hidden sm:inline-flex" aria-label={`Star ai-memory on GitHub, ${gh.stars} stars`}>
        <svg width="18" height="18" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"/></svg>
        <svg width="13" height="13" viewBox="0 0 16 16" fill="var(--amber)" aria-hidden="true"><path d="m8 .9 2.2 4.6 5 .7-3.6 3.5.9 5L8 12.3l-4.5 2.4.9-5L.8 6.2l5-.7z"/></svg>
        <span data-gh="stars" class="tabular-nums font-semibold">{compact(gh.stars)}</span>
      </a>
      <button type="button" class="icon-btn" data-theme-toggle aria-label="Switch between light and dark theme">
        <svg class="hidden dark:block" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
        <svg class="dark:hidden" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z"/></svg>
      </button>
      <a href="/install/" class="btn btn-primary hidden md:inline-flex !py-2.5 !px-4 !text-[0.95rem]">Get started</a>
      <button type="button" class="icon-btn drawer-open" data-drawer-open aria-label="Open menu" aria-expanded="false" aria-controls="drawer">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
      </button>
    </div>
  </div>
</header>

<dialog id="drawer" class="drawer" aria-label="Menu">
  <div class="flex items-center justify-between h-16 px-5">
    <span class="font-display text-xl font-semibold">Menu</span>
    <button type="button" class="icon-btn" data-drawer-close aria-label="Close menu">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>
    </button>
  </div>
  <div class="px-5 pb-10 space-y-7">
    {nav.map((group) => (
      <section>
        <h2 class="text-sm font-semibold text-muted mb-2 !font-sans !tracking-normal">{group.label}</h2>
        <ul>
          {group.links.map((l) => (
            <li><a href={l.href} data-hue={l.hue} class="flex items-center gap-3 py-2.5 text-lg font-semibold"><span class="nav-dot" aria-hidden="true"></span>{l.label}</a></li>
          ))}
        </ul>
      </section>
    ))}
    <div class="flex gap-3 pt-2">
      <a href="/install/" class="btn btn-primary flex-1 justify-center">Get started</a>
      <a href={site.repo} class="btn btn-ghost flex-1 justify-center">GitHub</a>
    </div>
  </div>
</dialog>

<style>
  .site-nav { transition: background-color .3s, border-color .3s, backdrop-filter .3s; border-bottom: 1px solid transparent; }
  .site-nav[data-scrolled] { background: color-mix(in oklch, var(--bg) 78%, transparent); backdrop-filter: saturate(1.6) blur(16px); border-bottom-color: var(--line); }
  .nav-trigger { display: inline-flex; align-items: center; gap: .4em; padding: .5rem .8rem; border-radius: 999px; font-weight: 550; font-size: .97rem; color: var(--muted); transition: color .2s, background-color .2s; }
  .nav-trigger:hover, .nav-trigger[aria-expanded='true'] { color: var(--text); background: var(--tint); }
  .nav-trigger svg { transition: transform .25s var(--ease-out-quint); }
  .nav-trigger[aria-expanded='true'] svg { transform: rotate(180deg); }
  .nav-panel { position: absolute; top: calc(100% + .6rem); left: -0.5rem; width: 23rem; padding: .5rem; background: var(--surface); border: 1px solid var(--line); border-radius: 1.1rem; box-shadow: var(--shadow); opacity: 0; visibility: hidden; transform: translateY(-6px) scale(.98); transform-origin: top left; transition: opacity .18s, transform .25s var(--ease-out-quint), visibility .18s; }
  .nav-group[data-open] .nav-panel { opacity: 1; visibility: visible; transform: none; }
  .nav-item { display: flex; gap: .85rem; padding: .7rem .8rem; border-radius: .75rem; transition: background-color .15s; }
  .nav-item:hover, .nav-item[aria-current] { background: var(--hue-soft); }
  .nav-dot { flex: none; width: .6rem; height: .6rem; margin-top: .4rem; border-radius: 50%; background: var(--hue-vivid); box-shadow: 0 0 0 4px var(--hue-soft); }
  li .nav-dot { margin-top: 0; }
  .gh-pill { align-items: center; gap: .45rem; height: 2.5rem; padding-inline: .8rem; border: 1.5px solid var(--line); border-radius: 999px; font-size: .92rem; transition: border-color .2s; }
  .gh-pill:hover { border-color: var(--text); }
  .icon-btn { display: inline-grid; place-items: center; width: 2.5rem; height: 2.5rem; border-radius: 50%; color: var(--text); transition: background-color .2s; }
  .icon-btn:hover { background: var(--tint); }
  @media (min-width: 64rem) { .drawer-open { display: none; } }
  .drawer { margin: 0; width: 100%; max-width: none; height: 100dvh; max-height: none; background: var(--bg); color: var(--text); overflow-y: auto; }
  .drawer::backdrop { background: transparent; }
  .drawer[open] { animation: drawer-in .35s var(--ease-out-quint); }
  @keyframes drawer-in { from { opacity: 0; transform: translateY(-12px); } }
</style>

<script>
  const header = document.querySelector<HTMLElement>('[data-nav]')!;
  const onScroll = () => header.toggleAttribute('data-scrolled', scrollY > 8);
  addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  // Dropdowns open on hover for mice and on click/keyboard for everyone.
  const groups = [...document.querySelectorAll<HTMLElement>('[data-nav-group]')];
  const setOpen = (g: HTMLElement | null) =>
    groups.forEach((x) => {
      x.toggleAttribute('data-open', x === g);
      x.querySelector('button')!.setAttribute('aria-expanded', String(x === g));
    });
  groups.forEach((g) => {
    let timer = 0;
    g.addEventListener('pointerenter', (e) => { if (e.pointerType === 'mouse') { clearTimeout(timer); setOpen(g); } });
    g.addEventListener('pointerleave', (e) => { if (e.pointerType === 'mouse') timer = window.setTimeout(() => g.hasAttribute('data-open') && setOpen(null), 140); });
    g.querySelector('button')!.addEventListener('click', () => setOpen(g.hasAttribute('data-open') ? null : g));
    g.addEventListener('focusout', (e) => { if (!g.contains(e.relatedTarget as Node)) setOpen(null); });
  });
  addEventListener('keydown', (e) => e.key === 'Escape' && setOpen(null));
  document.addEventListener('click', (e) => { if (!(e.target as HTMLElement).closest('[data-nav-group]')) setOpen(null); });

  const drawer = document.querySelector<HTMLDialogElement>('#drawer')!;
  document.querySelector('[data-drawer-open]')!.addEventListener('click', () => drawer.showModal());
  drawer.addEventListener('click', (e) => { if ((e.target as HTMLElement).closest('[data-drawer-close], a')) drawer.close(); });
</script>

---
// A terminal-style block. Pass the code as the default slot or `code` prop. Lines starting with "# " render as comments.
import { useI18n } from '@/i18n';
interface Props { title?: string; code: string; hue?: string }
const { t } = useI18n(Astro);
const { title = t('code.terminal'), code, hue } = Astro.props;
const lines = code.trim().split('\n');
---
<figure class="code" data-code data-hue={hue} dir="ltr">
  <figcaption>
    <span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
    <span class="title">{title}</span>
    <button type="button" data-copy class="copy"><span data-copy-label data-copied={t('code.copied')}>{t('code.copy')}</span></button>
  </figcaption>
  <pre tabindex="0"><code>{lines.map((l) => <span class:list={['line', { c: l.trimStart().startsWith('#') }]}>{l + '\n'}</span>)}</code></pre>
</figure>
<style>
  /* Terminals stay dark in both themes, like the real thing. */
  .code { background: var(--ink); color: var(--panel-text); border-radius: 2px; border: 1px solid var(--panel-line); overflow: hidden; box-shadow: none; }
  figcaption { display: flex; align-items: center; gap: .75rem; padding: .6rem .6rem .6rem 1rem; border-bottom: 1px solid var(--panel-line); font-size: .875rem; color: var(--panel-muted); }
  .dots { display: flex; gap: .35rem; }
  .dots i { width: .6rem; height: .6rem; border-radius: 50%; background: oklch(0.36 0.045 282); }
  .title { flex: 1; font-family: var(--font-mono); }
  .copy { padding: .3rem .7rem; border-radius: 2px; border: 1px solid var(--panel-line); color: inherit; font-weight: 600; transition: color .2s, border-color .2s; }
  .copy:hover { color: var(--amber); border-color: var(--amber); }
  pre { margin: 0; padding: 1.1rem 1.2rem 1.25rem; overflow-x: auto; font-size: .875rem; line-height: 1.7; }
  .line.c { color: var(--panel-muted); }
</style>

---
import { getGithub } from '@/data/github';
import { site } from '@/data/site';
import { useI18n } from '@/i18n';
const { t, number, htmlLang } = useI18n(Astro);
const gh = await getGithub();
const stats = [
  { n: gh.stars, label: t('stats.stars'), hue: 'amber', live: 'stars', href: `${site.repo}/stargazers` },
  { n: gh.contributors, label: t('stats.contributors'), hue: 'teal', href: `${site.repo}/graphs/contributors` },
  { n: gh.mergedPRs, label: t('stats.mergedPRs'), hue: 'violet', href: `${site.repo}/pulls?q=is%3Apr+is%3Amerged` },
  { n: gh.closedIssues, label: t('stats.closedIssues'), hue: 'green', href: `${site.repo}/issues?q=is%3Aissue+is%3Aclosed` },
];
---
<ul class="grid grid-cols-2 lg:grid-cols-4 gap-x-8 gap-y-10">
  {stats.map((s) => (
    <li>
      <a href={s.href} class="stat" data-hue={s.hue}>
        <span class="num" data-count={s.n} data-count-locale={htmlLang}>{number(s.n)}</span>
        <span class="label">{s.label}</span>
      </a>
    </li>
  ))}
</ul>
<style>
  .stat { display: flex; flex-direction: column; height: 100%; border-top: 3px solid var(--hue-vivid); padding-top: 1rem; }
  .num { font-family: var(--font-display); font-weight: 680; font-size: var(--text-3xl); line-height: 1; letter-spacing: -.015em; font-variant-numeric: tabular-nums; font-variation-settings: 'opsz' 96, 'wdth' 92; }
  .label { margin-top: .5rem; color: var(--muted); }
  .stat:hover .label { color: var(--hue); }
</style>

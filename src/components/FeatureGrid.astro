---
// Short points side by side. Each gets a hue rule on top; no boxes. Keep text to two sentences.
import type { Hue } from '@/data/site';
interface Item { title: string; text: string; hue?: Hue; href?: string; link?: string }
interface Props { items: Item[]; cols?: 2 | 3 | 4 }
const { items, cols = 3 } = Astro.props;
const grid = { 2: 'md:grid-cols-2', 3: 'md:grid-cols-2 lg:grid-cols-3', 4: 'sm:grid-cols-2 lg:grid-cols-4' }[cols];
---
<ul class:list={['grid gap-x-10 gap-y-12', grid]} data-reveal="children">
  {items.map((it) => (
    <li data-hue={it.hue} class="feat">
      <h3 class="text-xl">{it.title}</h3>
      <p class="mt-2.5 text-muted">{it.text}</p>
      {it.href && <a href={it.href} class="mt-3 inline-block font-semibold underline" style="color:var(--hue)">{it.link ?? 'Read more'}</a>}
    </li>
  ))}
</ul>
<style>
  .feat { border-top: 3px solid var(--hue-vivid, var(--line)); padding-top: 1.1rem; }
</style>

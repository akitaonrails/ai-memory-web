---
import { Image } from 'astro:assets';
import environment from '@/assets/img/memory-archive-environment.png';
interface Props { quiet?: boolean }
const { quiet = false } = Astro.props;
---
<div class:list={['archive-backdrop', { quiet }]} aria-hidden="true">
  <Image src={environment} alt="" widths={[640, 960, 1600]} sizes="100vw" format="webp" quality={78} loading="eager" class="environment" />
</div>
<style>
  .archive-backdrop { position: absolute; inset: 0; z-index: -1; overflow: hidden; pointer-events: none; background: #10191e; }
  .environment { width: 100%; height: 100%; object-fit: cover; object-position: center; opacity: .8; }
  .archive-backdrop::after { content: ''; position: absolute; inset: 0; background: linear-gradient(90deg,#0a1217f7 0%,#0a1217d6 35%,#0a121759 70%,#0a12172e),linear-gradient(0deg,#10191e,transparent 30%,transparent 80%,#0a12174d); }
  .quiet .environment { opacity: .32; object-position: center 43%; }
  .quiet::after { background: linear-gradient(90deg,#10191ef5,#10191edb 45%,#10191e80); }
  :global([dir='rtl']) .archive-backdrop { transform: scaleX(-1); }
  @media(max-width: 700px) {
    .environment { object-position: 64% center; opacity: .65; }
    .archive-backdrop::after { background: linear-gradient(180deg,#10191ef5 0%,#10191ee0 36%,#10191e33 70%,#10191ef0); }
    .quiet::after { background: #10191edb; }
  }
</style>

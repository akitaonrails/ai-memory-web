---
// One side of a scroll-scene stage: a small window holding terminal lines, people, captured-event chips or a file tree.
// Lines come from the catalog. Separators inside a line: "Name|what they did" (people), "dir/|file" (tree).
export type SceneKind = 'term' | 'people' | 'chips' | 'tree';
export interface SceneSide { kind: SceneKind; label: string; lines: readonly string[] }
interface Props { side: SceneSide }
const { side } = Astro.props;
const { kind, label, lines } = side;

// Terminal lines: what the person typed is highlighted, tool activity is dimmed, the rest is the agent talking.
const tone = (l: string) => (l.startsWith('>') || l.includes('$') ? 'p' : l.startsWith('●') ? 'd' : '');
const split = (l: string) => l.split('|') as [string, string];
---
<div class:list={['sc', kind]}>
  <header dir="auto">{label}</header>
  <div class="body">
    {kind === 'term' && lines.map((l) => <span dir="auto" class:list={['ln', tone(l)]}>{l}</span>)}
    {kind === 'people' && lines.map(split).map(([who, what]) => (
      <div class="person" dir="auto"><b>{who[0]}</b><div><strong>{who}</strong> <span>{what}</span></div></div>
    ))}
    {kind === 'chips' && lines.map((l) => <span class="chip" dir="auto">{l}</span>)}
    {kind === 'tree' && lines.map(split).map(([dir, file], i) => (
      <span class="ln" dir="ltr">{i === lines.length - 1 ? '└─' : '├─'} <span class="dir">{dir}</span>{file}</span>
    ))}
  </div>
</div>

<style>
  /* Windows stay dark in both themes, like a terminal. --hue-vivid comes from the scene's data-hue. */
  .sc { border-radius: 2px; overflow: hidden; border: 1px solid var(--panel-line); background: var(--ink); color: var(--panel-text); box-shadow: none; font-family: var(--font-mono); font-size: .875rem; line-height: 1.75; }
  header { display: flex; align-items: center; gap: .5rem; padding: .5rem .85rem; border-bottom: 1px solid var(--panel-line); color: var(--panel-muted); font-size: .875rem; }
  header::before { content: ''; width: .55rem; height: .55rem; border-radius: 50%; background: var(--hue-vivid); }
  .body { padding: .8rem .95rem 1rem; }
  .ln { display: block; white-space: pre-wrap; overflow-wrap: anywhere; }
  .ln.p { color: var(--amber); }
  .ln.d { color: var(--panel-muted); }
  .people .body, .chips .body { font-family: var(--font-sans); font-size: .9rem; line-height: 1.35; }
  .person { display: flex; gap: .7rem; align-items: center; padding: .4rem 0; }
  .person b { display: grid; place-items: center; flex: none; width: 2rem; height: 2rem; border-radius: 50%; background: color-mix(in oklch, var(--hue-vivid) 30%, transparent); font-size: .875rem; }
  .person span { color: var(--panel-muted); }
  .chips .body { display: flex; flex-wrap: wrap; gap: .4rem; }
  .chip { padding: .3rem .6rem; border-radius: 2px; background: var(--panel-surface); font-family: var(--font-mono); font-size: .875rem; }
  .dir { color: var(--v-green); }
</style>

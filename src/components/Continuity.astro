---
// Static handoff examples retain the logo’s input → memory → output structure.
import CircuitIcon from './CircuitIcon.astro';
import { useI18n } from '@/i18n';
const { t, raw, href } = useI18n(Astro, 'home');

// Structure here; every word (including the terminal lines) is in home.json under continuity.scenes.<id>.
const sceneMeta = [
  { id: 'agents', hue: 'violet', href: '/solutions/individuals/', inKind: 'term', outKind: 'term' },
  { id: 'machines', hue: 'azure', href: '/solutions/individuals/#machines', inKind: 'term', outKind: 'term' },
  { id: 'team', hue: 'teal', href: '/solutions/teams/', inKind: 'people', outKind: 'term' },
  { id: 'wiki', hue: 'green', href: '/architecture/', inKind: 'chips', outKind: 'tree' },
] as const;
import SceneCard, { type SceneSide } from './SceneCard.astro';

interface SceneText { title: string; text: string; link: string; inLabel: string; in: string[]; outLabel: string; out: string[] }
const scenes = sceneMeta.map((m) => {
  const x = raw<SceneText>(`continuity.scenes.${m.id}`);
  return { ...m, href: href(m.href), title: x.title, text: x.text, link: x.link,
    in: { kind: m.inKind, label: x.inLabel, lines: x.in } as SceneSide,
    out: { kind: m.outKind, label: x.outLabel, lines: x.out } as SceneSide };
});
---

<section class="continuity band">
  <div class="wrap">
    <h2 class="text-3xl max-w-[24ch]">{t('continuity.title')}</h2>
    <div class="continuity-scenes">
      {scenes.map((s, i) => (
        <article class="continuity-scene" data-hue={s.hue}>
          <div class="scene-intro">
            <span class="scene-number" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="text-2xl">{s.title}</h3>
            <p class="text-muted mt-4">{s.text}</p>
            <a href={s.href} class="more-link">{s.link}</a>
          </div>
          <div class="scene-circuit signal-panel" dir="ltr">
            <SceneCard side={s.in} />
            <div class="scene-hub" aria-hidden="true"><CircuitIcon kind="chip" /></div>
            <SceneCard side={s.out} />
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
<style>
  .continuity { border-block: 1px solid var(--line); }
  .continuity-scenes { display: grid; gap: 3rem; margin-top: 3rem; }
  .continuity-scene { display: grid; grid-template-columns: minmax(0,1fr) minmax(0,2fr); gap: 2rem; align-items: center; }
  .scene-number { display: block; font: .875rem var(--font-mono); color: var(--hue); margin-bottom: 1rem; }
  .scene-intro p { max-width: 32em; }
  .more-link { display: inline-block; margin-top: 1.2rem; color: var(--hue); font-weight: 600; text-decoration: underline; }
  .scene-circuit { display: grid; grid-template-columns: minmax(0,1fr) 5rem minmax(0,1fr); align-items: center; padding: 1.5rem; border-inline-start: 3px solid var(--amber); }
  .scene-hub { position: relative; color: var(--amber); }
  .scene-hub::before { content: ''; position: absolute; inset-inline: 0; top: 50%; border-top: 2px solid var(--amber); }
  .scene-hub :global(svg) { position: relative; background: var(--ink); width: 100%; }
  .scene-hub :global(.chip-page) { fill: var(--amber); stroke: var(--ink); }
  @media(max-width:1100px) { .continuity-scene { grid-template-columns: 1fr; } }
  @media(max-width:600px) {
    .scene-circuit { grid-template-columns: minmax(0,1fr); padding: 1.25rem; }
    .scene-hub { width: 5rem; justify-self: center; }
    .scene-hub::before { inset-block: 0; left: 50%; top: 0; border-top: 0; border-left: 2px solid var(--amber); }
  }
</style>

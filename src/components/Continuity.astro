---
// The signature scroll scene. It has the same shape as the logo: something goes in on the left,
// passes through the memory, and comes out on the right. Four times over, only the two sides change.
// Desktop: pinned, scrubbed by scroll. Below lg: the same four scenes as a plain stacked list.
import { Image } from 'astro:assets';
import logo from '@/assets/img/logo.png';
import { useI18n } from '@/i18n';
const { t, raw, href } = useI18n(Astro, 'home');

// Structure here; every word (including the terminal lines) is in home.json under continuity.scenes.<id>.
const sceneMeta = [
  { id: 'agents', hue: 'violet', href: '/solutions/individuals/', inKind: 'term', outKind: 'term' },
  { id: 'machines', hue: 'azure', href: '/solutions/individuals/#machines', inKind: 'term', outKind: 'term' },
  { id: 'team', hue: 'teal', href: '/solutions/teams/', inKind: 'people', outKind: 'term' },
  { id: 'wiki', hue: 'green', href: '/architecture/', inKind: 'chips', outKind: 'tree' },
] as const;
import SceneCard, { type SceneSide } from './SceneCard.astro';

interface SceneText { title: string; text: string; link: string; inLabel: string; in: string[]; outLabel: string; out: string[] }
const scenes = sceneMeta.map((m) => {
  const x = raw<SceneText>(`continuity.scenes.${m.id}`);
  return { ...m, href: href(m.href), title: x.title, text: x.text, link: x.link,
    in: { kind: m.inKind, label: x.inLabel, lines: x.in } as SceneSide,
    out: { kind: m.outKind, label: x.outLabel, lines: x.out } as SceneSide };
});
---

<section class="continuity" data-continuity aria-label={t('continuity.label')}>
  <!-- Desktop: pinned -->
  <div class="pin hidden lg:block">
    <div class="wrap h-full grid grid-cols-[minmax(0,4fr)_minmax(0,8fr)] gap-10 items-center">
      <div>
        <h2 class="text-3xl max-w-[11ch] xl:max-w-[16ch]">{t('continuity.title')}</h2>
        <ol class="mt-10 space-y-1">
          {scenes.map((s, i) => (
            <li class="step" data-step={i} data-hue={s.hue}>
              <span class="bar" aria-hidden="true"><i></i></span>
              <h3 class="text-xl">{s.title}</h3>
              <div class="more"><div>
                <p class="text-muted mt-2 max-w-[30em]">{s.text}</p>
                <a href={s.href} class="more-link">{s.link}</a>
              </div></div>
            </li>
          ))}
        </ol>
      </div>

      <div class="stage" dir="ltr">
        <div class="flow" aria-hidden="true"></div>
        {scenes.map((s, i) => (
          <div class="art" data-art={i} data-hue={s.hue}>
            <div class="side in"><SceneCard side={s.in} /></div>
            <div class="side out"><SceneCard side={s.out} /></div>
          </div>
        ))}
        <div class="hub"><Image src={logo} alt="" width={260} height={260} loading="lazy" /></div>
      </div>
    </div>
  </div>

  <!-- Mobile and tablet: stacked -->
  <div class="lg:hidden wrap band">
    <h2 class="text-3xl max-w-[12ch]">{t('continuity.title')}</h2>
    <div class="mt-12 space-y-16">
      {scenes.map((s) => (
        <article data-hue={s.hue}>
          <h3 class="text-2xl">{s.title}</h3>
          <p class="text-muted mt-3">{s.text}</p>
          <div class="stack mt-6" dir="ltr">
            <SceneCard side={s.in} />
            <div class="down" aria-hidden="true"><Image src={logo} alt="" width={72} height={72} loading="lazy" /></div>
            <SceneCard side={s.out} />
          </div>
          <a href={s.href} class="more-link">{s.link}</a>
        </article>
      ))}
    </div>
  </div>
</section>

<script>
  import { gsap, ScrollTrigger, mm } from '@/scripts/motion';

  const root = document.querySelector<HTMLElement>('[data-continuity]');
  if (root) {
    const steps = [...root.querySelectorAll<HTMLElement>('[data-step]')];
    const arts = [...root.querySelectorAll<HTMLElement>('[data-art]')];
    const activate = (i: number) => {
      steps.forEach((s, n) => s.toggleAttribute('data-active', n === i));
      arts.forEach((a, n) => a.toggleAttribute('data-active', n === i));
    };
    activate(0);

    mm.add('(min-width: 1024px) and (prefers-reduced-motion: no-preference)', () => {
      const n = steps.length;
      const st = ScrollTrigger.create({
        trigger: root, start: 'top top', end: () => `+=${innerHeight * n * 0.9}`, pin: root.querySelector('.pin'), scrub: true,
        onUpdate: (self) => {
          const p = Math.min(self.progress * n, n - 0.0001);
          const i = Math.floor(p);
          activate(i);
          steps.forEach((s, k) => s.style.setProperty('--p', String(k < i ? 1 : k === i ? p - i : 0)));
        },
      });
      gsap.to(root.querySelector('.hub img'), { rotate: 8, scale: 1.06, ease: 'none', scrollTrigger: { trigger: root, start: 'top top', end: () => st.end, scrub: true } });
      return () => st.kill();
    });

    // Without the pin (reduced motion), the step titles still switch the scene.
    steps.forEach((s, i) => s.addEventListener('click', () => {
      const st = ScrollTrigger.getAll().find((t) => t.trigger === root && t.pin);
      if (st) scrollTo({ top: st.start + ((st.end - st.start) * (i + 0.5)) / steps.length, behavior: 'smooth' });
      else activate(i);
    }));
  }
</script>

<style is:global>
  .continuity .pin { height: 100vh; min-height: 40rem; }
  .continuity .step { position: relative; padding-block: .9rem; padding-inline-start: 1.5rem; cursor: pointer; opacity: .42; transition: opacity .4s; }
  .continuity .step[data-active] { opacity: 1; }
  .continuity .step .bar { position: absolute; inset-inline-start: 0; top: .9rem; bottom: .9rem; width: 3px; border-radius: 3px; background: var(--line); overflow: hidden; }
  .continuity .step .bar i { position: absolute; inset: 0; background: var(--hue-vivid); transform-origin: top; transform: scaleY(var(--p, 0)); }
  .continuity .step .more { display: grid; grid-template-rows: 0fr; transition: grid-template-rows .5s var(--ease-out-quint); }
  .continuity .step .more > div { overflow: hidden; }
  .continuity .step[data-active] .more { grid-template-rows: 1fr; }
  .continuity .more-link { display: inline-block; margin-top: .9rem; font-weight: 600; color: var(--hue); text-decoration: underline; text-decoration-thickness: 1.5px; }

  .continuity .stage { position: relative; height: min(34rem, 70vh); }
  .continuity .flow { position: absolute; left: 4%; right: 4%; top: 50%; height: 6px; translate: 0 -50%; background: radial-gradient(circle, var(--amber) 2.5px, transparent 3px) 0 50% / 18px 6px repeat-x; animation: flow .9s linear infinite; }
  @keyframes flow { to { background-position-x: 18px; } }
  .continuity .hub { position: absolute; left: 50%; top: 50%; translate: -50% -50%; width: clamp(8rem, 13vw, 12rem); filter: drop-shadow(0 0 40px color-mix(in oklch, var(--v-violet) 45%, transparent)); }
  .continuity .art { position: absolute; inset: 0; display: grid; grid-template-columns: minmax(0, 1fr) clamp(11rem, 19vw, 17rem) minmax(0, 1fr); align-items: center; pointer-events: none; }
  .continuity .art .side { transition: opacity .5s, transform .7s var(--ease-out-quint), filter .5s; opacity: 0; filter: blur(6px); }
  .continuity .art .in { grid-column: 1; transform: translateX(-2.5rem) scale(.96); }
  .continuity .art .out { grid-column: 3; transform: translateX(2.5rem) scale(.96); }
  .continuity .art[data-active] .side { opacity: 1; transform: none; filter: none; pointer-events: auto; }
  .continuity .art[data-active] .out { transition-delay: .18s; }

  .continuity .stack { display: grid; gap: .25rem; }
  .continuity .down { display: grid; place-items: center; position: relative; height: 5.5rem; }
  .continuity .down::before { content: ''; position: absolute; top: 0; bottom: 0; left: 50%; border-left: 3px dotted var(--amber); translate: -50% 0; }
  .continuity .down img { position: relative; width: 4.5rem; }
</style>

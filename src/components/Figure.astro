---
// Native diagrams share the Signal Bureau visual language; screenshots retain their original pixels.
import { Image } from 'astro:assets';
import Diagram from './Diagram.astro';
import { diagrams } from '@/data/diagrams';
interface Props { name?: string; src?: ImageMetadata; alt: string; caption?: string; zoom?: boolean }
const { name, src, alt, caption } = Astro.props;
if (!src && !diagrams[name ?? '']) throw new Error(`Figure: no diagram or image for "${name}"`);
---
<figure class="fig" aria-label={name && diagrams[name] ? alt || undefined : undefined}>
  {name && diagrams[name] ? <Diagram name={name} /> : (
    <div class="frame" dir="ltr">
      <Image src={src!} alt={alt} widths={[640, 960, 1280, 1920]} sizes="(min-width: 1280px) 1216px, 94vw" quality={82} class="w-full h-auto block" />
    </div>
  )}
  {caption && <figcaption>{caption}</figcaption>}
</figure>
<style>
  .fig { margin-block: clamp(2.5rem, 6vw, 5rem); }
  .frame { border-radius: 2px; overflow: hidden; background: var(--ink); border: 1px solid var(--line); box-shadow: var(--shadow); }
  figcaption { margin-top: 1rem; color: var(--muted); font-size: .95rem; max-width: 46em; }
</style>

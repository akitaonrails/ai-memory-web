---
import { Image } from 'astro:assets';
import Base from '@/layouts/Base.astro';
import Continuity from '@/components/Continuity.astro';
import CodeBlock from '@/components/CodeBlock.astro';
import Tabs from '@/components/Tabs.astro';
import GithubStats from '@/components/GithubStats.astro';
import CtaBand from '@/components/CtaBand.astro';
import Figure from '@/components/Figure.astro';
import logo from '@/assets/img/logo.png';
import howItWorks from '@/assets/img/gen/how-it-works.webp';
import { site } from '@/data/site';
import { harnesses } from '@/data/support';
import { competitors } from '@/data/competitors';
import { getGithub, compact } from '@/data/github';

const gh = await getGithub();
const latest = gh.releases.find((r) => !r.prerelease) ?? gh.releases[0];
const featured = competitors.filter((c) => c.featured);

const paths = [
  { hue: 'violet', who: 'I work alone', title: 'Stop re-explaining your project', text: 'Three commands to install. You need no account and no API key.', href: '/solutions/individuals/', cta: 'ai-memory for individuals' },
  { hue: 'teal', who: 'I run a small team', title: 'One memory for everyone’s agents', text: 'Onboard people by letting them ask the project.', href: '/solutions/teams/', cta: 'ai-memory for teams' },
  { hue: 'amber', who: 'I already use a memory tool', title: 'See what carries over and what you gain', text: 'Mem0, Zep, cognee, OpenViking, Claude’s own memory.', href: '/compare/', cta: 'Compare and migrate' },
  { hue: 'green', who: 'I want to contribute', title: 'A Rust codebase with an active issue tracker', text: `${gh.contributors} people have landed code so far.`, href: '/contribute/', cta: 'Start contributing' },
];

const steps = [
  { title: 'Capture', text: 'Lifecycle hooks record prompts, tool calls and session boundaries. Secrets are stripped before anything is stored.' },
  { title: 'Consolidate', text: 'When a session ends, its observations become a readable markdown page in the project’s wiki.' },
  { title: 'Recall', text: 'The next session gets a short brief and can search everything: full text, entities, links and vectors, fused into one ranking.' },
  { title: 'Hand off', text: 'The next session picks up the baton, and only one session can claim it. It works across agents and across every machine that reaches the server.' },
];

const solo = `# 1. Install the binary (or grab it from the downloads page)
mise use -g github:akitaonrails/ai-memory

# 2. Start the server. It listens on this machine only.
ai-memory init
ai-memory serve --transport http --bind 127.0.0.1:49374

# 3. Launch your agent through it. Hooks and MCP wire themselves.
ai-memory run claude`;

const team = `# On the server: a homelab box or any LAN host
TOKEN=$(ai-memory generate-auth-token)
docker run -d --name ai-memory --restart unless-stopped \\
  -p 0.0.0.0:49374:49374 -v ai-memory-data:/data \\
  -e AI_MEMORY_AUTH_TOKEN="$TOKEN" \\
  -e AI_MEMORY_ALLOWED_HOSTS="<server-ip>,localhost" \\
  akitaonrails/ai-memory:latest

# On every machine, for every teammate
export AI_MEMORY_SERVER_URL="http://<server-ip>:49374"
export AI_MEMORY_AUTH_TOKEN="<their key>"
ai-memory run claude`;
---
<Base>
  <!-- Hero -->
  <section class="hero">
    <div class="hero-aura" aria-hidden="true"></div>
    <div class="wrap relative grid lg:grid-cols-[minmax(0,7fr)_minmax(0,5fr)] gap-10 items-center pt-32 pb-16 md:pt-40 lg:pt-44 lg:pb-24">
      <div>
        <a href="/download/" class="release-pill">
          <span class="dot" aria-hidden="true"></span>
          {latest.tag} is out
          <span class="text-muted">See what changed</span>
        </a>
        <h1 class="mt-7 text-4xl spectrum-text pb-2">Switch agents. Keep the context.</h1>
        <p class="lede mt-6">
          ai-memory is long-term memory for AI coding agents. Quit Claude Code mid-task, open Codex in the same directory, and carry on without re-explaining the architecture, the failed approaches or the open questions.
        </p>
        <div class="mt-9 flex flex-wrap gap-3">
          <a href="/install/" class="btn btn-primary">Set it up in 5 minutes</a>
          <a href={site.repo} class="btn btn-ghost">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="var(--amber)" aria-hidden="true"><path d="m8 .9 2.2 4.6 5 .7-3.6 3.5.9 5L8 12.3l-4.5 2.4.9-5L.8 6.2l5-.7z"/></svg>
            Star on GitHub
            <span data-gh="stars" class="tabular-nums text-muted">{compact(gh.stars)}</span>
          </a>
        </div>
        <ul class="facts mt-9">
          <li>Open source, MIT</li>
          <li>One binary, plain markdown</li>
          <li>Works with no API key</li>
        </ul>
      </div>
      <div class="hero-mark" aria-hidden="true">
        <div data-parallax="0.12"><Image src={logo} alt="" width={640} height={640} loading="eager" fetchpriority="high" class="w-full h-auto" /></div>
      </div>
    </div>

    <div class="marquee" aria-label={`Works with ${harnesses.length} coding agents, including ${harnesses.slice(0, 6).map((h) => h.name).join(', ')}`}>
      <div class="track" aria-hidden="true">
        {[...harnesses, ...harnesses].map((h) => <span>{h.name}</span>)}
      </div>
    </div>
  </section>

  <!-- The problem, in one breath -->
  <section class="band">
    <div class="wrap">
      <p class="statement" data-fill>
        Your coding agent already takes notes. They live on one machine, belong to one agent, and disappear the moment you switch tools or teammates. ai-memory is what is on the other side of those walls.
      </p>
    </div>
  </section>

  <Continuity />

  <!-- Pick a path -->
  <section class="band">
    <div class="wrap">
      <h2 class="text-3xl">Start where you are.</h2>
      <div class="mt-12 grid md:grid-cols-2 gap-4" data-reveal="children">
        {paths.map((p) => (
          <a href={p.href} class="path" data-hue={p.hue}>
            <span class="who">{p.who}</span>
            <h3 class="mt-5 text-2xl max-w-[16ch]">{p.title}</h3>
            <p class="mt-3 text-muted">{p.text}</p>
            <span class="go">{p.cta}<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- How it works -->
  <section class="band !pt-0" id="how">
    <div class="wrap">
      <h2 class="text-3xl max-w-[18ch]">What happens while you work.</h2>
      <p class="lede mt-5">All four steps run in the background, and the default path makes zero LLM calls.</p>
      <Figure src={howItWorks} alt="Diagram: terminals emit observations that are consolidated into markdown pages, searched through fused ranking, and handed off to the next agent. Underneath it all sits a git-backed wiki of plain markdown files." />
      <ol class="grid sm:grid-cols-2 lg:grid-cols-4 gap-x-8 gap-y-10">
        {steps.map((s, i) => (
          <li data-hue={['green', 'teal', 'azure', 'violet'][i]} class="how-step">
            <span class="n">{i + 1}</span>
            <h3 class="text-xl mt-3">{s.title}</h3>
            <p class="mt-2 text-muted">{s.text}</p>
          </li>
        ))}
      </ol>
      <p class="mt-12"><a href="/architecture/" class="btn btn-ghost">Read the architecture</a></p>
    </div>
  </section>

  <!-- Compare -->
  <section class="band bg-tint">
    <div class="wrap grid lg:grid-cols-[minmax(0,4fr)_minmax(0,8fr)] gap-12">
      <div>
        <h2 class="text-3xl">Coming from another tool?</h2>
        <p class="mt-5 text-muted max-w-[28em]">Most memory tools need an LLM, a vector store or a graph database before they remember anything. ai-memory needs one binary and a folder.</p>
        <a href="/compare/" class="btn btn-ghost mt-8">Full comparison, including where they win</a>
      </div>
      <div data-compare>
        <div class="flex flex-wrap gap-2" role="tablist" aria-label="Pick the tool you use today">
          {featured.map((c, i) => (
            <button type="button" role="tab" class="pick" aria-selected={i === 0 ? 'true' : 'false'} aria-controls={`cmp-${c.id}`} id={`cmpt-${c.id}`}>{c.name}</button>
          ))}
        </div>
        {featured.map((c, i) => (
          <div role="tabpanel" id={`cmp-${c.id}`} aria-labelledby={`cmpt-${c.id}`} hidden={i !== 0} class="card mt-5 p-7 md:p-9">
            <p class="text-sm text-muted">{c.kind}. It needs: {c.needs.join(', ')}.</p>
            <div class="mt-6 grid md:grid-cols-2 gap-8">
              <div>
                <h3 class="text-lg text-muted">What stays the same</h3>
                <p class="mt-2">{c.same}</p>
              </div>
              <div>
                <h3 class="text-lg" style="color:var(--amber-ink)">What you gain</h3>
                <ul class="mt-2 space-y-2">
                  {c.gain.map((g) => <li class="gain">{g}</li>)}
                </ul>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Quick start -->
  <section class="band" id="quickstart">
    <div class="wrap grid lg:grid-cols-[minmax(0,4fr)_minmax(0,8fr)] gap-12">
      <div>
        <h2 class="text-3xl">Running in five minutes.</h2>
        <p class="mt-5 text-muted max-w-[28em]">There is no sign-up. The default install listens on your machine only, so nothing else can reach it.</p>
        <ul class="mt-8 space-y-3 font-semibold">
          <li><a class="underline" href="/install/">Every install path, step by step</a></li>
          <li><a class="underline" href="/integrations/">Check your agent and OS</a></li>
          <li><a class="underline" href="/download/">Download {latest.tag}</a></li>
        </ul>
      </div>
      <div class="min-w-0">
        <Tabs id="qs" labels={['Just me', 'My team']}>
          <CodeBlock slot="0" title="one machine" code={solo} />
          <CodeBlock slot="1" title="one server, many machines" code={team} />
        </Tabs>
      </div>
    </div>
  </section>

  <!-- Open source -->
  <section class="band !pt-0">
    <div class="wrap">
      <h2 class="text-3xl max-w-[18ch]">Built in the open, by a lot of people.</h2>
      <div class="mt-12"><GithubStats /></div>
      <div class="mt-12 flex flex-wrap items-center gap-x-6 gap-y-5">
        <ul class="flex -space-x-2.5">
          {gh.people.slice(0, 14).map((p) => (
            <li><a href={p.url} title={p.login}><img src={`${p.avatar}&s=88`} alt={p.login} width="44" height="44" loading="lazy" class="size-11 rounded-full ring-2 ring-bg" /></a></li>
          ))}
        </ul>
        <p class="text-muted max-w-[30em]">New here? <a href="/contribute/" class="underline font-semibold text-text">The contributing page</a> shows where bug reports, pull requests and new agent integrations go.</p>
      </div>
    </div>
  </section>

  <CtaBand />
</Base>

<script>
  // Compare picker: plain tabs.
  document.querySelectorAll<HTMLElement>('[data-compare]').forEach((root) => {
    const tabs = [...root.querySelectorAll<HTMLElement>('[role=tab]')];
    tabs.forEach((t) => t.addEventListener('click', () => tabs.forEach((x) => {
      x.setAttribute('aria-selected', String(x === t));
      document.getElementById(x.getAttribute('aria-controls')!)!.hidden = x !== t;
    })));
  });
</script>

<style>
  .hero { position: relative; overflow: clip; }
  .hero-aura { position: absolute; inset: -20% -10% 0 35%; background: conic-gradient(from 210deg at 60% 45% in oklch, var(--v-green), var(--v-teal), var(--v-azure), var(--v-violet), var(--v-rose), var(--v-green)); filter: blur(110px); opacity: .28; pointer-events: none; }
  :global([data-theme='light']) .hero-aura { opacity: .2; }
  .release-pill { display: inline-flex; align-items: center; gap: .6rem; padding: .4rem .9rem; border-radius: 999px; border: 1px solid var(--line); background: color-mix(in oklch, var(--surface) 70%, transparent); font-size: .9rem; font-weight: 600; }
  .release-pill .dot { width: .5rem; height: .5rem; border-radius: 50%; background: var(--v-green); box-shadow: 0 0 0 4px color-mix(in oklch, var(--v-green) 25%, transparent); }
  .release-pill:hover { border-color: var(--text); }
  .facts { display: flex; flex-wrap: wrap; gap: .5rem 1.75rem; color: var(--muted); font-size: .95rem; }
  .facts li { display: flex; align-items: center; gap: .5rem; }
  .facts li::before { content: ''; width: .9rem; height: .5rem; border-left: 2px solid var(--green); border-bottom: 2px solid var(--green); rotate: -45deg; translate: 0 -2px; }
  .hero-mark { max-width: 30rem; margin-inline: auto; width: 100%; filter: drop-shadow(0 30px 80px color-mix(in oklch, var(--v-violet) 40%, transparent)); animation: mark-in 1.4s var(--ease-out-quint) both; }
  @keyframes mark-in { from { opacity: 0; transform: scale(.82) rotate(-6deg); filter: blur(12px); } }

  .marquee { position: relative; overflow: hidden; border-block: 1px solid var(--line); padding-block: 1.1rem; mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent); }
  .track { display: flex; gap: 3rem; width: max-content; animation: slide 70s linear infinite; font-family: var(--font-display); font-weight: 600; font-size: 1.15rem; color: var(--muted); white-space: nowrap; }
  .marquee:hover .track { animation-play-state: paused; }
  @keyframes slide { to { transform: translateX(-50%); } }

  .statement { font-family: var(--font-display); font-weight: 600; font-size: var(--text-3xl); line-height: 1.12; letter-spacing: -.012em; max-width: 22em; font-variation-settings: 'opsz' 96, 'wdth' 94; }

  .path { position: relative; display: flex; flex-direction: column; padding: clamp(1.5rem, 3vw, 2.5rem); border-radius: 1.5rem; background: var(--hue-soft); overflow: hidden; transition: transform .4s var(--ease-out-quint); }
  .path:hover { transform: translateY(-4px); }
  .path .who { align-self: flex-start; padding: .3rem .8rem; border-radius: 999px; background: var(--surface); color: var(--hue); font-weight: 600; font-size: .9rem; }
  .path .go { margin-top: auto; padding-top: 2rem; display: inline-flex; align-items: center; gap: .5rem; font-weight: 600; color: var(--hue); }
  .path .go svg { transition: transform .3s var(--ease-out-quint); }
  .path:hover .go svg { transform: translateX(5px); }

  .how-step .n { display: inline-grid; place-items: center; width: 2.25rem; height: 2.25rem; border-radius: 50%; background: var(--hue-soft); color: var(--hue); font-family: var(--font-display); font-weight: 700; }

  .pick { padding: .55rem 1rem; border-radius: 999px; border: 1.5px solid var(--line); font-weight: 600; font-size: .95rem; background: var(--surface); transition: border-color .2s, background-color .2s, color .2s; }
  .pick:hover { border-color: var(--text); }
  .pick[aria-selected='true'] { background: var(--text); border-color: var(--text); color: var(--bg); }
  .gain { position: relative; padding-left: 1.5rem; }
  .gain::before { content: ''; position: absolute; left: 0; top: .6em; width: .8rem; height: 3px; border-radius: 3px; background: var(--amber); }
</style>

---
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/PageHero.astro';
import Section from '@/components/Section.astro';
import FeatureGrid from '@/components/FeatureGrid.astro';
import Steps from '@/components/Steps.astro';
import CodeBlock from '@/components/CodeBlock.astro';
import Figure from '@/components/Figure.astro';
import Callout from '@/components/Callout.astro';
import NextPages from '@/components/NextPages.astro';
import CtaBand from '@/components/CtaBand.astro';
import stackImg from '@/assets/img/gen/compare-stack.webp';
import sideBySideImg from '@/assets/img/gen/compare-side-by-side.webp';
import { site, type Hue } from '@/data/site';
import { competitors, moat } from '@/data/competitors';

// (a) What each family of tools optimizes. Families come from the repo's own comparison.
const families = [
  { title: 'Fact extractors', text: 'Mem0 and LangMem ask an LLM to pull atomic facts out of every turn. Built to personalize an app for its end users.', hue: 'green' as Hue },
  { title: 'Temporal graphs', text: 'Zep, Graphiti and cognee model knowledge as a graph over time. Built for graph queries, on top of a graph database.', hue: 'azure' as Hue },
  { title: 'Memory operating systems', text: 'Letta and MemGPT let the agent edit its own tiered memory. Built for people who adopt their agent runtime.', hue: 'violet' as Hue },
  { title: 'Hosted APIs', text: 'Supermemory and the managed clouds keep your memory behind an account. Built for connectors and zero operations.', hue: 'rose' as Hue },
];

const moatHues: Hue[] = ['amber', 'green', 'azure', 'violet', 'rose', 'teal'];
const moatItems = moat.map((m, i) => ({ ...m, hue: moatHues[i % moatHues.length] }));

// (c) Moving parts per tool. Each mark restates the `needs` list in competitors.ts; the last column prints that list as is.
const parts = ['An LLM', 'A vector or embedding service', 'A graph database', 'Another runtime or database', 'A cloud account'];
const requires: Record<string, number[]> = {
  'claude-memory': [],
  mem0: [0, 1],
  zep: [0, 2],
  cognee: [0, 1, 2, 3],
  openviking: [0, 1, 3],
  'basic-memory': [],
  'mcp-memory-service': [],
  agentmemory: [3],
  letta: [3],
  supermemory: [4],
};

// (e) LongMemEval-S hit@5. Source: docs/benchmarks in the repo, dated 2026-09-01.
const ours = [
  { label: 'ai-memory before 2.0', note: 'Full text only', value: 0.617 },
  { label: 'ai-memory, full text only', note: 'Stopword filtering added', value: 0.668 },
  { label: 'ai-memory 2.0 default', note: 'Local embeddings, no API key', value: 0.823 },
];
const theirs = [
  { label: 'mcp-memory-service', note: 'Vendor reported, session level', value: 0.86 },
  { label: 'agentmemory', note: 'Vendor reported, with reranking', value: 0.952 },
];

const behind = [
  { title: 'No local reranker', text: 'Retrieval scores sit below the systems that rerank. An LLM reranker exists and is off by default. A zero-cost local one does not exist yet.' },
  { title: 'Typed links do not move ranking', text: 'Links between pages explain a result. They carry no ranking weight today, and evidence strength is recorded without affecting order.' },
  { title: 'One timeline', text: 'Point-in-time search uses the time a fact was recorded. Zep models both when something happened and when it was learned.' },
  { title: 'Text from coding sessions only', text: 'No PDF, CSV or image ingestion, no vision model, and it is not a graph database you can query with Cypher.' },
  { title: 'One server, no hosted tier', text: 'Many machines reach one server that you run. There is no automatic replication, no SaaS and no enterprise console.' },
  { title: 'More setup than built-in memory', text: 'Claude Code’s own memory is already on. ai-memory asks a solo developer to start a server first.' },
];

const moveSteps = [
  {
    title: 'Install it next to what you have',
    text: `ai-memory adds its own MCP entry and its own hooks, and leaves the entries of other tools in place. <a href="/install/">The quick setup</a> takes about five minutes.`,
  },
  {
    title: 'Seed the wiki from the project itself',
    text: '<code>ai-memory bootstrap</code> reads your git history, README, <code>docs/</code> and agent rules files, then writes seed pages. It needs an LLM provider. Run the dry run first to see what would be sent. Review what lands: an LLM can write plausible details that are wrong, and the wiki is in git so you can revert.',
    code: `cd /path/to/project\nai-memory bootstrap --dry-run\nai-memory bootstrap`,
    codeTitle: 'existing project',
  },
  {
    title: 'Bring old notes and conversations, if the importer reads them',
    text: `The standalone importer under <code>companions/ai-memory-importer</code> reads two things today: oh-my-claudecode (OMC) markdown wiki folders, and conversations in a small generic JSON envelope. It has no Mem0, Zep or cognee adapter, so exports from those need converting to the envelope first. It defaults to a dry run and never deletes.`,
    code: `cargo run --manifest-path companions/ai-memory-importer/Cargo.toml -- \\\n  omc-wiki --dir /path/to/omc/wiki --workspace default --project my-project`,
    codeTitle: 'dry run, from a checkout of the repo',
  },
  {
    title: 'Run both for a while, then decide',
    text: 'Keep the old tool connected while you compare. Ask both the same questions about your project. Remove whichever one you stopped reaching for.',
  },
];

const faq = [
  { q: 'Do I need an LLM API key?', a: 'No. Capture, search and handoffs work with no key and no LLM. Adding a provider turns on LLM consolidation, bootstrap, richer linting, auto-improve and optional reranking. Subscription logins such as Codex or GitHub Copilot also work as providers.' },
  { q: 'Is there a hosted version?', a: 'No. ai-memory is a single server that you run on a laptop, a homelab box or a LAN host. There is no SaaS tier and no enterprise console.' },
  { q: 'Can I import my data from Mem0, Zep or cognee?', a: 'Not directly. The companion importer reads oh-my-claudecode markdown wikis and a generic conversation JSON format. Adapters for specific products live outside the repository. For an existing codebase, ai-memory bootstrap seeds the wiki from git history and docs.' },
  { q: 'Can I run ai-memory next to my current memory tool?', a: 'Yes. It installs as its own MCP server entry and its own lifecycle hooks, and it leaves other tools’ configuration alone. You can compare both on the same project before removing either.' },
  { q: 'How does its retrieval score compare?', a: 'On LongMemEval-S it scores 0.823 hit@5 with the default local embeddings and 0.668 with full text only. That measures retrieval, not answer accuracy. Systems that rerank score higher: agentmemory reports 0.952 and mcp-memory-service reports 0.860 at session level.' },
  { q: 'Does it sync memory between machines?', a: 'It uses one server that all of your machines reach over the network. There is no automatic replication between servers.' },
];
const faqSchema = {
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---
<Base
  title="Alternative to Mem0, Zep, cognee and OpenViking"
  description="A fair comparison of ai-memory with Mem0, Zep, cognee, Letta, OpenViking and Claude's own memory: what carries over, what you gain and where they win."
  schema={[faqSchema]}
>
  <PageHero
    hue="amber"
    kicker="Solutions"
    title="Migrating from another memory tool"
    lede="Every memory tool is built around one bet. This page says what each of them is for, what changes if you move, and where ai-memory is the weaker choice."
  >
    <a href="#tools" class="btn btn-primary">Find the tool you use</a>
    <a href="#behind" class="btn btn-ghost">See where ai-memory is behind</a>
  </PageHero>

  <Section title="Each tool optimizes one thing" lede="ai-memory optimizes a git-backed wiki of markdown pages with a derived search index, and it makes zero LLM calls by default. The others made different bets, for different buyers." hue="amber" fill>
    <FeatureGrid items={families} cols={4} />
  </Section>

  <Section title="What no other tool has all of" lede="The project audited its competitors against its own code. Most have one or two of these six. None has every one." hue="amber" tint>
    <FeatureGrid items={moatItems} cols={3} />
    <div class="mt-14">
      <Callout title="What “teams” means here" hue="teal">
        <p>Accounts give you attribution and an audit log. They are not a tenancy boundary: every user on a server sees every project on it. Plan for one team per server.</p>
      </Callout>
    </div>
  </Section>

  <Section id="stack" title="What you have to run" lede="The quickest way to compare memory tools is to count the services each one needs before it remembers anything." hue="amber">
    <Figure src={stackImg} alt="Diagram: a typical memory stack is four services wired to each other, an LLM API, a vector store, a graph database and a Python service. ai-memory is one binary that writes to one markdown folder." caption="A typical stack against ai-memory. Not every tool needs all four; the table below says which needs what." />
    <div class="table-wrap">
      <table class="table-site parts">
        <caption class="sr-only">Moving parts each memory tool needs</caption>
        <thead>
          <tr>
            <th scope="col">Tool</th>
            {parts.map((p) => <th scope="col" class="part">{p}</th>)}
            <th scope="col">What it needs</th>
          </tr>
        </thead>
        <tbody>
          <tr class="us">
            <th scope="row">ai-memory</th>
            <td class="part"><span class="mark opt" aria-hidden="true"></span><span class="sr-only">Optional</span></td>
            {parts.slice(1).map(() => <td class="part"><span class="mark no" aria-hidden="true"></span><span class="sr-only">Not needed</span></td>)}
            <td>One binary and a folder of markdown</td>
          </tr>
          {competitors.map((c) => (
            <tr>
              <th scope="row"><a href={`#${c.id}`} class="underline">{c.name}</a></th>
              {parts.map((_, i) => (
                <td class="part">
                  {requires[c.id]?.includes(i)
                    ? <><span class="mark need" aria-hidden="true"></span><span class="sr-only">Needs it</span></>
                    : <><span class="mark none" aria-hidden="true"></span><span class="sr-only">Not needed</span></>}
                </td>
              ))}
              <td class="text-muted">{c.needs.join(' · ')}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <ul class="legend mt-5">
      <li><span class="mark need" aria-hidden="true"></span>Needs it</li>
      <li><span class="mark opt" aria-hidden="true"></span>Optional</li>
      <li><span class="mark no" aria-hidden="true"></span>Not needed by ai-memory</li>
      <li><span class="mark none" aria-hidden="true"></span>Not needed</li>
    </ul>
    <p class="mt-5 text-muted max-w-[40em]">Three rows have no marks. Claude Code’s memory is built in, and basic-memory and mcp-memory-service are also light to run. Their differences are in the next section.</p>
  </Section>

  <Section id="tools" title="Tool by tool" lede="Open the one you use. Every block says what stays the same, what you gain, and where that tool wins." hue="amber" tint>
    <div class="tools">
      {competitors.map((c, i) => (
        <details id={c.id} class="tool" name="tool" open={i === 0}>
          <summary>
            <span class="min-w-0">
              <span class="name">{c.name}</span>
              <span class="kind">{c.kind}</span>
            </span>
            <svg class="chev" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
          </summary>
          <div class="body">
            <div class="grid md:grid-cols-3 gap-x-10 gap-y-8">
              <div>
                <h3 class="text-lg text-muted">What stays the same</h3>
                <p class="mt-2">{c.same}</p>
              </div>
              <div>
                <h3 class="text-lg" style="color:var(--amber-ink)">What you gain</h3>
                <ul class="mt-2 space-y-2">{c.gain.map((g) => <li class="gain">{g}</li>)}</ul>
              </div>
              <div>
                <h3 class="text-lg text-muted">Where it wins</h3>
                <p class="mt-2">{c.theyWin}</p>
              </div>
            </div>
            <p class="verdict"><span class="text-muted">Verdict</span> {c.verdict}</p>
          </div>
        </details>
      ))}
    </div>
    <p class="mt-8 text-muted max-w-[40em]">The “where it wins” lines come from the project’s own audit. Read <a class="underline font-semibold text-text" href={`${site.docs}/comparison.md`}>the full comparison</a> and <a class="underline font-semibold text-text" href={`${site.docs}/competitive-parity.md`}>the self-critical parity audit</a> on GitHub.</p>
  </Section>

  <Section id="benchmark" title="The benchmark, with its caveats" lede="One published number, measured on LongMemEval-S with a harness that ships in the repository. Systems that rerank score higher." hue="amber">
    <div class="chart" role="img" aria-label={`Bar chart of LongMemEval-S hit at 5. ${[...ours, ...theirs].map((b) => `${b.label}: ${b.value.toFixed(3)}`).join('. ')}.`}>
      {[...ours.map((b) => ({ ...b, mine: true })), ...theirs.map((b) => ({ ...b, mine: false }))].map((b) => (
        <div class:list={['row', { mine: b.mine }]}>
          <div class="lab"><span class="font-semibold">{b.label}</span><span class="text-muted text-sm">{b.note}</span></div>
          <div class="track"><div class="bar" style={`width:${b.value * 100}%`}></div></div>
          <div class="val tabular-nums">{b.value.toFixed(3)}</div>
        </div>
      ))}
      <p class="axis text-sm text-muted">hit@5, from 0 to 1. Solid bars were measured by this project. Hatched bars are the vendors’ own numbers and were not reproduced here.</p>
    </div>
    <ul class="caveats mt-10 grid md:grid-cols-2 gap-x-10 gap-y-5">
      <li>hit@5 asks whether a session holding the evidence is in the top five results. It measures retrieval. It says nothing about answer accuracy.</li>
      <li>470 of the 500 questions are scored. The 30 abstention questions are excluded. Run on 2026-09-01; not yet re-published for later releases.</li>
      <li>0.823 uses the default in-process embedding model, with no API key and no LLM. 0.668 is full text, entities and links only.</li>
      <li>No head-to-head run against any competitor exists. Accuracy figures such as Hindsight’s 91.4% are a different metric and do not compare with hit@5.</li>
      <li>Stored excerpts are capped at 2 KB for privacy, so evidence deep inside one long turn cannot be found. The benchmark measures the shipped system.</li>
      <li>LongMemEval is chat-assistant history. A coding-session benchmark is planned and does not exist yet.</li>
    </ul>
    <div class="mt-10 max-w-[44rem]">
      <p class="text-muted mb-4">Reproduce it from a checkout. The <a class="underline font-semibold text-text" href={`${site.repo}/tree/main/docs/benchmarks`}>benchmark notes</a> have the dataset hash and the per-slice results.</p>
      <CodeBlock title="from a checkout of the ai-memory repo" code={`# the server under test\ncargo build --release -p ai-memory-cli\n# the full run; --fetch downloads the dataset and checks its hash\ncargo run --release -p ai-memory-eval -- retrieval --fetch\n# a ten question smoke test\ncargo run -p ai-memory-eval -- retrieval --sample 10`} />
    </div>
  </Section>

  <Section id="behind" title="Where ai-memory is behind" lede="This list comes from the repository’s own audit. If one of these is what you need, stay where you are." hue="rose" tint>
    <FeatureGrid items={behind.map((b) => ({ ...b, hue: 'rose' as Hue }))} cols={3} />
  </Section>

  <Section id="move" title="How to move" lede="You do not have to switch in one go. Both tools can run on the same project while you compare them." hue="amber">
    <Figure src={sideBySideImg} alt="Diagram: git history and the README and docs feed through bootstrap into the ai-memory folder. Your agent connects to ai-memory and to your current memory tool at the same time, and the two are independent." />
    <Steps steps={moveSteps} />
    <p class="mt-10 text-muted max-w-[40em]">The importer’s formats and safety rules are in <a class="underline font-semibold text-text" href={`${site.docs}/companion-crates.md`}>the companion crates guide</a>. Other ways to bring documents in are in <a class="underline font-semibold text-text" href={`${site.docs}/cookbook.md`}>the cookbook</a>.</p>
  </Section>

  <Section id="faq" title="Questions people ask before switching" hue="amber" narrow tint>
    <dl class="faq">
      {faq.map((f) => (
        <div>
          <dt class="text-xl">{f.q}</dt>
          <dd class="mt-2 text-muted">{f.a}</dd>
        </div>
      ))}
    </dl>
  </Section>

  <NextPages links={[
    { href: '/install/', title: 'Quick setup', text: 'Three commands for one machine, ten minutes for a team.', hue: 'amber' },
    { href: '/research/', title: 'Research and rationale', text: 'Why pages beat fact rows, and the full benchmark.', hue: 'violet' },
    { href: '/integrations/', title: 'Check your agent', text: 'Every supported agent, OS and provider.', hue: 'violet' },
  ]} />
  <CtaBand title="Try it next to the tool you have." text="It installs beside your current setup. No account and no API key." />
</Base>

<script>
  // Deep links from the homepage (/compare/#mem0) open the matching block.
  const openFromHash = () => {
    const el = location.hash && document.getElementById(location.hash.slice(1));
    if (el instanceof HTMLDetailsElement) { el.open = true; el.scrollIntoView({ block: 'start' }); }
  };
  openFromHash();
  addEventListener('hashchange', openFromHash);
  document.querySelectorAll<HTMLAnchorElement>('.parts a[href^="#"]').forEach((a) => a.addEventListener('click', () => setTimeout(openFromHash)));
</script>

<style>
  .table-wrap { position: relative; }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }

  .parts th.part, .parts td.part { text-align: center; }
  .parts th.part { min-width: 6.5rem; white-space: normal; }
  .parts td { vertical-align: middle; }
  .parts td:last-child { min-width: 15rem; }
  .parts tbody th { background: transparent; text-align: left; font-weight: 600; white-space: nowrap; padding: .9rem 1.1rem; border-bottom: 1px solid var(--line); }
  .parts tr:last-child th { border-bottom: 0; }
  .parts tr.us :is(th, td) { background: var(--hue-soft); }
  .parts tr.us th { color: var(--hue); }
  .mark { display: inline-block; width: 1.05rem; height: 1.05rem; border-radius: 50%; vertical-align: middle; }
  .mark.need { background: var(--text); }
  .mark.opt { border: 2.5px solid var(--hue-vivid); background: transparent; }
  .mark.none { width: .8rem; height: 2px; border-radius: 2px; background: var(--line); }
  .mark.no { background: none; border-radius: 0; width: .95rem; height: .5rem; border-left: 2.5px solid var(--green); border-bottom: 2.5px solid var(--green); rotate: -45deg; translate: 0 -2px; }
  @media (max-width: 40rem) { .parts tbody th { white-space: normal; min-width: 8.5rem; } .parts th.part { min-width: 5rem; font-size: .8rem; } }
  .legend { display: flex; flex-wrap: wrap; gap: .6rem 1.75rem; color: var(--muted); font-size: .92rem; }
  .legend li { display: inline-flex; align-items: center; gap: .6rem; }

  .tools { display: grid; gap: .75rem; }
  .tool { border: 1px solid var(--line); border-radius: 1.25rem; background: var(--surface); scroll-margin-top: 6rem; }
  .tool[open] { border-color: var(--hue-vivid); }
  .tool summary { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: 1.15rem 1.4rem; cursor: pointer; list-style: none; border-radius: 1.25rem; }
  .tool summary::-webkit-details-marker { display: none; }
  .tool .name { display: block; font-family: var(--font-display); font-weight: 640; font-size: var(--text-xl); }
  .tool .kind { display: block; color: var(--muted); font-size: .95rem; margin-top: .15rem; }
  .tool .chev { flex: none; color: var(--muted); transition: rotate .3s var(--ease-out-quint); }
  .tool[open] .chev { rotate: 180deg; }
  .tool .body { padding: .5rem 1.4rem 1.6rem; }
  .verdict { margin-top: 1.75rem; padding-top: 1.1rem; border-top: 1px solid var(--line); font-weight: 600; }
  .verdict span { font-weight: 500; margin-right: .6rem; }
  .gain { position: relative; padding-left: 1.5rem; }
  .gain::before { content: ''; position: absolute; left: 0; top: .6em; width: .8rem; height: 3px; border-radius: 3px; background: var(--amber); }

  .chart { display: grid; gap: .9rem; max-width: 56rem; }
  .row { display: grid; grid-template-columns: minmax(0, 15rem) minmax(0, 1fr) 3.5rem; align-items: center; gap: 1rem; }
  .lab { display: flex; flex-direction: column; line-height: 1.3; }
  .track { height: 1.75rem; border-radius: .5rem; background: var(--tint); overflow: hidden; }
  .bar { height: 100%; border-radius: .5rem; background: repeating-linear-gradient(135deg, var(--muted) 0 3px, transparent 3px 8px); opacity: .7; }
  .row.mine .bar { background: var(--hue-vivid); opacity: 1; }
  .row.mine:nth-child(1) .bar { opacity: .45; }
  .row.mine:nth-child(2) .bar { opacity: .7; }
  .val { font-weight: 700; text-align: right; }
  .axis { margin-top: .5rem; max-width: 44em; }
  @media (max-width: 40rem) {
    .row { grid-template-columns: minmax(0, 1fr) 3.5rem; gap: .35rem 1rem; }
    .lab { grid-column: 1 / -1; }
  }
  .caveats li { position: relative; padding-left: 1.4rem; color: var(--muted); }
  .caveats li::before { content: ''; position: absolute; left: 0; top: .62em; width: .5rem; height: .5rem; border-radius: 50%; background: var(--hue-vivid); }

  .faq { display: grid; gap: 2.25rem; }
  .faq dt { font-family: var(--font-display); font-weight: 640; }
</style>

---
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/PageHero.astro';
import Section from '@/components/Section.astro';
import Steps from '@/components/Steps.astro';
import Tabs from '@/components/Tabs.astro';
import CodeBlock from '@/components/CodeBlock.astro';
import Callout from '@/components/Callout.astro';
import Figure from '@/components/Figure.astro';
import NextPages from '@/components/NextPages.astro';
import CtaBand from '@/components/CtaBand.astro';
import soloPath from '@/assets/img/gen/install-solo-path.webp';
import teamTopology from '@/assets/img/gen/install-team-topology.webp';
import { site } from '@/data/site';

const readme = `${site.repo}#docker`;
const doc = (file: string) => `${site.docs}/${file}`;

// Every command below is copied from README.md, docs/install.md, docs/macos.md, docs/windows.md or docs/users.md.
const wire = `ai-memory install-mcp   --client claude-code --apply
ai-memory install-hooks --agent  claude-code --apply`;

const mise = [
  {
    title: 'Install the binary',
    text: 'mise downloads the release archive for your OS and chip and checks it against the published <code>.sha256</code> file. No Rust toolchain, no Docker.',
    code: 'mise use -g github:akitaonrails/ai-memory',
  },
  {
    title: 'Create the data directory and start the server',
    text: '<code>init</code> only creates the data directory. <code>serve</code> has to stay running, so give it its own terminal. It listens on this machine only and needs no token.',
    code: `ai-memory init
ai-memory serve --transport http --bind 127.0.0.1:49374`,
  },
  {
    title: 'Launch your agent through it',
    text: 'The first launch of a harness installs its hooks and MCP entry if they are missing. Launching <code>claude</code> directly keeps working afterwards.',
    code: 'ai-memory run claude',
  },
];

const aur = [
  {
    title: 'Install the package',
    text: 'The <code>-bin</code> package is a prebuilt x86_64 or aarch64 binary. Both packages ship a user unit and a system unit for systemd.',
    code: `yay -S ai-memory-bin    # prebuilt Linux x86_64/aarch64 binary
yay -S ai-memory        # builds from source`,
  },
  {
    title: 'Create the data directory',
    code: `mkdir -p ~/.config/ai-memory ~/.local/share/ai-memory
ai-memory --data-dir ~/.local/share/ai-memory \\
  --config ~/.config/ai-memory/config.toml init`,
  },
  {
    title: 'Start the user service',
    text: 'No sudo, and all state stays in your home directory. The <a href="/advanced/#services">services section</a> covers the system unit and running after logout.',
    code: 'systemctl --user enable --now ai-memory.service',
  },
  { title: 'Launch your agent through it', code: 'ai-memory run claude' },
];

const macos = [
  {
    title: 'Download and extract',
    text: 'This archive is for Apple Silicon. On an Intel Mac, replace <code>aarch64</code> with <code>x86_64</code>. A browser download needs <code>xattr -d com.apple.quarantine ./ai-memory</code> once; a curl download does not.',
    code: `mkdir -p ~/Applications/ai-memory && cd ~/Applications/ai-memory
curl -fsSL -O https://github.com/akitaonrails/ai-memory/releases/latest/download/ai-memory-macos-aarch64.tar.gz
tar -xzf ai-memory-macos-aarch64.tar.gz`,
  },
  {
    title: 'Create the data directory and start the server',
    text: 'Leave <code>serve</code> running in this terminal. The <a href="/advanced/#services">launchd agent</a> starts it at login instead.',
    code: `./ai-memory init
./ai-memory serve --transport http --bind 127.0.0.1:49374`,
  },
  {
    title: 'Wire your agent from a second terminal',
    text: 'Keep the extracted binary where it is: the hook commands point at that path.',
    code: `cd ~/Applications/ai-memory
./ai-memory install-hooks --agent claude-code --apply
./ai-memory install-mcp --client claude-code --apply`,
  },
];

const docker = [
  {
    title: 'Install the wrapper script',
    text: `The wrapper is a small shell script that lands in <code>~/.local/bin/ai-memory</code>. <a href="${readme}">The README has the install script</a>, which checks the download against its SHA-256 file before installing it. Copy it from there.`,
  },
  {
    title: 'Start the server',
    text: 'The image covers <code>linux/amd64</code> and <code>linux/arm64</code>. On a Podman host, replace <code>docker</code> with <code>podman</code>. The wrapper uses rootless Podman on its own when Docker is not installed.',
    code: `docker run -d --name ai-memory \\
    --restart unless-stopped \\
    -p 127.0.0.1:49374:49374 \\
    -v ai-memory-data:/data \\
    docker.io/akitaonrails/ai-memory:latest`,
  },
  {
    title: 'Wire your agent',
    text: 'After this, start Claude Code as usual. One limit of this path: the wrapper’s shell hooks do not enforce per-repository <code>ignore_paths</code> capture rules. The native binary does.',
    code: wire,
  },
];

const windows = [
  {
    title: 'Decide where your agent runs',
    text: `An agent launched inside WSL2 needs ai-memory inside WSL2. That path is supported and is the Docker path above: <a href="${readme}">install the wrapper from the README</a> in your WSL2 shell. With Docker Desktop, enable WSL integration for the distro first.`,
  },
  {
    title: 'Start the server inside WSL2',
    code: `docker run -d --name ai-memory \\
    --restart unless-stopped \\
    -p 127.0.0.1:49374:49374 \\
    -v ai-memory-data:/data \\
    akitaonrails/ai-memory:latest`,
  },
  {
    title: 'Wire your agent, also inside WSL2',
    text: `Native Windows is experimental. It has a release zip with <code>ai-memory.exe</code>, a PowerShell Docker wrapper and a WinSW service recipe. <a href="${doc('windows.md')}">The Windows guide has all three</a>.`,
    code: `ai-memory install-mcp --client claude-code --apply
ai-memory install-hooks --agent claude-code --apply`,
  },
];

const team = [
  {
    title: 'Start the shared server with a token',
    text: 'Pick a homelab box or any LAN host. A server bound beyond loopback needs both a bearer token and a host allowlist. The allowlist holds every name or IP your machines use to reach it.',
    code: `TOKEN=$(ai-memory generate-auth-token)
docker run -d --name ai-memory \\
    --restart unless-stopped \\
    -p 0.0.0.0:49374:49374 \\
    -v ai-memory-data:/data \\
    -e AI_MEMORY_AUTH_TOKEN="$TOKEN" \\
    -e AI_MEMORY_ALLOWED_HOSTS="<server-ip>,localhost,127.0.0.1" \\
    akitaonrails/ai-memory:latest`,
    codeTitle: 'on the server',
  },
  {
    title: 'Create the people',
    text: `Run this with the root token exported. The temporary password prints once, and the person changes it at first login. It does not issue an API key. <a href="${doc('users.md')}">The users guide</a> covers the root identity in <code>[auth]</code>.`,
    code: 'ai-memory user add-human --username alice --email alice@home --name "Alice Smith"',
  },
  {
    title: 'Give each person an API key',
    text: 'The <code>aim_</code> secret is shown once. <code>ai-memory api-key rotate &lt;id&gt;</code> and <code>ai-memory api-key revoke &lt;id&gt;</code> take effect immediately.',
    code: 'ai-memory api-key add --username alice --label codex-laptop',
  },
  {
    title: 'Point each machine at the server',
    text: 'Each person uses their own key as the token. It is stored in a <code>0600</code> file in the data directory and stays off the hook command line. <code>--as-user</code> only labels the install.',
    code: `# TOKEN here is this person's aim_ key, not the root token
export AI_MEMORY_SERVER_URL="http://<server-ip>:49374"
export AI_MEMORY_AUTH_TOKEN="$TOKEN"

ai-memory install-mcp   --client claude-code --apply
ai-memory install-hooks --apply --agent claude-code \\
    --as-user alice --auth-token aim_XGq...<secret>`,
    codeTitle: 'on every laptop',
  },
  {
    title: 'Add TLS before leaving the LAN',
    text: 'A bearer token authenticates; it does not encrypt. Keys and web cookies travel in the clear over plain HTTP, so <a href="/advanced/#tls">put Caddy, nginx or a Cloudflare Tunnel in front</a> once accounts exist or the server is reachable beyond your desk.',
  },
];

const howTo = {
  '@type': 'HowTo',
  name: 'Install ai-memory on one machine',
  description: 'Install the ai-memory binary with mise, start the local server on loopback, and launch a coding agent through it so hooks and MCP are wired.',
  tool: [{ '@type': 'HowToTool', name: 'mise' }],
  step: mise.map((s, i) => ({
    '@type': 'HowToStep',
    position: i + 1,
    name: s.title,
    text: s.code.replace(/\n/g, ' && '),
    url: `https://${site.domain}/install/#solo`,
  })),
};
---
<Base
  title="Quick setup for one developer or a team"
  description="Install ai-memory with mise, the AUR, a macOS binary or Docker, check that capture works, then share one server with your team. Copy and paste commands."
  schema={[howTo]}
>
  <PageHero
    hue="amber"
    kicker="Developers"
    title="Quick setup"
    lede="Pick your track and copy the commands. One machine takes three steps and no account. A shared server for a team takes five."
  >
    <a href="#solo" class="btn btn-primary">Just me</a>
    <a href="#team" class="btn btn-ghost">My team</a>
  </PageHero>

  <Section id="solo" hue="amber" title="Just me" lede="One binary, one local server, then your agent. The server binds to 127.0.0.1:49374, so nothing outside this machine can reach it and it needs no token.">
    <div class="tabs-wrap"><Tabs id="platform" labels={['Linux or macOS (mise)', 'Arch Linux (AUR)', 'macOS binary', 'Docker or Podman', 'Windows']}>
      <div slot="0"><Steps steps={mise} /></div>
      <div slot="1"><Steps steps={aur} /></div>
      <div slot="2"><Steps steps={macos} /></div>
      <div slot="3"><Steps steps={docker} /></div>
      <div slot="4"><Steps steps={windows} /></div>
    </Tabs></div>
    <Figure
      src={soloPath}
      alt="The solo install in three stages on one laptop: install the binary, start the server on 127.0.0.1:49374, then run your agent, which connects to the server through hooks and MCP. Nothing leaves the laptop."
      caption="The whole solo path. The server stays on loopback, and your agent reaches it two ways: hooks capture the session, MCP lets the agent search it."
    />
    <p class="text-muted max-w-[40em]">
      <code>ai-memory run</code> is the recommended launcher and it is optional. It wires a harness on first launch and adds native session resume across harnesses.
      Hooks alone already carry the handoff, so launching your agent directly keeps working.
      <a class="link" href={doc('managed-workstreams.md')}>Read how managed launches work</a>.
    </p>
  </Section>

  <Section id="check" hue="green" tint title="Check that it works" lede="Three checks, from the network up to the agent.">
    <div class="grid gap-8 lg:grid-cols-3">
      <div class="min-w-0">
        <h3 class="text-xl">The server answers</h3>
        <p class="mt-2 text-muted">A JSON-RPC error is the right answer. It means the port is reachable and the server is responding.</p>
        <div class="mt-4"><CodeBlock code="curl http://127.0.0.1:49374/mcp" /></div>
      </div>
      <div class="min-w-0">
        <h3 class="text-xl">The CLI reaches it</h3>
        <p class="mt-2 text-muted">The CLI is a thin HTTP client. If this prints a status, hooks can reach the server too.</p>
        <div class="mt-4"><CodeBlock code="ai-memory status" /></div>
      </div>
      <div class="min-w-0">
        <h3 class="text-xl">The agent remembers</h3>
        <p class="mt-2 text-muted">Work for a few minutes, quit, and open a second session in the same directory. Then ask it:</p>
        <p class="mt-4 ask">“Where did we leave off?”</p>
      </div>
    </div>
  </Section>

  <Section id="next" hue="violet" title="After the first agent" lede="All three are optional. Do them when you need them.">
    <div class="grid gap-x-8 gap-y-12 lg:grid-cols-3">
      <div class="min-w-0">
        <h3 class="text-xl">Add another agent</h3>
        <p class="mt-2 text-muted">The same two commands with a different name. Both agents then share one project memory.</p>
        <div class="mt-4"><CodeBlock code={`ai-memory install-mcp   --client codex --apply
ai-memory install-hooks --agent  codex --apply`} /></div>
        <p class="mt-4"><a class="link" href="/integrations/#agents">See every supported agent and its name</a></p>
      </div>
      <div class="min-w-0">
        <h3 class="text-xl">Optional: better summaries with an LLM</h3>
        <p class="mt-2 text-muted">Without a provider, capture, search and rule-based summaries all work at no cost. A provider rewrites session pages as readable narratives. Set these two variables in the server’s environment (<code>-e</code> flags for Docker, <code>~/.config/ai-memory/env</code> for the systemd user service) and restart it.</p>
        <div class="mt-4"><CodeBlock title="server environment" code={`AI_MEMORY_LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...`} /></div>
        <p class="mt-4"><a class="link" href="/integrations/#providers">Compare providers, including subscriptions and local models</a></p>
      </div>
      <div class="min-w-0">
        <h3 class="text-xl">Undo everything</h3>
        <p class="mt-2 text-muted">This removes what ai-memory installed and only that. Install commands are idempotent, and each one writes a timestamped backup next to any file it touches.</p>
        <div class="mt-4"><CodeBlock code="ai-memory uninstall --apply" /></div>
      </div>
    </div>
  </Section>

  <Section id="team" hue="teal" tint title="My team" lede="One server that every machine and every teammate reaches. There is no replication between servers: shared memory means everyone connects to the same one.">
    <Figure
      src={teamTopology}
      alt="Team topology: three laptops for alice, bob and carol each connect to one shared server protected by a token. Each person has one API key, and the server holds one wiki for the team."
      caption="The server holds the wiki. People get accounts, machines get API keys, and the root token stays with whoever runs the server."
    />
    <div class="steps-wrap"><Steps steps={team} /></div>
    <div class="mt-12 grid gap-6 lg:grid-cols-2">
      <Callout title="One server per data directory, never two" hue="amber">
        <p>Two <code>ai-memory serve</code> processes on the same data directory (a synced folder, an NFS mount, two containers on one volume) each run their own writer and their own git handle on the wiki. SQLite survives that. The wiki does not. Since 2.0 a second server refuses to start while <code>.serve.lock</code> is held.</p>
      </Callout>
      <Callout title="What team mode does not do" hue="rose">
        <p>Accounts are not a tenancy boundary. Every authenticated user sees every page in every project on that server, and there are no per-project permissions yet. Run one server per team, and a separate server with its own data directory for a second team.</p>
      </Callout>
    </div>
  </Section>

  <NextPages links={[
    { href: '/advanced/', title: 'Advanced setup', text: 'TLS, services, backups, routing, SSO and capacity numbers.', hue: 'azure' },
    { href: '/integrations/', title: 'Integrations', text: 'Every agent, operating system and provider, with its status.', hue: 'violet' },
    { href: '/security/', title: 'Security', text: 'What is stored, what leaves the machine, and how to lock it down.', hue: 'rose' },
  ]} />
  <CtaBand title="Stuck on a step?" text="The install cookbook on GitHub has the per-agent commands, remote servers and Windows. The issue tracker is open." />
</Base>

<style>
  @media (max-width: 48rem) { .tabs-wrap :global(.tablist) { border-radius: 1.25rem; } }
  .tabs-wrap :global(.steps a), .steps-wrap :global(.steps a) { color: var(--hue); font-weight: 600; text-decoration: underline; text-underline-offset: .2em; }
  .ask { font-family: var(--font-display); font-size: 1.35rem; line-height: 1.3; color: var(--hue); }
  .link { color: var(--hue, var(--text)); font-weight: 600; text-decoration: underline; text-underline-offset: .2em; }
  p :global(code), p code { background: var(--tint); border-radius: .35em; padding: .12em .4em; font-size: .92em; }
</style>

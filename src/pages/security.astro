---
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/PageHero.astro';
import Section from '@/components/Section.astro';
import FeatureGrid from '@/components/FeatureGrid.astro';
import CodeBlock from '@/components/CodeBlock.astro';
import Figure from '@/components/Figure.astro';
import Callout from '@/components/Callout.astro';
import NextPages from '@/components/NextPages.astro';
import CtaBand from '@/components/CtaBand.astro';
import boundary from '@/assets/img/gen/security-boundary.webp';
import egress from '@/assets/img/gen/security-egress.webp';
import { site } from '@/data/site';

const securityMd = `${site.repo}/blob/main/SECURITY.md`;
const dataHandlingMd = `${site.repo}/blob/main/DATA_HANDLING.md`;
const advisory = `${site.repo}/security/advisories/new`;

const posture = [
  { title: 'Loopback only', text: 'The server binds 127.0.0.1:49374. No process outside the machine can reach it, which is why the default needs no password.' },
  { title: 'No telemetry', text: 'The binary has no analytics, crash reporting or usage tracking. Capture and search make zero network calls.' },
  { title: 'One directory you own', text: 'Wiki pages and the SQLite file live under one data directory. New directories are created 0700 and new files 0600 on Unix.' },
  { title: 'No encryption at rest', text: 'Version 1 relies on filesystem permissions. Existing installs are not chmodded for you. Use disk encryption if the laptop needs it.' },
];

const boundaryPoints = [
  { title: 'One way in', text: 'The stored type can only be built by sanitize(). Code that skips the privacy strip does not compile.' },
  { title: 'Secrets are replaced', text: 'Matches become typed markers such as [REDACTED:github_token] or [REDACTED:jwt]. The strip is best effort and the docs say so.' },
  { title: 'Sizes are capped', text: 'Tool excerpts stop at 2 KB and prompts at 16 KiB. A 16 KiB backstop applies to every stored body after redaction.' },
  { title: 'Tool inputs are not kept', text: 'PreToolUse events never retain commands, arguments, paths or input bodies. Observations are an audit trail, never a full transcript.' },
];

const ladder = [
  {
    title: 'Loopback, no auth',
    when: 'One person, one machine',
    text: 'The default. Nothing to configure, because nothing else can connect.',
  },
  {
    title: 'Bearer token for the LAN',
    when: 'A homelab box or a second machine',
    text: 'Create a token with <code>ai-memory generate-auth-token</code> and set <code>AI_MEMORY_AUTH_TOKEN</code>. It is compared in constant time and protects <code>/mcp</code>, <code>/hook</code>, <code>/handoff</code> and the admin and API routes. Set <code>AI_MEMORY_ALLOWED_HOSTS</code> as well; it blocks DNS rebinding and does not replace the token.',
  },
  {
    title: 'Accounts and API keys',
    when: 'More than one person writes',
    text: 'Passwords are stored as Argon2id hashes. Each machine gets an <code>aim_</code> key that is printed once and never shown again. <code>ai-memory api-key rotate &lt;id&gt;</code> makes the old key return 401 at once. The first account turns every <code>/admin/*</code> route root only.',
  },
  {
    title: 'OIDC device auth for hooks',
    when: 'Your team already has Keycloak, Okta or Entra ID',
    text: 'Native hooks and the CLI can carry a token from <code>ai-memory auth login oidc-device</code>. The server does not validate OIDC tokens itself, so this needs an OIDC-aware gateway in front of it. It is hook and CLI auth through a gateway, and the server has no built-in SSO login.',
  },
  {
    title: 'TLS through a reverse proxy',
    when: 'Anything beyond loopback',
    text: 'ai-memory does not terminate TLS, by design. Bearer tokens are not encrypted on the wire, so put Caddy, nginx or a Cloudflare Tunnel in front. The repo ships compose templates for Caddy and cloudflared. Set <code>AI_MEMORY_AUTH__SECURE_COOKIE=true</code> when people sign in from other machines.',
  },
];

const egressRows = [
  {
    path: 'Remote embeddings',
    sent: 'The full text of every stored page. Switching later also backfills the existing corpus. This path is not sanitized the way the others are.',
    on: 'embedding_provider = openai | voyage | google | openai-compat',
  },
  {
    path: 'Assistant output capture',
    sent: 'The assistant’s final-turn text, and only if you have also configured a cloud LLM. Global to the install, Claude Code and Codex only.',
    on: 'capture_assistant on the server and install-hooks --capture-assistant on the client',
  },
  {
    path: 'LLM rerank',
    sent: 'Each live query plus up to 30 bounded page titles and snippets. The query is not redacted, because redaction could change its meaning.',
    on: 'AI_MEMORY_RERANKER=llm',
  },
  {
    path: 'LLM consolidation and lint',
    sent: 'Prompts built from stored observations and pages go to whichever provider you chose. Point it at a local model and nothing leaves.',
    on: 'AI_MEMORY_LLM_PROVIDER',
  },
];

const purgeRows = [
  ['Reachable through the API or MCP tools', 'No', 'No'],
  ['Returned by search', 'No', 'No'],
  ['Live markdown file in the wiki', 'No, best effort', 'No, best effort'],
  ['Bytes still inside memory.sqlite', 'Yes, in free pages', 'No'],
  ['Text still in the wiki git history', 'Yes', 'Yes'],
  ['Present in backups taken earlier', 'Yes', 'Yes'],
];

const purge = `# Remove one session
ai-memory purge-session --workspace default --project my-app --session-id <uuid> --confirm

# Remove a whole project
ai-memory purge-project --project experimental --confirm`;

const allowlist = `# .ai-memory.toml in the repository
[capture]
ignore_paths = ["private/**", "~/personal-notes/**"]

# Or capture only repositories that opt in
ai-memory install-hooks --apply --capture-mode allowlist`;

const faq = [
  { q: 'Does ai-memory send my code or prompts anywhere?', a: 'No. There is no telemetry, and capture and search make no network calls. Data leaves the machine only if you turn on remote embeddings, assistant output capture with a cloud LLM, LLM rerank, or a cloud LLM provider for consolidation. All are off by default.' },
  { q: 'Does a default install make any network request?', a: 'One. Since 2.0 the default local embedder downloads an all-MiniLM-L6-v2 model of about 87 MB from Hugging Face on first start. No user data is sent. Set embedding_provider = "none" or place the model files yourself to avoid it.' },
  { q: 'Are secrets stored?', a: 'Every hook payload passes a sanitizer before storage. Recognized credentials are replaced with typed [REDACTED:kind] markers and bodies are size capped. The project documents the sanitizer as a best-effort credential strip and gives no guarantee.' },
  { q: 'Can I delete a session for good?', a: 'Purge is a logical delete. The content stops being reachable and searchable, but the text stays in the wiki git history and in earlier backups. The --compact flag clears the SQLite free pages and is documented as not being forensic erasure.' },
  { q: 'Is ai-memory multi-tenant?', a: 'No. It is a single-tenant service. Accounts give attribution, and every authenticated user can read every project on that server. Run separate servers for people who must not see each other’s data.' },
];
const schema = [{
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
}];
---
<Base
  title="Security: what is stored and what leaves your machine"
  description="ai-memory listens on loopback by default, strips secrets before storage and sends nothing out unless you opt in. How to harden it, and where it stops."
  schema={schema}
>
  <PageHero
    hue="rose"
    kicker="Product"
    title="What it stores, and what leaves your machine"
    lede="A default install listens on your machine only, strips secrets before anything is written, and has no telemetry. Every path that sends data out is off until you turn it on. This page also lists what the project does not defend against."
  >
    <a href={securityMd} class="btn btn-primary">Read SECURITY.md</a>
    <a href={dataHandlingMd} class="btn btn-ghost">Data handling for reviewers</a>
  </PageHero>

  <Section hue="rose" id="default" title="The default is local." lede="Install it, run it, and the only thing that can talk to it is your own machine.">
    <FeatureGrid cols={4} items={posture.map((p) => ({ ...p, hue: 'rose' as const }))} />
    <div class="mt-14">
      <Callout title="The one outbound request on a default install" hue="amber">
        <p>Since 2.0 the default embedder runs in process. On first start it downloads the all-MiniLM-L6-v2 model, about 87 MB, from Hugging Face and checks it against a pinned SHA-256. No user data is sent.</p>
        <p>To avoid the download, set <code>embedding_provider = "none"</code> or copy the three model files into <code>&lt;data_dir&gt;/models/</code>. The <a href={`${site.docs}/airgapped-install.md`}>air-gapped install guide</a> has the steps.</p>
      </Callout>
    </div>
  </Section>

  <Section hue="rose" id="boundary" tint title="Nothing is stored before it is sanitized." lede="Hook payloads are untrusted text. They reach the store through one function, and the type system enforces it.">
    <Figure src={boundary} alt="Diagram: a raw hook payload containing keys and passwords enters a single gate labelled sanitize(). Secrets drop out below the gate. A smaller, size-capped observation comes out the other side and is stored." caption="The sanitizer is the only path from a hook payload into the store." />
    <FeatureGrid cols={4} items={boundaryPoints.map((p) => ({ ...p, hue: 'rose' as const }))} />

    <div class="mt-16 grid lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] gap-10">
      <div>
        <h3 class="text-xl">Keep a path or a repository out</h3>
        <ul class="mt-4 space-y-3 text-muted max-w-[34em] dotlist">
          <li>A <code>[capture]</code> block in <code>.ai-memory.toml</code> lists paths to ignore. Matching events are dropped on your machine, before the spool, the network and the logs.</li>
          <li>Allowlist mode inverts it: a repository without the file emits no events at all.</li>
          <li>An invalid rule set falls back to metadata only. It never applies half a policy.</li>
          <li>Matching is lexical. Symlinks are not resolved, and prompts and shell commands cannot be tied to a path. The docs call it a capture boundary, not complete DLP.</li>
          <li>Assistant output is never stored by default. It takes a server flag and a client flag together.</li>
        </ul>
      </div>
      <div class="min-w-0">
        <CodeBlock title="per-repository capture rules" code={allowlist} />
      </div>
    </div>
    <div class="mt-10">
      <Callout title="The Docker wrapper does not enforce ignore_paths" hue="amber">
        <p>Capture rules are enforced by the native <code>ai-memory hook</code> commands and the generated OpenCode, OMP, Pi and OpenClaw integrations. The Docker wrapper installs posix shell hooks, and those shell and PowerShell scripts skip the rules. If you depend on <code>ignore_paths</code> or allowlist mode, install the native binary on the client. The <a href={`${site.docs}/marker-file.md`}>marker file reference</a> has the details.</p>
      </Callout>
    </div>
  </Section>

  <Section hue="rose" id="hardening" title="Add one rung at a time." lede="Each step exists for a specific situation. Stop at the one that matches yours.">
    <ol class="ladder">
      {ladder.map((r, i) => (
        <li style={`--i:${i}`}>
          <span class="n" aria-hidden="true">{i + 1}</span>
          <div class="min-w-0">
            <p class="badge" data-hue="rose">{r.when}</p>
            <h3 class="text-xl mt-3">{r.title}</h3>
            <p class="mt-2 text-muted prose-site" set:html={r.text} />
          </div>
        </li>
      ))}
    </ol>
    <div class="mt-12">
      <Callout title="Exposed without a token, it refuses to start" hue="rose">
        <p>A non-loopback bind with no auth fails closed. <code>--allow-insecure-no-auth</code> is the documented dangerous override. Inside a container the check can only warn, because the process cannot see your <code>-p</code> publish spec: <code>-p 127.0.0.1:49374:49374</code> is safe without a token, and anything wider needs one.</p>
        <p>Request bodies are capped at 10 MB, and shared servers can rate limit hooks per source. Full walkthroughs: <a href={`${site.docs}/security.md`}>the security model</a>, <a href={`${site.docs}/users.md`}>accounts and API keys</a>, <a href={`${site.docs}/sso.md`}>OIDC</a> and <a href={`${site.docs}/https-via-proxy.md`}>HTTPS through a proxy</a>.</p>
      </Callout>
    </div>
  </Section>

  <Section hue="rose" id="egress" tint title="What leaves the machine, and when." lede="DATA_HANDLING.md lists three opt-in paths. A cloud LLM provider for consolidation is a fourth way out, so it is in the table too. All four are off by default.">
    <Figure src={egress} alt="Diagram: hooks, the wiki and index, and the local embedder sit inside an enclosure labelled Your machine, joined by solid lines. Dashed lines to cloud embeddings, a cloud LLM and LLM rerank cross the wall through open switches labelled Opt-in, off by default." caption="Solid lines stay inside. Dashed lines exist only after you change a setting." />
    <div class="table-wrap">
      <table class="table-site">
        <thead><tr><th>Path</th><th>What is sent</th><th>How it is turned on</th><th>Default</th></tr></thead>
        <tbody>
          {egressRows.map((r) => (
            <tr>
              <td class="min-w-[11rem]">{r.path}</td>
              <td class="min-w-[18rem] text-muted">{r.sent}</td>
              <td class="min-w-[15rem]"><code class="cfg">{r.on}</code></td>
              <td><span class="badge" data-hue="green">Off</span></td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="mt-6 text-muted max-w-[40em]">With none of these enabled there is no third party in the data path. Once you configure a cloud provider, that provider is your processor under your own agreement with it. <a class="underline font-semibold text-text" href={dataHandlingMd}>DATA_HANDLING.md covers the GDPR framing</a> and is explicit that it is not legal advice.</p>
  </Section>

  <Section hue="rose" id="audit" title="Who wrote it, and how to remove it.">
    <div class="grid lg:grid-cols-2 gap-x-14 gap-y-14">
      <div>
        <h3 class="text-xl">Attribution and audit</h3>
        <ul class="mt-4 space-y-3 text-muted max-w-[34em] dotlist">
          <li>With accounts on, each write carries its author. Pages record <code>author_id</code> and a <code>last_modified_by</code> block in the frontmatter.</li>
          <li>Every mutation lands in an <code>audit_log</code> table, with the user’s identity on attributed rows.</li>
          <li>The wiki is a git repository, so every page change is also a commit you can diff and restore.</li>
          <li>Admission webhooks receive the actor and can reject an operation.</li>
          <li>There is no audit log screen yet. The rows are in SQLite.</li>
        </ul>
      </div>
      <div class="min-w-0">
        <h3 class="text-xl">Deletion, honestly</h3>
        <p class="mt-4 text-muted max-w-[34em]">Purge is a logical delete, scoped so that project A can never remove files from project B. Data has no expiry unless a page sets one.</p>
        <div class="mt-5"><CodeBlock title="purge" code={purge} /></div>
      </div>
    </div>
    <div class="table-wrap mt-12">
      <table class="table-site">
        <thead><tr><th>After a purge</th><th>Default</th><th>With --compact</th></tr></thead>
        <tbody>
          {purgeRows.map(([what, a, b]) => (
            <tr><td class="min-w-[15rem]">{what}</td><td class="min-w-[9rem] text-muted">{a}</td><td class="min-w-[9rem] text-muted">{b}</td></tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="mt-6 text-muted max-w-[40em]">The docs state it plainly: <code class="cfg">--compact</code> is not forensic erasure. To remove text from history you rewrite the wiki’s git history and rotate your backups yourself. <a class="underline font-semibold text-text" href={`${site.docs}/lifecycle-ops.md`}>Lifecycle operations has the full procedure.</a></p>
  </Section>

  <Section hue="rose" id="limits" tint title="Where it stops.">
    <div class="grid lg:grid-cols-2 gap-8 items-start">
      <Callout title="Limits you should plan around" hue="rose">
        <ul class="limits">
          <li>It is a single-tenant workstation and homelab service.</li>
          <li>Accounts are not a tenancy boundary. Every user sees every project on that server, so run one server per team.</li>
          <li>There are no per-user or per-project access lists.</li>
          <li>Memory that an agent retrieves is untrusted historical data. Handoffs, briefs and LLM prompts mark it as such, and no text filter can prove a model will ignore a hostile passage.</li>
          <li>It is not built for direct exposure to the open internet.</li>
          <li>If you push the wiki to a git remote, securing that remote is on you.</li>
        </ul>
      </Callout>
      <div>
        <h3 class="text-xl">Reporting a vulnerability</h3>
        <ul class="mt-4 space-y-3 text-muted max-w-[34em] dotlist">
          <li>Do not open a public issue. <a class="underline font-semibold text-text" href={advisory}>Open a private security advisory on GitHub.</a></li>
          <li>You get a response within 7 days. The target for a patch is 30 days, with credit in the changelog unless you decline.</li>
          <li>Only the latest release receives security fixes.</li>
          <li>Release assets ship with SHA-256 files, and CI actions are pinned to reviewed commits.</li>
        </ul>
        <p class="mt-6"><a href={securityMd} class="btn btn-ghost">Threat model and policy in SECURITY.md</a></p>
      </div>
    </div>
  </Section>

  <NextPages links={[
    { href: '/architecture/', title: 'Architecture', text: 'The pipeline from hook to briefing, and why markdown is the source of truth.', hue: 'azure' },
    { href: '/advanced/', title: 'Advanced setup', text: 'Homelab, TLS, OIDC, air-gapped installs and backups, step by step.', hue: 'azure' },
    { href: '/solutions/teams/', title: 'For teams', text: 'One shared server, per-person keys, and what sharing means here.', hue: 'teal' },
  ]} />
  <CtaBand title="Try it on loopback first." text="No account and no API key. Nothing can reach it but your own machine." />
</Base>

<style>
  .dotlist li { position: relative; padding-left: 1.4rem; }
  .dotlist li::before { content: ''; position: absolute; left: 0; top: .62em; width: .5rem; height: .5rem; border-radius: 50%; background: var(--hue-vivid); }
  .dotlist code, .cfg { background: var(--tint); border-radius: .35em; padding: .12em .4em; font-size: .9em; }
  .cfg { overflow-wrap: anywhere; }
  .limits { list-style: disc; padding-left: 1.2rem; display: grid; gap: .6rem; }

  .ladder { display: grid; gap: 1rem; }
  .ladder li { display: grid; grid-template-columns: 2.75rem minmax(0, 1fr); gap: 1.1rem; padding: 1.4rem 1.5rem; border-radius: 1.25rem; background: var(--surface); border: 1px solid var(--line); border-left: 4px solid color-mix(in oklch, var(--hue-vivid) calc(30% + var(--i) * 17%), var(--line)); }
  .ladder .n { display: grid; place-items: center; width: 2.75rem; height: 2.75rem; border-radius: 50%; background: var(--hue-soft); color: var(--hue); font-family: var(--font-display); font-weight: 700; font-size: 1.15rem; }
  .ladder .badge { white-space: normal; }
  @media (min-width: 64rem) {
    .ladder li { margin-left: calc(var(--i) * 7%); max-width: 46rem; }
  }
  @media (max-width: 30rem) {
    .ladder li { grid-template-columns: minmax(0, 1fr); padding: 1.2rem; }
  }
</style>

---
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/PageHero.astro';
import Section from '@/components/Section.astro';
import CodeBlock from '@/components/CodeBlock.astro';
import Figure from '@/components/Figure.astro';
import Callout from '@/components/Callout.astro';
import NextPages from '@/components/NextPages.astro';
import CtaBand from '@/components/CtaBand.astro';
import hubImg from '@/assets/img/gen/integrations-hub.webp';
import hooksMcpImg from '@/assets/img/gen/integrations-hooks-vs-mcp.webp';
import { site } from '@/data/site';
import { platforms, harnesses, statusMeaning, llmProviders, embeddingProviders, type Status } from '@/data/support';

// Installer ids come from docs/install.md and docs/mcp-install.md. Add an entry here only if a support.ts id ever differs from the CLI value.
const cliId: Record<string, string> = {};
// Launcher names documented for `ai-memory run` in docs/managed-workstreams.md and docs/support-matrix.md.
const launcher: Record<string, string> = {
  'claude-code': 'claude', codex: 'codex', opencode: 'opencode', opencode2: 'opencode2', grok: 'grok',
  'kimi-code': 'kimi', 'kiro-cli': 'kiro', 'command-code': 'command-code', 'antigravity-cli': 'antigravity', crush: 'crush',
};

const commandsFor = (h: (typeof harnesses)[number]) => {
  const id = cliId[h.id!] ?? h.id!;
  const lines: string[] = [];
  if (h.status === 'Supported' || h.status === 'MCP-only') lines.push('# the memory tools, over MCP', `ai-memory install-mcp --client ${id} --apply`);
  if (h.status === 'Supported') lines.push('# automatic capture, through lifecycle hooks', `ai-memory install-hooks --agent ${id} --apply`);
  if (h.status === 'Hooks-only') lines.push('# stages the hook scripts and prints a snippet to paste into the agent’s settings', `ai-memory install-hooks --agent ${id} --apply`);
  if (h.run && launcher[h.id!]) lines.push(h.status === 'Managed-only' ? '# launch it through ai-memory' : '# or launch it managed; both wire themselves', `ai-memory run ${launcher[h.id!]}`);
  return lines.join('\n');
};

const statuses = [...new Set(harnesses.map((h) => h.status))] as Status[];
const count = (s: Status) => harnesses.filter((h) => h.status === s).length;

const platformHow: Record<string, string> = {
  Linux: 'Release tarball, Docker or Podman image, or an AUR package',
  macOS: 'Release tarball with a launchd agent, or Docker',
  'Windows via WSL2': 'The Linux binary, inside WSL2',
  'Native Windows': 'Release zip, Docker Desktop wrapper, or a source build',
};

const faq = [
  { q: 'Which coding agents does ai-memory work with?', a: `${harnesses.length} agents and editors are listed, including ${harnesses.slice(0, 5).map((h) => h.name).join(', ')}. ${count('Supported')} of them have both automatic capture through lifecycle hooks and the memory tools over MCP.` },
  { q: 'What is the difference between hooks and MCP?', a: 'Hooks capture sessions automatically: prompts, tool calls and session boundaries are recorded without the agent doing anything. MCP gives the agent tools it can call to search and write memory. A fully supported agent has both.' },
  { q: 'My agent is not listed. Can I still use it?', a: 'Yes, if it speaks MCP. Point it at http://127.0.0.1:49374/mcp and it can search and write memory. Without lifecycle hooks, nothing is captured automatically.' },
  { q: 'Do I need an LLM or an embedding provider?', a: 'No. Both are optional. Since 2.0 the default embeddings run in-process with a model of about 87 MB that downloads on first start, and no API key is involved.' },
  { q: 'Does ai-memory run on Windows?', a: 'Yes. WSL2 is supported through the Linux path. Native Windows is experimental and ships as a release zip with ai-memory.exe.' },
];
const faqSchema = {
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---
<Base
  title="Supported agents, operating systems and providers"
  description="Every coding agent, editor, operating system and LLM or embedding provider that ai-memory supports, with the install command for each and honest status labels."
  schema={[faqSchema]}
>
  <PageHero
    hue="violet"
    kicker="Integrations"
    title="Your agents, your OS, your providers"
    lede={`${harnesses.length} coding agents and editors, four operating system targets, and a list of LLM and embedding providers that you can ignore, because everything works without one.`}
  >
    <a href="#agents" class="btn btn-primary">Find your agent</a>
    <a href="/install/" class="btn btn-ghost">Go to quick setup</a>
  </PageHero>

  <Section title="Many agents, one memory" lede="Each agent connects to the same server. What Claude Code learned this morning is there when you open Codex this afternoon." hue="violet" fill>
    <Figure src={hubImg} alt="Hub and spoke diagram: Claude Code, Codex, Cursor, Gemini CLI, OpenCode and Zed all connect to one memory in the centre." />
  </Section>

  <Section id="agents" title="Agents and editors" lede="Filter by status, then pick a row to get its install commands." hue="violet" tint>
    <div data-agents>
      <div class="filters" role="group" aria-label="Filter agents by status">
        <button type="button" class="pick" aria-pressed="true" data-filter="all">All <span class="n">{harnesses.length}</span></button>
        {statuses.map((s) => (
          <button type="button" class="pick" aria-pressed="false" data-filter={s} data-hue={statusMeaning[s].hue}>{s} <span class="n">{count(s)}</span></button>
        ))}
      </div>

      <div class="agents-grid mt-8">
        <div class="cmd" aria-live="polite">
          {harnesses.map((h, i) => (
            <div data-panel={h.id} hidden={i !== 0}>
              <p class="cmd-head"><span class="font-semibold text-text">{h.name}</span> <span class="badge" data-hue={statusMeaning[h.status].hue}>{h.status}</span></p>
              {h.status === 'Community'
                ? <p class="mt-3 text-muted">ai-memory ships no installer for this one. The server recognizes its hook events, and the plugin is maintained by the community. Review it before you install it: <a class="underline font-semibold text-text" href="https://github.com/MrLuciano/ai-memory-hermes-plugin">ai-memory-hermes-plugin on GitHub</a>.</p>
                : <div class="mt-3"><CodeBlock title={h.name} code={commandsFor(h)} /></div>}
              <p class="mt-3 text-sm text-muted">{h.note}{(h.status === 'Supported' || h.status === 'MCP-only') && ' Leave out --apply to print the change without writing it.'}</p>
            </div>
          ))}
        </div>

        <div class="table-wrap">
          <table class="table-site agents">
            <caption class="sr-only">Supported coding agents and editors</caption>
            <thead>
              <tr><th scope="col">Agent</th><th scope="col">Status</th><th scope="col">Notes</th><th scope="col"><code>ai-memory run</code></th></tr>
            </thead>
            <tbody>
              {harnesses.map((h, i) => (
                <tr data-status={h.status} data-id={h.id} data-selected={i === 0 ? 'true' : 'false'}>
                  <th scope="row"><button type="button" class="row-pick">{h.name}</button></th>
                  <td><span class="badge" data-hue={statusMeaning[h.status].hue}>{h.status}</span></td>
                  <td class="text-muted">{h.note}</td>
                  <td>{h.run ? <span class="yes">Managed</span> : <span class="text-muted">Direct launch</span>}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <h3 class="text-xl mt-16">What each status means</h3>
    <dl class="legend mt-6">
      {(Object.keys(statusMeaning) as Status[]).map((s) => (
        <div data-hue={statusMeaning[s].hue}>
          <dt><span class="badge">{s}</span></dt>
          <dd class="mt-2 text-muted" set:html={statusMeaning[s].means.replace(/`([^`]+)`/g, '<code>$1</code>')} />
        </div>
      ))}
    </dl>
    <p class="mt-10 text-muted max-w-[40em]">Per-agent details, config file locations and known quirks are in <a class="underline font-semibold text-text" href={`${site.docs}/support-matrix.md`}>the support matrix</a> and <a class="underline font-semibold text-text" href={`${site.docs}/mcp-install.md`}>the MCP install guide</a>.</p>
  </Section>

  <Section title="Hooks capture, MCP answers" lede="These are two separate connections, and a fully supported agent has both. The status labels above say which ones your agent gets." hue="violet">
    <Figure src={hooksMcpImg} alt="Diagram with two lanes. Hooks: your agent streams events into memory on its own, which is automatic capture. MCP: your agent sends a request to memory and gets an answer back, which are tools the agent calls." />
    <div class="grid md:grid-cols-2 gap-x-12 gap-y-10">
      <div data-hue="green" class="lane">
        <h3 class="text-xl">Hooks</h3>
        <p class="mt-2 text-muted">The agent’s lifecycle events fire a small command that records prompts, tool calls and session boundaries. You do nothing, and the agent spends no tokens on it. Secrets are stripped before anything is stored.</p>
      </div>
      <div data-hue="azure" class="lane">
        <h3 class="text-xl">MCP</h3>
        <p class="mt-2 text-muted">The agent gets memory tools it can call when the conversation needs them: search, read a page, write a page, accept a handoff. MCP-only agents can use memory fully, but nothing is captured unless they write it.</p>
      </div>
    </div>
    <div class="mt-12">
      <Callout title="What “managed” adds" hue="violet">
        <p><code>ai-memory run &lt;agent&gt;</code> launches the agent with hooks and MCP already wired, and resumes the same piece of work when you switch between managed agents. Agents marked “direct launch” work the normal way: install once, then start them as you always do.</p>
      </Callout>
    </div>
  </Section>

  <Section id="platforms" title="Operating systems" lede="One Rust binary per platform. On Windows, WSL2 is the supported path and the native build is experimental." hue="azure" tint>
    <div class="table-wrap">
      <table class="table-site plat">
        <caption class="sr-only">Supported operating systems</caption>
        <thead><tr><th scope="col">Platform</th><th scope="col">Status</th><th scope="col">How it installs</th><th scope="col">Notes</th></tr></thead>
        <tbody>
          {platforms.map((p) => (
            <tr>
              <td>{p.name}</td>
              <td><span class="badge" data-hue={statusMeaning[p.status].hue}>{p.status}</span></td>
              <td>{platformHow[p.name]}</td>
              <td class="text-muted">{p.note}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="mt-8 flex flex-wrap gap-3">
      <a href="/download/" class="btn btn-primary">Download the latest release</a>
      <a href={`${site.docs}/windows.md`} class="btn btn-ghost">Read the Windows guide</a>
    </p>
  </Section>

  <Section id="providers" title="LLM and embedding providers" lede="Both are optional. With neither, hooks still capture, search still works, and every session still ends with a summary page and a handoff." hue="green">
    <div class="grid lg:grid-cols-2 gap-x-14 gap-y-14">
      <div>
        <h3 class="text-xl">Embeddings: local by default</h3>
        <p class="mt-2 text-muted max-w-[34em]">Since 2.0, vector search runs in-process with a small open model. It needs no API key and no GPU. The model is about 87 MB, downloads in the background on first start, and hybrid search turns on at the next restart. If the download fails, search keeps working on full text.</p>
        <ul class="chips mt-6">{embeddingProviders.map((p, i) => <li class:list={{ first: i === 0 }}>{p}</li>)}</ul>
        <p class="mt-4 text-sm text-muted">Opt out with <code>embedding_provider = "none"</code>. A provider you configured yourself is never overridden.</p>
      </div>
      <div>
        <h3 class="text-xl">LLM: off by default</h3>
        <p class="mt-2 text-muted max-w-[34em]">Add one when you want LLM-written consolidation, <code>ai-memory bootstrap</code>, richer linting, auto-improve or reranking. A small, fast model is the right size for this work. Subscription logins work, so a paid platform API key is not required.</p>
        <ul class="chips mt-6">{llmProviders.map((p) => <li>{p}</li>)}</ul>
        <p class="mt-4 text-sm text-muted">Check a provider with <code>ai-memory llm-test</code>. Fallback chains are supported.</p>
      </div>
    </div>
    <p class="mt-12 text-muted max-w-[40em]">Models, defaults and costs are in <a class="underline font-semibold text-text" href={`${site.docs}/llm-providers.md`}>the LLM providers guide</a> and <a class="underline font-semibold text-text" href={`${site.docs}/local-embeddings.md`}>the local embeddings guide</a>.</p>
  </Section>

  <Section id="not-listed" title="Your agent is not listed?" lede="Anything that speaks MCP can use the memory tools today." hue="teal" tint>
    <div class="grid lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] gap-x-14 gap-y-10">
      <div class="prose-site text-muted">
        <p>Register a remote HTTP MCP server at this address in your agent’s settings. Search, page reads and writes, and handoffs all work. Automatic capture needs lifecycle hooks, so without them the agent only remembers what it writes.</p>
        <p>Want full support for it? <a href={`${site.docs}/managed-harness-contributions.md`}>The managed-harness contribution guide</a> describes what an adapter has to prove, and <a href="/contribute/">the contribute page</a> says where issues and pull requests go.</p>
      </div>
      <div class="min-w-0"><CodeBlock title="MCP endpoint" code={`# the default local server\nhttp://127.0.0.1:49374/mcp`} /></div>
    </div>
  </Section>

  <NextPages links={[
    { href: '/install/', title: 'Quick setup', text: 'Install the binary, start the server, launch your agent.', hue: 'amber' },
    { href: '/architecture/', title: 'Architecture', text: 'How hooks, MCP and the wiki fit into one binary.', hue: 'azure' },
    { href: '/contribute/', title: 'Contribute', text: 'Add your agent, or fix the one you use.', hue: 'teal' },
  ]} />
  <CtaBand />
</Base>

<noscript><style>[data-agents] [data-panel][hidden] { display: block; margin-bottom: 2rem; } [data-agents] .filters { display: none; }</style></noscript>

<script>
  document.querySelectorAll<HTMLElement>('[data-agents]').forEach((root) => {
    const filters = [...root.querySelectorAll<HTMLButtonElement>('[data-filter]')];
    const rows = [...root.querySelectorAll<HTMLTableRowElement>('tr[data-id]')];
    const panels = [...root.querySelectorAll<HTMLElement>('[data-panel]')];
    const cmd = root.querySelector<HTMLElement>('.cmd')!;

    const select = (row: HTMLTableRowElement, reveal = false) => {
      rows.forEach((r) => r.setAttribute('data-selected', String(r === row)));
      panels.forEach((p) => (p.hidden = p.dataset.panel !== row.dataset.id));
      if (!reveal) return;
      const box = cmd.getBoundingClientRect();
      if (box.top < 80 || box.bottom > innerHeight) cmd.scrollIntoView({ block: 'center', behavior: 'smooth' });
    };

    rows.forEach((r) => r.addEventListener('click', () => select(r, true)));

    filters.forEach((f) => f.addEventListener('click', () => {
      filters.forEach((x) => x.setAttribute('aria-pressed', String(x === f)));
      const want = f.dataset.filter!;
      rows.forEach((r) => (r.hidden = want !== 'all' && r.dataset.status !== want));
      const current = rows.find((r) => r.getAttribute('data-selected') === 'true');
      if (current?.hidden) select(rows.find((r) => !r.hidden)!);
    }));
  });
</script>

<style>
  .table-wrap { position: relative; }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }

  .filters { display: flex; flex-wrap: wrap; gap: .5rem; }
  .pick { display: inline-flex; align-items: center; gap: .5rem; padding: .5rem .95rem; border-radius: 999px; border: 1.5px solid var(--line); font-weight: 600; font-size: .95rem; background: var(--surface); transition: border-color .2s, background-color .2s, color .2s; }
  .pick .n { color: var(--muted); font-weight: 500; font-variant-numeric: tabular-nums; }
  .pick:hover { border-color: var(--text); }
  .pick[aria-pressed='true'] { background: var(--text); border-color: var(--text); color: var(--bg); }
  .pick[aria-pressed='true'] .n { color: inherit; opacity: .7; }
  .pick[data-hue]::before { content: ''; width: .5rem; height: .5rem; border-radius: 50%; background: var(--hue-vivid); }

  .agents-grid { display: grid; gap: 2rem; align-items: start; }
  .cmd { min-width: 0; }
  .cmd-head { display: flex; flex-wrap: wrap; align-items: center; gap: .6rem; font-family: var(--font-display); font-size: var(--text-xl); }
  .legend :global(code), .lede-code { background: var(--tint); border-radius: .35em; padding: .12em .4em; font-size: .9em; }
  @media (min-width: 64rem) {
    .agents-grid { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); }
    .cmd { order: 2; position: sticky; top: 6rem; }
  }

  .agents td { vertical-align: middle; }
  .agents tbody th { background: transparent; text-align: left; padding: 0; border-bottom: 1px solid var(--line); white-space: nowrap; }
  .agents tr:last-child th { border-bottom: 0; }
  .agents tbody tr { cursor: pointer; transition: background-color .15s; }
  .agents tbody tr:hover { background: var(--tint); }
  .agents tbody tr[data-selected='true'] { background: var(--hue-soft); box-shadow: inset 3px 0 0 var(--hue-vivid); }
  .row-pick { display: block; width: 100%; text-align: left; padding: .9rem 1.1rem; font-weight: 600; }
  .row-pick:focus-visible { outline: 2px solid var(--hue-vivid); outline-offset: -2px; }
  .yes { font-weight: 600; color: var(--hue); white-space: nowrap; }
  .agents td:last-child { white-space: nowrap; }
  .agents td:nth-child(3) { min-width: 15rem; }
  /* On phones the note moves to the selected-agent panel, so the table fits without scrolling. */
  @media (max-width: 40rem) { .agents :is(th, td):nth-child(3) { display: none; } .row-pick { white-space: normal; } }
  .plat td:nth-child(n + 3) { min-width: 14rem; }

  .legend { display: grid; gap: 1.75rem 2.5rem; }
  @media (min-width: 40rem) { .legend { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 64rem) { .legend { grid-template-columns: repeat(3, minmax(0, 1fr)); } }

  .lane { border-top: 3px solid var(--hue-vivid); padding-top: 1.1rem; }

  .chips { display: flex; flex-wrap: wrap; gap: .5rem; }
  .chips li { padding: .4rem .85rem; border-radius: 999px; border: 1px solid var(--line); background: var(--surface); font-size: .95rem; font-weight: 500; }
  .chips li.first { background: var(--hue-soft); border-color: var(--hue-vivid); color: var(--hue); font-weight: 600; }
  :global(#providers) code, :global(#agents) .callout-code { background: var(--tint); border-radius: .35em; padding: .12em .4em; font-size: .9em; }
</style>

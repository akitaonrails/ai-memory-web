---
import { useI18n, localePaths } from '@/i18n';
export const getStaticPaths = localePaths;
import facts from '@/data/facts.json';
import Faq from '@/components/Faq.astro';
import BarChart from '@/components/BarChart.astro';
import { faqPage, type Faq } from '@/lib/schema';
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/PageHero.astro';
import Section from '@/components/Section.astro';
import CodeBlock from '@/components/CodeBlock.astro';
import Figure from '@/components/Figure.astro';
import Callout from '@/components/Callout.astro';
import NextPages from '@/components/NextPages.astro';
import CtaBand from '@/components/CtaBand.astro';
import { site } from '@/data/site';
import type { Hue } from '@/data/site';

const { t, raw, href, date, number } = useI18n(Astro, 'research');

const gist = 'https://gist.github.com/karpathy/442a6bf555914893e9891c11519de94f';
const post = 'https://akitaonrails.com/en/2026/09/02/ai-memory-2-0-best-memory-system-for-agents-and-teams/';
const okfSpec = 'https://github.com/GoogleCloudPlatform/knowledge-catalog';

// Scores keep three decimals in every language; only the decimal separator changes.
const score = (n: number) => number(n, { minimumFractionDigits: 3 });

// Structure here, words in src/i18n/locales/<locale>/research.json.
const kept = raw<string[]>('compile.kept.items');
const changed = raw<{ was: string; now: string }[]>('compile.changed.rows');
const okfPoints = raw<string[]>('okf.points');

// Folder names and OKF type values are literals from the specification.
const okfTypes: [string, string][] = [
  ['sessions/', 'Session Summary'],
  ['decisions/', 'Decision'],
  ['gotchas/', 'Gotcha'],
  ['procedures/', 'Procedure'],
  ['concepts/', 'Concept'],
  ['_rules/', 'Rule'],
  ['notes/', 'Note'],
  ['runbooks/', 'Runbook'],
  ['_slots/', t('okf.eitherType', { a: 'Invariant', b: 'State' })],
];

const decisionHues: Hue[] = ['green', 'azure', 'violet', 'azure', 'teal', 'violet', 'amber', 'green'];
const decisions = raw<{ chose: string; because: string }[]>('decisions.items').map((d, i) => ({ ...d, hue: decisionHues[i] }));

const shoulders = [
  { id: 'karpathy', name: 'Karpathy LLM Wiki', href: gist },
  { id: 'agentmemory', name: 'agentmemory', href: 'https://github.com/rohitg00/agentmemory' },
  { id: 'basicMemory', name: 'basic-memory', href: 'https://github.com/basicmachines-co/basic-memory' },
  { id: 'cognee', name: 'cognee', href: 'https://github.com/topoteretes/cognee' },
  { id: 'hermes', name: 'Hermes Agent', href: 'https://github.com/NousResearch/hermes-agent' },
  { id: 'amem', name: 'A-MEM', href: 'https://arxiv.org/abs/2502.12110' },
  { id: 'hindsight', name: 'Hindsight', href: 'https://arxiv.org/abs/2512.12818' },
  { id: 'honcho', name: 'Honcho', href: 'https://github.com/plastic-labs/honcho' },
].map((s) => ({ ...s, gave: t(`priorArt.gave.${s.id}`) }));

// Columns: before 2.0, filtered full text, local embeddings.
const metrics = Object.entries(facts.benchmark.metrics).map(([name, values]) => [name, ...values] as [string, number, number, number]);
const hit5 = facts.benchmark.metrics['hit@5'];
const bench = raw<string[]>('measured.chart.bars').map((label, i) => ({ label, v: hit5[i] }));

const reproduce = `cargo build --release -p ai-memory-cli
cargo run --release -p ai-memory-eval -- retrieval --fetch`;
const exportOkf = `ai-memory export-okf --project myproject -o myproject-bundle.tar.gz`;

const recommended = raw<{ title: string; text: string }[]>('next.recommended.items');

const nextMeta: { href: string; hue: Hue }[] = [
  { href: '/architecture/', hue: 'azure' },
  { href: '/compare/', hue: 'amber' },
  { href: '/contribute/', hue: 'teal' },
];
const nextPages = raw<{ title: string; text: string }[]>('nextPages').map((n, i) => ({ ...n, ...nextMeta[i] }));

const faqParams = { hybrid: score(hit5[2]), fts: score(hit5[1]) };
const faqItems = raw<Faq[]>('faq').map((f) => ({ q: f.q, a: f.a.replace(/\{(\w+)\}/g, (m, k: keyof typeof faqParams) => faqParams[k] ?? m) }));
const faq = faqPage(faqItems);
---
<Base title={t('meta.title')} description={t('meta.description')} schema={[faq]}>
  <PageHero hue="violet" kicker={t('hero.kicker')} title={t('hero.title')} lede={t('hero.lede')}>
    <a href="#measured" class="btn btn-primary">{t('hero.primary')}</a>
    <a href={`${site.docs}/design-decisions.md`} class="btn btn-ghost">{t('hero.secondary')}</a>
  </PageHero>

  <!-- (a) Karpathy -->
  <Section id="compile" hue="green" title={t('compile.title')} lede={t('compile.lede')}>
    <blockquote class="pull">
      <p>{t('quotes.compiled.text')}</p>
      <footer set:html={t('quotes.compiled.by', { href: gist })} />
    </blockquote>

    <div class="mt-12 grid md:grid-cols-2 gap-x-12 gap-y-8 max-w-[64rem]">
      <div>
        <h3 class="text-xl">{t('compile.layers.title')}</h3>
        <p class="mt-2 text-muted">{t('compile.layers.text')}</p>
      </div>
      <div>
        <h3 class="text-xl">{t('compile.operations.title')}</h3>
        <p class="mt-2 text-muted">{t('compile.operations.text')}</p>
      </div>
    </div>

    <Figure name="research-three-layers" alt={t('compile.figure.alt')} caption={t('compile.figure.caption')} />

    <div class="grid grid-cols-[minmax(0,1fr)] lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] gap-12">
      <div>
        <h3 class="text-xl">{t('compile.kept.title')}</h3>
        <ul class="mt-4 space-y-3 text-muted ticks">
          {kept.map((k) => <li>{k}</li>)}
        </ul>
      </div>
      <div>
        <h3 class="text-xl">{t('compile.changed.title')}</h3>
        <p class="mt-2 text-muted max-w-[40em]">{t('compile.changed.text')}</p>
        <div class="table-wrap mt-5">
          <table class="table-site">
            <thead><tr><th>{t('compile.changed.colGist')}</th><th>{t('compile.changed.colHere')}</th></tr></thead>
            <tbody>{changed.map((c) => <tr><td>{c.was}</td><td>{c.now}</td></tr>)}</tbody>
          </table>
        </div>
      </div>
    </div>
    <p class="mt-8 text-muted max-w-[40em]" set:html={t('compile.origin', { href: `${site.docs}/research-karpathy-llm-wiki.md` })} />
  </Section>

  <!-- (b) OKF -->
  <Section id="okf" hue="teal" tint title={t('okf.title')} lede={t('okf.lede')}>
    <div class="grid grid-cols-[minmax(0,1fr)] lg:grid-cols-[minmax(0,7fr)_minmax(0,5fr)] gap-12 items-start">
      <div class="min-w-0">
        <ul class="space-y-3 text-muted ticks max-w-[40em]">
          {okfPoints.map((p) => <li set:html={p} />)}
        </ul>
        <div class="mt-8"><CodeBlock title={t('okf.exportTitle')} code={exportOkf} /></div>
        <p class="mt-5 text-muted max-w-[40em]" set:html={t('okf.noImport', { mapping: `${site.docs}/okf.md`, spec: okfSpec })} />
      </div>
      <div class="table-wrap">
        <table class="table-site">
          <thead><tr><th>{t('okf.colFolder')}</th><th>{t('okf.colType')}</th></tr></thead>
          <tbody>{okfTypes.map(([folder, type]) => <tr><td><code>{folder}</code></td><td>{type}</td></tr>)}</tbody>
        </table>
      </div>
    </div>

    <Figure name="research-okf-bundle" alt={t('okf.figure.alt')} caption={t('okf.figure.caption')} />

    <blockquote class="pull">
      <p>{t('quotes.rented.text')}</p>
      <footer set:html={t('quotes.rented.by', { href: post })} />
    </blockquote>

    <div class="mt-10">
      <Callout title={t('okf.conformance.title')} hue="amber">
        <p>{t('okf.conformance.text')}</p>
      </Callout>
    </div>
  </Section>

  <!-- (c) Decisions -->
  <Section id="decisions" hue="violet" title={t('decisions.title')} lede={t('decisions.lede')}>
    <ul class="grid md:grid-cols-2 gap-x-12 gap-y-10" data-reveal="children">
      {decisions.map((d) => (
        <li class="decision" data-hue={d.hue}>
          <p class="we">{t('decisions.weChose')}</p>
          <h3 class="text-xl mt-1">{d.chose}</h3>
          <p class="mt-3 text-muted" set:html={d.because} />
        </li>
      ))}
    </ul>
    <p class="mt-12"><a class="btn btn-ghost" href={`${site.docs}/design-decisions.md`}>{t('decisions.all')}</a></p>
  </Section>

  <!-- (d) Shoulders -->
  <Section id="prior-art" hue="azure" tint title={t('priorArt.title')} lede={t('priorArt.lede')}>
    <Figure name="research-lineage" alt={t('priorArt.figureAlt')} />
    <dl class="lineage">
      {shoulders.map((s) => (
        <div>
          <dt><a href={s.href}>{s.name}</a></dt>
          <dd>{s.gave}</dd>
        </div>
      ))}
    </dl>
    <p class="mt-10 text-muted max-w-[40em]" set:html={t('priorArt.noEndorsement', { href: href('/compare/') })} />
  </Section>

  <!-- (e) Measured -->
  <Section id="measured" hue="violet" title={t('measured.title')} lede={t('measured.lede')}>
    <div class="grid grid-cols-[minmax(0,1fr)] lg:grid-cols-[minmax(0,7fr)_minmax(0,5fr)] gap-12 items-start">
      <figure class="chart" aria-labelledby="chart-title">
        <figcaption id="chart-title">
          <strong>{t('measured.chart.title')}</strong>
          <span>{t('measured.chart.subtitle')}</span>
        </figcaption>
        <div class="mt-7">
          <BarChart label={t('measured.chart.title')} bars={bench.map((b, i) => ({ label: b.label, value: b.v, display: score(b.v), tone: i === bench.length - 1 ? 'strong' : 'soft' }))} />
        </div>
      </figure>
      <div>
        <h3 class="text-xl">{t('measured.steps.title')}</h3>
        <ul class="mt-4 space-y-3 text-muted ticks">
          <li>{t('measured.steps.stopwords', { hit5: number(5.1), hit1: number(8.5) })}</li>
          <li>{t('measured.steps.embeddings', { points: number(6.6) })}</li>
          <li>{t('measured.steps.noKey')}</li>
        </ul>
      </div>
    </div>

    <div class="table-wrap mt-12">
      <table class="table-site">
        <thead><tr><th>{t('measured.table.metric')}</th><th>{t('measured.table.before')}</th><th>{t('measured.table.filtered')}</th><th>{t('measured.table.local')}</th></tr></thead>
        <tbody>{metrics.map(([name, ...vals]) => <tr><td class="tabular-nums">{name}</td>{vals.map((v) => <td class="tabular-nums">{score(v)}</td>)}</tr>)}</tbody>
      </table>
    </div>

    <div class="mt-12 grid md:grid-cols-2 gap-6">
      <Callout title={t('measured.retrievalOnly.title')} hue="amber">
        <p>{t('measured.retrievalOnly.text')}</p>
      </Callout>
      <Callout title={t('measured.privacyCap.title')} hue="rose">
        <p>{t('measured.privacyCap.text')}</p>
      </Callout>
    </div>

    <div class="mt-12 grid grid-cols-[minmax(0,1fr)] lg:grid-cols-2 gap-10 items-start">
      <div class="min-w-0">
        <h3 class="text-xl">{t('measured.reproduce.title')}</h3>
        <p class="mt-2 text-muted max-w-[40em]" set:html={t('measured.reproduce.text', { date: date(facts.benchmark.date) })} />
        <div class="mt-4"><CodeBlock title={t('measured.reproduce.codeTitle')} code={reproduce} /></div>
        <p class="mt-4"><a class="underline font-semibold" href={`${site.docs}/benchmarks/README.md`}>{t('measured.reproduce.full')}</a></p>
        <p class="mt-6 text-muted max-w-[40em]" set:html={t('measured.throughputNote', { href: href('/architecture/#concurrency') })} />
      </div>
    </div>
  </Section>

  <!-- (f) Next -->
  <Section id="next" hue="amber" tint title={t('next.title')} lede={t('next.lede')}>
    <div class="grid lg:grid-cols-2 gap-x-16 gap-y-12">
      <div>
        <h3 class="text-xl">{t('next.recommended.title')}</h3>
        <ul class="mt-5 space-y-5">
          {recommended.map((n) => (
            <li class="plan">
              <p class="font-semibold">{n.title}</p>
              <p class="text-muted mt-1">{n.text}</p>
            </li>
          ))}
        </ul>
        <p class="mt-6 text-muted max-w-[40em]">{t('next.recommended.notPlanned')}</p>
      </div>
      <div>
        <h3 class="text-xl">{t('next.behind.title')}</h3>
        <p class="mt-5 text-muted max-w-[40em]" set:html={t('next.behind.text', { href: href('/compare/#behind') })} />
      </div>
    </div>

    <blockquote class="pull mt-16">
      <p>{t('quotes.noAsterisk.text')}</p>
      <footer set:html={t('quotes.noAsterisk.by', { href: post })} />
    </blockquote>
  </Section>

  <Faq items={faqItems} />

  <NextPages links={nextPages} />
  <CtaBand title={t('cta.title')} text={t('cta.text')} />
</Base>

<style>
  .pull { max-width: 46rem; border-inline-start: 4px solid var(--hue-vivid); padding-block: .25rem; padding-inline-start: clamp(1.1rem, 3vw, 2rem); }
  .pull p { font-family: var(--font-display); font-weight: 600; font-size: var(--text-2xl); line-height: 1.18; letter-spacing: -.01em; }
  .pull footer { margin-top: 1rem; color: var(--muted); font-size: .95rem; }
  .pull footer :global(a) { text-decoration: underline; color: var(--hue); }


  .decision { border-top: 3px solid var(--hue-vivid); padding-top: 1.1rem; }
  .decision .we { color: var(--hue); font-weight: 600; font-size: .9rem; }
  .decision :global(strong) { color: var(--text); font-weight: 600; }

  .lineage { display: grid; border-top: 1px solid var(--line); }
  .lineage > div { display: grid; grid-template-columns: minmax(0, 14rem) minmax(0, 1fr); gap: .25rem 2rem; padding-block: 1.1rem; border-bottom: 1px solid var(--line); }
  .lineage dt { font-family: var(--font-display); font-weight: 640; font-size: var(--text-lg); }
  .lineage dt a { text-decoration: underline; text-decoration-color: var(--hue-vivid); text-underline-offset: .2em; }
  .lineage dt a:hover { color: var(--hue); }
  .lineage dd { color: var(--muted); max-width: 44em; }
  @media (max-width: 40rem) { .lineage > div { grid-template-columns: minmax(0, 1fr); } }

  .chart figcaption { display: grid; gap: .25rem; }
  .chart figcaption strong { font-family: var(--font-display); font-size: var(--text-xl); font-weight: 640; }
  .chart figcaption span { color: var(--muted); font-size: .95rem; }

  .plan { border-inline-start: 3px solid var(--hue-vivid); padding-inline-start: 1rem; max-width: 40em; }
</style>

---
import { useI18n, localePaths, withText } from '@/i18n';
export const getStaticPaths = localePaths;
import Faq from '@/components/Faq.astro';
import BarChart from '@/components/BarChart.astro';
import { faqPage } from '@/lib/schema';
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/PageHero.astro';
import Section from '@/components/Section.astro';
import FeatureGrid from '@/components/FeatureGrid.astro';
import Steps from '@/components/Steps.astro';
import CodeBlock from '@/components/CodeBlock.astro';
import Figure from '@/components/Figure.astro';
import Callout from '@/components/Callout.astro';
import NextPages from '@/components/NextPages.astro';
import CtaBand from '@/components/CtaBand.astro';
import { site, type Hue } from '@/data/site';
import { competitors, type CompetitorText, type MoatText } from '@/data/competitors';

const { t, raw, href, date, number } = useI18n(Astro, 'compare', 'competitors');
type Titled = { title: string; text: string };

// Structure here, words in src/i18n/locales/<locale>/compare.json and competitors.json.
const tools = competitors.map((c) => ({ id: c.id, ...raw<CompetitorText>(`items.${c.id}`) }));

// (a) What each family of tools optimizes. Families come from the repo's own comparison.
const familyHues: Hue[] = ['green', 'azure', 'violet', 'rose'];
const families = raw<Titled[]>('families.items').map((f, i) => ({ ...f, hue: familyHues[i] }));

const moatHues: Hue[] = ['amber', 'green', 'azure', 'violet', 'rose', 'teal'];
const moatItems = raw<MoatText[]>('moat').map((m, i) => ({ ...m, hue: moatHues[i % moatHues.length] }));

// (c) Moving parts per tool, as indexes into stack.parts. Each mark restates the `needs` list in competitors.json; the last column prints that list as is.
const parts = raw<string[]>('stack.parts');
const requires: Record<string, number[]> = {
  'claude-memory': [],
  mem0: [0, 1],
  zep: [0, 2],
  cognee: [0, 1, 2, 3],
  openviking: [0, 1, 3],
  'basic-memory': [],
  'mcp-memory-service': [],
  agentmemory: [3],
  letta: [3],
  supermemory: [4],
};

// (e) LongMemEval-S hit@5. Source: docs/benchmarks in the repo, dated 2026-09-01.
const benchmarkDate = '2026-09-01';
const score = (n: number) => number(n, { minimumFractionDigits: 3, maximumFractionDigits: 3 });
const oursValues = [0.617, 0.668, 0.823];
const theirsMeta = [{ label: 'mcp-memory-service', value: 0.86 }, { label: 'agentmemory', value: 0.952 }];
const bars = [
  ...raw<{ label: string; note: string }[]>('benchmark.ours').map((b, i) => ({ ...b, value: oursValues[i], mine: true })),
  ...raw<{ note: string }[]>('benchmark.theirs').map((b, i) => ({ ...b, ...theirsMeta[i], mine: false })),
];
const chartLabel = t('benchmark.chartLabel', { bars: bars.map((b) => t('benchmark.chartBar', { label: b.label, value: score(b.value) })).join(' ') });

const behind = raw<Titled[]>('behind.items').map((b) => ({ ...b, hue: 'rose' as Hue }));

const moveMeta: { code?: string }[] = [
  {},
  { code: `cd /path/to/project\nai-memory bootstrap --dry-run\nai-memory bootstrap` },
  { code: `cargo run --manifest-path companions/ai-memory-importer/Cargo.toml -- \\\n  omc-wiki --dir /path/to/omc/wiki --workspace default --project my-project` },
  {},
];
const moveSteps = raw<{ title: string; text: string; codeTitle?: string }[]>('move.steps').map((s, i) => ({
  ...s, ...moveMeta[i], text: s.text.replace('{install}', href('/install/')),
}));

const benchCode = `# ${t('benchmark.code.server')}
cargo build --release -p ai-memory-cli
# ${t('benchmark.code.full')}
cargo run --release -p ai-memory-eval -- retrieval --fetch
# ${t('benchmark.code.smoke')}
cargo run -p ai-memory-eval -- retrieval --sample 10`;

const faq = raw<{ q: string; a: string }[]>('faq.items');
const faqSchema = faqPage(faq);

const nextMeta = [
  { href: '/install/', hue: 'amber' as const },
  { href: '/research/', hue: 'violet' as const },
  { href: '/integrations/', hue: 'violet' as const },
];
const next = withText(nextMeta, raw<Titled[]>('next'));
---
<Base title={t('meta.title')} description={t('meta.description')} schema={[faqSchema]}>
  <PageHero hue="amber" kicker={t('hero.kicker')} title={t('hero.title')} lede={t('hero.lede')}>
    <a href="#tools" class="btn btn-primary">{t('hero.primary')}</a>
    <a href="#behind" class="btn btn-ghost">{t('hero.secondary')}</a>
  </PageHero>

  <Section title={t('families.title')} lede={t('families.lede')} hue="amber" fill>
    <FeatureGrid items={families} cols={4} />
  </Section>

  <Section title={t('unique.title')} lede={t('unique.lede')} hue="amber" tint>
    <FeatureGrid items={moatItems} cols={3} />
    <div class="mt-14">
      <Callout title={t('unique.teamsTitle')} hue="teal">
        <p>{t('unique.teamsText')}</p>
      </Callout>
    </div>
  </Section>

  <Section id="stack" title={t('stack.title')} lede={t('stack.lede')} hue="amber">
    <Figure name="compare-stack" alt={t('stack.figureAlt')} caption={t('stack.figureCaption')} />
    <div class="table-wrap">
      <table class="table-site parts">
        <caption class="sr-only">{t('stack.caption')}</caption>
        <thead>
          <tr>
            <th scope="col">{t('stack.tool')}</th>
            {parts.map((p) => <th scope="col" class="part">{p}</th>)}
            <th scope="col">{t('stack.needs')}</th>
          </tr>
        </thead>
        <tbody>
          <tr class="us">
            <th scope="row">ai-memory</th>
            <td class="part"><span class="mark opt" aria-hidden="true"></span><span class="sr-only">{t('stack.marks.optional')}</span></td>
            {parts.slice(1).map(() => <td class="part"><span class="mark no" aria-hidden="true"></span><span class="sr-only">{t('stack.marks.notNeeded')}</span></td>)}
            <td>{t('stack.ours')}</td>
          </tr>
          {tools.map((c) => (
            <tr>
              <th scope="row"><a href={`#${c.id}`} class="underline">{c.name}</a></th>
              {parts.map((_, i) => (
                <td class="part">
                  {requires[c.id]?.includes(i)
                    ? <><span class="mark need" aria-hidden="true"></span><span class="sr-only">{t('stack.marks.need')}</span></>
                    : <><span class="mark none" aria-hidden="true"></span><span class="sr-only">{t('stack.marks.notNeeded')}</span></>}
                </td>
              ))}
              <td class="text-muted">{c.needs.join(' · ')}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <ul class="legend mt-5">
      <li><span class="mark need" aria-hidden="true"></span>{t('stack.marks.need')}</li>
      <li><span class="mark opt" aria-hidden="true"></span>{t('stack.marks.optional')}</li>
      <li><span class="mark no" aria-hidden="true"></span>{t('stack.marks.notNeededByUs')}</li>
      <li><span class="mark none" aria-hidden="true"></span>{t('stack.marks.notNeeded')}</li>
    </ul>
    <p class="mt-5 text-muted max-w-[40em]">{t('stack.after')}</p>
  </Section>

  <Section id="tools" title={t('tools.title')} lede={t('tools.lede')} hue="amber" tint>
    <div class="tools">
      {tools.map((c, i) => (
        <details id={c.id} class="tool" name="tool" open={i === 0}>
          <summary>
            <span class="min-w-0">
              <span class="name">{c.name}</span>
              <span class="kind">{c.kind}</span>
            </span>
            <svg class="chev" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
          </summary>
          <div class="body">
            <div class="grid md:grid-cols-3 gap-x-10 gap-y-8">
              <div>
                <h3 class="text-lg text-muted">{t('tools.same')}</h3>
                <p class="mt-2">{c.same}</p>
              </div>
              <div>
                <h3 class="text-lg" style="color:var(--amber-ink)">{t('tools.gain')}</h3>
                <ul class="mt-2 space-y-2">{c.gain.map((g) => <li class="gain">{g}</li>)}</ul>
              </div>
              <div>
                <h3 class="text-lg text-muted">{t('tools.theyWin')}</h3>
                <p class="mt-2">{c.theyWin}</p>
              </div>
            </div>
            <p class="verdict"><span class="text-muted">{t('tools.verdict')}</span> {c.verdict}</p>
          </div>
        </details>
      ))}
    </div>
    <p class="mt-8 text-muted max-w-[40em]" set:html={t('tools.after', { comparison: `${site.docs}/comparison.md`, parity: `${site.docs}/competitive-parity.md` })} />
  </Section>

  <Section id="benchmark" title={t('benchmark.title')} lede={t('benchmark.lede')} hue="amber">
    <BarChart label={chartLabel} axis={t('benchmark.axis')} bars={bars.map((b, i) => ({
      label: b.label, note: b.note, value: b.value, display: score(b.value),
      tone: !b.mine ? 'other' : i === oursValues.length - 1 ? 'strong' : 'soft',
    }))} />
    <ul class="dotlist text-muted mt-10 grid md:grid-cols-2 gap-x-10 gap-y-5">
      {raw<string[]>('benchmark.caveats').map((c) => <li>{c.replace('{date}', date(benchmarkDate))}</li>)}
    </ul>
    <div class="mt-10 max-w-[44rem]">
      <p class="text-muted mb-4" set:html={t('benchmark.reproduce', { href: `${site.repo}/tree/main/docs/benchmarks` })} />
      <CodeBlock title={t('benchmark.codeTitle')} code={benchCode} />
    </div>
  </Section>

  <Section id="behind" title={t('behind.title')} lede={t('behind.lede')} hue="rose" tint>
    <FeatureGrid items={behind} cols={3} />
  </Section>

  <Section id="move" title={t('move.title')} lede={t('move.lede')} hue="amber">
    <Figure name="compare-side-by-side" alt={t('move.figureAlt')} />
    <Steps steps={moveSteps} />
    <p class="mt-10 text-muted max-w-[40em]" set:html={t('move.after', { companions: `${site.docs}/companion-crates.md`, cookbook: `${site.docs}/cookbook.md` })} />
  </Section>

  <Faq items={faq} title={t('faq.title')} hue="amber" />

  <NextPages links={next} />
  <CtaBand title={t('cta.title')} text={t('cta.text')} />
</Base>

<script>
  // Deep links from the homepage (/compare/#mem0) open the matching block.
  const openFromHash = () => {
    const el = location.hash && document.getElementById(location.hash.slice(1));
    if (el instanceof HTMLDetailsElement) { el.open = true; el.scrollIntoView({ block: 'start' }); }
  };
  openFromHash();
  addEventListener('hashchange', openFromHash);
  document.querySelectorAll<HTMLAnchorElement>('.parts a[href^="#"]').forEach((a) => a.addEventListener('click', () => setTimeout(openFromHash)));
</script>

<style>
  .table-wrap { position: relative; }

  .parts th.part, .parts td.part { text-align: center; }
  .parts th.part { min-width: 6.5rem; white-space: normal; }
  .parts td { vertical-align: middle; }
  .parts td:last-child { min-width: 15rem; }
  .parts tbody th { background: transparent; text-align: start; font-weight: 600; white-space: nowrap; padding: .9rem 1.1rem; border-bottom: 1px solid var(--line); }
  .parts tr:last-child th { border-bottom: 0; }
  .parts tr.us :is(th, td) { background: var(--hue-soft); }
  .parts tr.us th { color: var(--hue); }
  .mark { display: inline-block; width: 1.05rem; height: 1.05rem; border-radius: 50%; vertical-align: middle; }
  .mark.need { background: var(--text); }
  .mark.opt { border: 2.5px solid var(--hue-vivid); background: transparent; }
  .mark.none { width: .8rem; height: 2px; border-radius: 2px; background: var(--line); }
  .mark.no { background: none; border-radius: 0; width: .95rem; height: .5rem; border-left: 2.5px solid var(--green); border-bottom: 2.5px solid var(--green); rotate: -45deg; translate: 0 -2px; }
  @media (max-width: 40rem) { .parts tbody th { white-space: normal; min-width: 8.5rem; } .parts th.part { min-width: 5rem; font-size: .8rem; } }
  .legend { display: flex; flex-wrap: wrap; gap: .6rem 1.75rem; color: var(--muted); font-size: .92rem; }
  .legend li { display: inline-flex; align-items: center; gap: .6rem; }

  .tools { display: grid; gap: .75rem; }
  .tool { border: 1px solid var(--line); border-radius: 1.25rem; background: var(--surface); scroll-margin-top: 6rem; }
  .tool[open] { border-color: var(--hue-vivid); }
  .tool summary { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: 1.15rem 1.4rem; cursor: pointer; list-style: none; border-radius: 1.25rem; }
  .tool summary::-webkit-details-marker { display: none; }
  .tool .name { display: block; font-family: var(--font-display); font-weight: 640; font-size: var(--text-xl); }
  .tool .kind { display: block; color: var(--muted); font-size: .95rem; margin-top: .15rem; }
  .tool .chev { flex: none; color: var(--muted); transition: rotate .3s var(--ease-out-quint); }
  .tool[open] .chev { rotate: 180deg; }
  .tool .body { padding: .5rem 1.4rem 1.6rem; }
  .verdict { margin-top: 1.75rem; padding-top: 1.1rem; border-top: 1px solid var(--line); font-weight: 600; }
  .verdict span { font-weight: 500; margin-inline-end: .6rem; }


</style>

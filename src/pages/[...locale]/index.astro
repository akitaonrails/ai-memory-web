---
import { useI18n, localePaths } from '@/i18n';
export const getStaticPaths = localePaths;
import { Image } from 'astro:assets';
import Base from '@/layouts/Base.astro';
import Continuity from '@/components/Continuity.astro';
import CodeBlock from '@/components/CodeBlock.astro';
import Tabs from '@/components/Tabs.astro';
import GithubStats from '@/components/GithubStats.astro';
import CtaBand from '@/components/CtaBand.astro';
import Figure from '@/components/Figure.astro';
import logo from '@/assets/img/logo.png';
import { site } from '@/data/site';
import { harnesses } from '@/data/support';
import { competitors, type CompetitorText } from '@/data/competitors';
import { getGithub, getLatestRelease, compact } from '@/data/github';

const { t, raw, href } = useI18n(Astro, 'home', 'competitors');
const gh = await getGithub();
const latest = await getLatestRelease();
const featured = competitors.filter((c) => c.featured).map((c) => ({ id: c.id, ...raw<CompetitorText>(`items.${c.id}`) }));

// Structure here, words in src/i18n/locales/<locale>/home.json.
const pathMeta = [
  { hue: 'violet', href: '/solutions/individuals/' },
  { hue: 'teal', href: '/solutions/teams/' },
  { hue: 'amber', href: '/compare/' },
  { hue: 'green', href: '/contribute/' },
];
const paths = raw<{ who: string; title: string; text: string; cta: string }[]>('paths.items').map((p, i) => ({ ...p, ...pathMeta[i] }));
const steps = raw<{ title: string; text: string }[]>('how.steps');
const facts = raw<string[]>('hero.facts');
const tabs = raw<string[]>('quickstart.tabs');

// Commands never change with the language. Only the comments do.
const solo = `# ${t('quickstart.solo.c1')}
mise use -g github:akitaonrails/ai-memory

# ${t('quickstart.solo.c2')}
ai-memory init
ai-memory serve --transport http --bind 127.0.0.1:49374

# ${t('quickstart.solo.c3')}
ai-memory run claude`;

const team = `# ${t('quickstart.team.c1')}
TOKEN=$(ai-memory generate-auth-token)
docker run -d --name ai-memory --restart unless-stopped \\
  -p 0.0.0.0:49374:49374 -v ai-memory-data:/data \\
  -e AI_MEMORY_AUTH_TOKEN="$TOKEN" \\
  -e AI_MEMORY_ALLOWED_HOSTS="<server-ip>,localhost" \\
  akitaonrails/ai-memory:latest

# ${t('quickstart.team.c2')}
export AI_MEMORY_SERVER_URL="http://<server-ip>:49374"
export AI_MEMORY_AUTH_TOKEN="<${t('quickstart.team.theirKey')}>"
ai-memory run claude`;
---
<Base>
  <!-- Hero -->
  <section class="hero">
    <div class="hero-aura" aria-hidden="true"></div>
    <div class="wrap relative grid lg:grid-cols-[minmax(0,7fr)_minmax(0,5fr)] gap-10 items-center pt-32 pb-16 md:pt-40 lg:pt-44 lg:pb-24">
      <div>
        <a href={href('/download/')} class="release-pill">
          <span class="dot" aria-hidden="true"></span>
          {t('hero.releaseOut', { tag: latest.tag })}
          <span class="text-muted">{t('hero.releaseLink')}</span>
        </a>
        <h1 class="mt-7 text-4xl spectrum-text pb-2">{t('hero.title')}</h1>
        <p class="lede mt-6">{t('hero.lede')}</p>
        <div class="mt-9 flex flex-wrap gap-3">
          <a href={href('/install/')} class="btn btn-primary">{t('hero.primary')}</a>
          <a href={site.repo} class="btn btn-ghost">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="var(--amber)" aria-hidden="true"><path d="m8 .9 2.2 4.6 5 .7-3.6 3.5.9 5L8 12.3l-4.5 2.4.9-5L.8 6.2l5-.7z"/></svg>
            {t('hero.star')}
            <span data-gh="stars" class="tabular-nums text-muted">{compact(gh.stars)}</span>
          </a>
        </div>
        <ul class="facts mt-9">
          {facts.map((f) => <li>{f}</li>)}
        </ul>
      </div>
      <div class="hero-mark" aria-hidden="true">
        <div data-parallax="0.12"><Image src={logo} alt="" width={640} height={640} loading="eager" fetchpriority="high" class="w-full h-auto" /></div>
      </div>
    </div>

    <div class="marquee" aria-label={t('hero.marquee', { n: harnesses.length, names: harnesses.slice(0, 6).map((h) => h.name).join(', ') })}>
      <div class="track" aria-hidden="true" dir="ltr">
        {[...harnesses, ...harnesses].map((h) => <span>{h.name}</span>)}
      </div>
    </div>
  </section>

  <!-- The problem, in one breath -->
  <section class="band">
    <div class="wrap">
      <p class="statement" data-fill>{t('statement')}</p>
    </div>
  </section>

  <Continuity />

  <!-- Pick a path -->
  <section class="band">
    <div class="wrap">
      <h2 class="text-3xl">{t('paths.title')}</h2>
      <div class="mt-12 grid md:grid-cols-2 gap-4" data-reveal="children">
        {paths.map((p) => (
          <a href={href(p.href)} class="path" data-hue={p.hue}>
            <span class="who">{p.who}</span>
            <h3 class="mt-5 text-2xl max-w-[16ch]">{p.title}</h3>
            <p class="mt-3 text-muted">{p.text.replace('{n}', String(gh.contributors))}</p>
            <span class="go">{p.cta}<svg class="flip-rtl" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- How it works -->
  <section class="band !pt-0" id="how">
    <div class="wrap">
      <h2 class="text-3xl max-w-[18ch]">{t('how.title')}</h2>
      <p class="lede mt-5">{t('how.lede')}</p>
      <Figure name="how-it-works" alt={t('how.figureAlt')} />
      <ol class="grid sm:grid-cols-2 lg:grid-cols-4 gap-x-8 gap-y-10">
        {steps.map((s, i) => (
          <li data-hue={['green', 'teal', 'azure', 'violet'][i]} class="how-step">
            <span class="n">{i + 1}</span>
            <h3 class="text-xl mt-3">{s.title}</h3>
            <p class="mt-2 text-muted">{s.text}</p>
          </li>
        ))}
      </ol>
      <p class="mt-12"><a href={href('/architecture/')} class="btn btn-ghost">{t('how.cta')}</a></p>
    </div>
  </section>

  <!-- Memory aging -->
  <section class="band !pt-0" data-hue="teal">
    <div class="wrap">
      <h2 class="text-3xl max-w-[18ch]">{t('aging.title')}</h2>
      <p class="lede mt-5">{t('aging.text')}</p>
      <Figure name="aging-decay-path" alt={t('aging.figureAlt')} />
      <p><a href={href('/aging/')} class="btn btn-ghost">{t('aging.cta')}</a></p>
    </div>
  </section>

  <!-- Compare -->
  <section class="band bg-tint">
    <div class="wrap grid lg:grid-cols-[minmax(0,4fr)_minmax(0,8fr)] gap-12">
      <div>
        <h2 class="text-3xl">{t('compare.title')}</h2>
        <p class="mt-5 text-muted max-w-[28em]">{t('compare.text')}</p>
        <a href={href('/compare/')} class="btn btn-ghost mt-8">{t('compare.cta')}</a>
      </div>
      <div data-tabs>
        <div class="flex flex-wrap gap-2" role="tablist" aria-label={t('compare.pick')}>
          {featured.map((c, i) => (
            <button type="button" role="tab" class="pick" aria-selected={i === 0 ? 'true' : 'false'} aria-controls={`cmp-${c.id}`} id={`cmpt-${c.id}`}>{c.name}</button>
          ))}
        </div>
        {featured.map((c, i) => (
          <div role="tabpanel" id={`cmp-${c.id}`} aria-labelledby={`cmpt-${c.id}`} hidden={i !== 0} class="card mt-5 p-7 md:p-9">
            <p class="text-sm text-muted">{t('compare.needs', { kind: c.kind, needs: c.needs.join(', ') })}</p>
            <div class="mt-6 grid md:grid-cols-2 gap-8">
              <div>
                <h3 class="text-lg text-muted">{t('compare.same')}</h3>
                <p class="mt-2">{c.same}</p>
              </div>
              <div>
                <h3 class="text-lg" style="color:var(--amber-ink)">{t('compare.gain')}</h3>
                <ul class="mt-2 space-y-2">
                  {c.gain.map((g) => <li class="gain">{g}</li>)}
                </ul>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Quick start -->
  <section class="band" id="quickstart">
    <div class="wrap grid lg:grid-cols-[minmax(0,4fr)_minmax(0,8fr)] gap-12">
      <div>
        <h2 class="text-3xl">{t('quickstart.title')}</h2>
        <p class="mt-5 text-muted max-w-[28em]">{t('quickstart.text')}</p>
        <ul class="mt-8 space-y-3 font-semibold">
          <li><a class="underline" href={href('/install/')}>{t('quickstart.links.install')}</a></li>
          <li><a class="underline" href={href('/integrations/')}>{t('quickstart.links.integrations')}</a></li>
          <li><a class="underline" href={href('/download/')}>{t('quickstart.links.download', { tag: latest.tag })}</a></li>
        </ul>
      </div>
      <div class="min-w-0">
        <Tabs id="qs" labels={tabs}>
          <CodeBlock slot="0" title={t('quickstart.soloTitle')} code={solo} />
          <CodeBlock slot="1" title={t('quickstart.teamTitle')} code={team} />
        </Tabs>
      </div>
    </div>
  </section>

  <!-- Open source -->
  <section class="band !pt-0">
    <div class="wrap">
      <h2 class="text-3xl max-w-[18ch]">{t('community.title')}</h2>
      <div class="mt-12"><GithubStats /></div>
      <div class="mt-12 flex flex-wrap items-center gap-x-6 gap-y-5">
        <ul class="flex -space-x-2.5">
          {gh.people.slice(0, 14).map((p) => (
            <li><a href={p.url} title={p.login}><img src={`${p.avatar}&s=88`} alt={p.login} width="44" height="44" loading="lazy" class="size-11 rounded-full ring-2 ring-bg" /></a></li>
          ))}
        </ul>
        <p class="text-muted max-w-[30em]" set:html={t('community.text', { href: href('/contribute/') })} />
      </div>
    </div>
  </section>

  <CtaBand />
</Base>


<style>
  .hero { position: relative; overflow: clip; }
  .hero-aura { position: absolute; inset-block: -20% 0; inset-inline: 35% -10%; background: conic-gradient(from 210deg at 60% 45% in oklch, var(--v-green), var(--v-teal), var(--v-azure), var(--v-violet), var(--v-rose), var(--v-green)); filter: blur(110px); opacity: .28; pointer-events: none; }
  :global([data-theme='light']) .hero-aura { opacity: .2; }
  .release-pill { display: inline-flex; align-items: center; gap: .6rem; padding: .4rem .9rem; border-radius: 999px; border: 1px solid var(--line); background: color-mix(in oklch, var(--surface) 70%, transparent); font-size: .9rem; font-weight: 600; }
  .release-pill .dot { width: .5rem; height: .5rem; border-radius: 50%; background: var(--v-green); box-shadow: 0 0 0 4px color-mix(in oklch, var(--v-green) 25%, transparent); }
  .release-pill:hover { border-color: var(--text); }
  .facts { display: flex; flex-wrap: wrap; gap: .5rem 1.75rem; color: var(--muted); font-size: .95rem; }
  .facts li { display: flex; align-items: center; gap: .5rem; }
  .facts li::before { content: ''; width: .9rem; height: .5rem; border-left: 2px solid var(--green); border-bottom: 2px solid var(--green); rotate: -45deg; translate: 0 -2px; }
  .hero-mark { max-width: 30rem; margin-inline: auto; width: 100%; filter: drop-shadow(0 30px 80px color-mix(in oklch, var(--v-violet) 40%, transparent)); animation: mark-in 1.4s var(--ease-out-quint) both; }
  @keyframes mark-in { from { opacity: 0; transform: scale(.82) rotate(-6deg); filter: blur(12px); } }

  .marquee { position: relative; overflow: hidden; border-block: 1px solid var(--line); padding-block: 1.1rem; mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent); }
  .track { display: flex; gap: 3rem; width: max-content; animation: slide 70s linear infinite; font-family: var(--font-display); font-weight: 600; font-size: 1.15rem; color: var(--muted); white-space: nowrap; }
  .marquee:hover .track { animation-play-state: paused; }
  @keyframes slide { to { transform: translateX(-50%); } }

  .statement { font-family: var(--font-display); font-weight: 600; font-size: var(--text-3xl); line-height: 1.12; letter-spacing: -.012em; max-width: 22em; font-variation-settings: 'opsz' 96, 'wdth' 94; }

  .path { position: relative; display: flex; flex-direction: column; padding: clamp(1.5rem, 3vw, 2.5rem); border-radius: 1.5rem; background: var(--hue-soft); overflow: hidden; transition: transform .4s var(--ease-out-quint); }
  .path:hover { transform: translateY(-4px); }
  .path .who { align-self: flex-start; padding: .3rem .8rem; border-radius: 999px; background: var(--surface); color: var(--hue); font-weight: 600; font-size: .9rem; }
  .path .go { margin-top: auto; padding-top: 2rem; display: inline-flex; align-items: center; gap: .5rem; font-weight: 600; color: var(--hue); }
  .path .go svg { transition: transform .3s var(--ease-out-quint); }
  .path:hover .go svg { translate: 5px 0; }
  :global([dir='rtl']) .path:hover .go svg { translate: -5px 0; }

  .how-step .n { display: inline-grid; place-items: center; width: 2.25rem; height: 2.25rem; border-radius: 50%; background: var(--hue-soft); color: var(--hue); font-family: var(--font-display); font-weight: 700; }

</style>

---
import { useI18n, localePaths } from '@/i18n';
export const getStaticPaths = localePaths;
import ArchiveBackdrop from '@/components/ArchiveBackdrop.astro';
import MemoryApparatus from '@/components/MemoryApparatus.astro';
import Base from '@/layouts/Base.astro';
import Continuity from '@/components/Continuity.astro';
import CodeBlock from '@/components/CodeBlock.astro';
import Tabs from '@/components/Tabs.astro';
import GithubStats from '@/components/GithubStats.astro';
import CtaBand from '@/components/CtaBand.astro';
import Figure from '@/components/Figure.astro';
import factsData from '@/data/facts.json';
import { harnesses } from '@/data/support';
import { competitors, type CompetitorText } from '@/data/competitors';
import { getGithub, getLatestRelease } from '@/data/github';

const { t, raw, href } = useI18n(Astro, 'home', 'competitors');
const { t: teamText } = useI18n(Astro, 'teams');
const gh = await getGithub();
const latest = await getLatestRelease();

const featured = competitors.filter((c) => c.featured).map((c) => ({ id: c.id, ...raw<CompetitorText>(`items.${c.id}`) }));

// Structure here, words in src/i18n/locales/<locale>/home.json.
const pathMeta = [
  { hue: 'violet', href: '/solutions/individuals/' },
  { hue: 'teal', href: '/solutions/teams/' },
  { hue: 'amber', href: '/compare/' },
  { hue: 'green', href: '/contribute/' },
];
const paths = raw<{ who: string; title: string; text: string; cta: string }[]>('paths.items').map((p, i) => ({ ...p, ...pathMeta[i] }));
const steps = raw<{ title: string; text: string }[]>('how.steps');
const facts = raw<string[]>('hero.facts');

// Keep agent support and measured evidence here; other features have their own sections. Structure here, words in home.json.
const cardMeta = [
  { href: '/#how', hue: 'green' },
  { href: '/profile/', hue: 'amber' },
  { href: '/integrations/', hue: 'violet' },
  { href: '/install/', hue: 'teal' },
  { href: '/aging/', hue: 'teal' },
  { href: '/research/#measured', hue: 'violet' },
  { href: '/architecture/#retrieval', hue: 'azure' },
] as const;
const cardParams = { n: String(harnesses.length), score: factsData.benchmark.metrics['hit@5'][3].toFixed(3) };
const cards = raw<{ kicker: string; title: string; text: string; cta: string }[]>('hero.cards').map((c, i) => ({
  ...c, ...cardMeta[i], title: c.title.replace(/\{(\w+)\}/g, (m, k: keyof typeof cardParams) => cardParams[k] ?? m),
})).filter((_, i) => i === 2 || i === 5 || i === 6);
const tabs = raw<string[]>('quickstart.tabs');

// Commands never change with the language. Only the comments do.
const solo = `# ${t('quickstart.solo.c1')}
curl -fsSL https://github.com/akitaonrails/ai-memory/releases/latest/download/install.sh | sh

# ${t('quickstart.solo.c2')}
ai-memory setup

# ${t('quickstart.solo.c3')}
ai-memory run claude`;


---
<Base>
  <!-- Hero -->
  <section class="hero">
    <div class="hero-environment signal-panel">
      <ArchiveBackdrop />
      <div class="wrap hero-panel grid lg:grid-cols-[minmax(0,7fr)_minmax(0,5fr)] gap-10 items-center">
        <div>
          <a href={href('/download/')} class="release-pill">
            <span class="dot" aria-hidden="true"></span>
            {t('hero.releaseOut', { tag: latest.tag })}
            <span class="text-muted">{t('hero.releaseLink')}</span>
          </a>
          <h1 class="mt-7 text-4xl pb-2" set:html={t('hero.title')} />
          <p class="lede mt-6">{t('hero.lede')}</p>
          <div class="mt-9 flex flex-wrap gap-3">
            <a href={href('/install/')} class="btn btn-primary">{t('hero.primary')}</a>
            <a href="#how" class="btn btn-ghost">{t('hero.secondary')}</a>
          </div>
          <nav class="hero-shortcuts mt-6 flex flex-wrap gap-x-6 gap-y-3" aria-label={t('paths.title')}>
            <a href="#guide-title">{t('guide.title')}</a>
            <a href="#paths">{t('paths.title')}</a>
          </nav>
          <ul class="facts mt-9">
            {facts.map((f) => <li>{f}</li>)}
          </ul>
        </div>
        <MemoryApparatus />
      </div>
    </div>
    <div class="marquee">
      {/* Same sentence the aria-label carried, as text a screen reader can read: aria-label is prohibited on a plain div. */}
      <p class="sr-only">{t('hero.marquee', { n: harnesses.length, names: harnesses.slice(0, 6).map((h) => h.name).join(', ') })}</p>
      <div class="agent-list wrap" dir="ltr">
        {harnesses.slice(0, 6).map((h) => <span>{h.name}</span>)}
        <a href={href('/integrations/#agents')}>{t('hero.cards.2.cta')}</a>
      </div>
    </div>
  </section>

  <section class="band" aria-labelledby="guide-title">
    <div class="wrap guide-panel">
      <h2 id="guide-title" class="text-2xl">{t('guide.title')}</h2>
      <div class="mt-6 grid lg:grid-cols-2 gap-8">
        <div class="space-y-4 text-muted"><p>{t('guide.purpose')}</p><p>{t('guide.capture')}</p><p>{t('guide.boundary')}</p></div>
        <ul class="space-y-5 font-semibold underline">
          <li><a href={href('/security/#controls')}>{t('guide.controls')}</a></li>
          <li><a href={href('/profile/')}>{t('guide.profile')}</a></li>
          <li><a href={href('/solutions/individuals/#need')}>{t('guide.fit')}</a></li>
        </ul>
      </div>
    </div>
  </section>

  <!-- Pick a path -->
  <section class="band !pt-0" id="paths">
    <div class="wrap">
      <h2 class="text-3xl">{t('paths.title')}</h2>
      <div class="mt-12 grid md:grid-cols-2 gap-4" data-reveal="children">
        {paths.map((p) => (
          <a href={href(p.href)} class="path" data-hue={p.hue}>
            <span class="who">{p.who}</span>
            <h3 class="mt-5 text-2xl max-w-[16ch]">{p.title}</h3>
            <p class="mt-3 text-muted">{p.text.replace('{n}', String(gh.contributors))}</p>
            <span class="go">{p.cta}<svg class="flip-rtl" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- How it works -->
  <section class="band" id="how">
    <div class="wrap">
      <h2 class="text-3xl max-w-[18ch]">{t('how.title')}</h2>
      <p class="lede mt-5">{t('how.lede')}</p>
      <Figure name="how-it-works" alt={t('how.figureAlt')} />
      <ol class="grid sm:grid-cols-2 lg:grid-cols-4 gap-x-8 gap-y-10">
        {steps.map((s, i) => (
          <li data-hue={['teal', 'amber', 'violet', 'violet'][i]} class="how-step">
            <span class="n">{i + 1}</span>
            <h3 class="text-xl mt-3">{s.title}</h3>
            <p class="mt-2 text-muted">{s.text}</p>
          </li>
        ))}
      </ol>
      <p class="mt-12"><a href={href('/architecture/')} class="btn btn-ghost">{t('how.cta')}</a></p>
    </div>
  </section>

  <!-- Quick start -->
  <section class="band" id="quickstart">
    <div class="wrap grid lg:grid-cols-[minmax(0,4fr)_minmax(0,8fr)] gap-12">
      <div>
        <h2 class="text-3xl">{t('quickstart.title')}</h2>
        <p class="mt-5 text-muted max-w-[28em]">{t('quickstart.text')}</p>
        <ul class="mt-8 space-y-3 font-semibold">
          <li><a class="underline" href={href('/install/')}>{t('quickstart.links.install')}</a></li>
          <li><a class="underline" href={href('/integrations/')}>{t('quickstart.links.integrations')}</a></li>
          <li><a class="underline" href={href('/download/')}>{t('quickstart.links.download', { tag: latest.tag })}</a></li>
        </ul>
      </div>
      <div class="min-w-0">
        <Tabs id="qs" labels={tabs}>
          <CodeBlock slot="0" title={t('quickstart.soloTitle')} code={solo} />
          <div slot="1" class="card p-6 md:p-8">
            <h3 class="text-xl">{teamText('suitability.title')}</h3>
            <p class="mt-4 text-muted">{teamText('suitability.text')}</p>
            <p class="mt-4 text-muted">{teamText('suitability.cost')}</p>
            <div class="mt-6 flex flex-wrap gap-3">
              <a href={href('/install/#team')} class="btn btn-primary">{teamText('hero.primary')}</a>
              <a href={href('/security/#limits')} class="btn btn-ghost">{teamText('hero.secondary')}</a>
            </div>
          </div>
        </Tabs>
      </div>
    </div>
  </section>

  <section class="wrap feature-directory" aria-label={t('paths.title')}>
    {cards.map((c) => (
      <a href={href(c.href)} class="directory-link" data-hue={c.hue}>
        <span class="kicker">{c.kicker}</span>
        <h2>{c.title}</h2>
        <p>{c.text}</p>
        <span class="directory-cta">{c.cta}<span aria-hidden="true"> ↗</span></span>
      </a>
    ))}
  </section>

  <Continuity />

  <!-- Memory aging -->
  <section class="band !pt-0" data-hue="teal">
    <div class="wrap">
      <h2 class="text-3xl max-w-[18ch]">{t('aging.title')}</h2>
      <p class="lede mt-5">{t('aging.text')}</p>
      <Figure name="aging-decay-path" alt={t('aging.figureAlt')} />
      <p><a href={href('/aging/')} class="btn btn-ghost">{t('aging.cta')}</a></p>
    </div>
  </section>

  <!-- Memory across projects -->
  <section class="band !pt-0" data-hue="amber">
    <div class="wrap">
      <h2 class="text-3xl max-w-[18ch]">{t('profile.title')}</h2>
      <p class="lede mt-5">{t('profile.text')}</p>
      <Figure name="profile-two-axes" alt={t('profile.figureAlt')} />
      <p><a href={href('/profile/')} class="btn btn-ghost">{t('profile.cta')}</a></p>
    </div>
  </section>

  <!-- Compare -->
  <section class="band bg-tint">
    <div class="wrap grid lg:grid-cols-[minmax(0,4fr)_minmax(0,8fr)] gap-12">
      <div>
        <h2 class="text-3xl">{t('compare.title')}</h2>
        <p class="mt-5 text-muted max-w-[28em]">{t('compare.text')}</p>
        <a href={href('/compare/')} class="btn btn-ghost mt-8">{t('compare.cta')}</a>
      </div>
      <div data-tabs>
        <div class="flex flex-wrap gap-2" role="tablist" aria-label={t('compare.pick')}>
          {featured.map((c, i) => (
            <button type="button" role="tab" class="pick" aria-selected={i === 0 ? 'true' : 'false'} aria-controls={`cmp-${c.id}`} id={`cmpt-${c.id}`}>{c.name}</button>
          ))}
        </div>
        {featured.map((c, i) => (
          <div role="tabpanel" id={`cmp-${c.id}`} aria-labelledby={`cmpt-${c.id}`} hidden={i !== 0} class="card mt-5 p-7 md:p-9">
            <p class="text-sm text-muted">{t('compare.needs', { kind: c.kind, needs: c.needs.join(', ') })}</p>
            <div class="mt-6 grid md:grid-cols-2 gap-8">
              <div>
                <h3 class="text-lg text-muted">{t('compare.same')}</h3>
                <p class="mt-2">{c.same}</p>
              </div>
              <div>
                <h3 class="text-lg" style="color:var(--amber-ink)">{t('compare.gain')}</h3>
                <ul class="mt-2 space-y-2">
                  {c.gain.map((g) => <li class="gain">{g}</li>)}
                </ul>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Open source -->
  <section class="band !pt-0">
    <div class="wrap">
      <h2 class="text-3xl max-w-[18ch]">{t('community.title')}</h2>
      <div class="mt-12"><GithubStats /></div>
      <div class="mt-12 flex flex-wrap items-center gap-x-6 gap-y-5">
        <ul class="flex -space-x-2.5">
          {gh.people.slice(0, 14).map((p) => (
            <li><a href={p.url} title={p.login}><img src={`${p.avatar}&s=88`} alt={p.login} width="44" height="44" loading="lazy" class="size-11 rounded-full ring-2 ring-bg" /></a></li>
          ))}
        </ul>
        <p class="text-muted max-w-[30em]" set:html={t('community.text', { href: href('/contribute/') })} />
      </div>
    </div>
  </section>

  <CtaBand />
</Base>


<style>
  .hero { padding-block-start: 4rem; }
  .hero-environment { position: relative; isolation: isolate; border-bottom: 1px solid var(--panel-line); }
  .hero-panel { position: relative; padding-block: clamp(3.5rem, 7vw, 7rem); min-height: 46rem; }
  h1 { font-size: clamp(2.875rem, 5.3vw, 5rem); line-height: 1.04; max-width: 15ch; font-weight: 600; letter-spacing: -.035em; }
  h1 :global(em) { display: block; font-style: normal; color: var(--amber); }
  .hero-panel .lede { font-size: 1.125rem; max-width: 49ch; }
  .release-pill { display: inline-flex; flex-wrap: wrap; align-items: center; gap: .6rem; font: .875rem/1.6 var(--font-mono); color: var(--panel-text); }
  .release-pill .dot { width: .5rem; height: .5rem; background: var(--capture); }
  .release-pill:hover { text-decoration: underline; }
  .facts { display: grid; gap: .65rem; color: var(--panel-muted); font: .875rem/1.6 var(--font-mono); }
  .facts li::before { content: '+'; margin-inline-end: .75rem; color: var(--amber); }
  .marquee { margin-top: 1.5rem; }
  .hero-shortcuts a { font-size: 1rem; text-decoration: underline; padding-block: .25rem; }
  .agent-list a { color: var(--teal); text-decoration: underline; font-size: 1rem; }
  .agent-list { display: flex; flex-wrap: wrap; gap: .8rem 2rem; padding-block: 1.5rem; border-bottom: 2px solid var(--line); font-family: var(--font-display); color: var(--muted); }
  .guide-panel a { display: inline-block; padding-block: .25rem; }
  .guide-panel { border-inline-start: 3px solid var(--amber-ink); padding-inline-start: clamp(1.5rem, 4vw, 3rem); }
  .feature-directory { display: grid; grid-template-columns: repeat(auto-fit,minmax(19rem,1fr)); gap: 2rem; padding-block: 3.5rem 0; }
  .directory-link { border-top: 2px solid var(--line); padding-block: 1.3rem; display: flex; flex-direction: column; align-items: start; }
  .directory-link:hover { border-color: var(--amber-ink); }
  .directory-link h2 { font-size: 1.6rem; margin-block: 1rem; }
  .directory-link p { color: var(--muted); font-size: 1rem; }
  .directory-cta { display: block; margin-top: auto; padding-top: 1.3rem; font-weight: 600; text-decoration: underline; }
  .path { position: relative; display: flex; flex-direction: column; padding: clamp(1.5rem, 3vw, 2.5rem); border-block-start: 3px solid var(--hue); background: var(--surface); }
  .path:hover { background: var(--hue-soft); }
  .path .who { font: .875rem/1.6 var(--font-mono); color: var(--hue); }
  .path .go { margin-top: auto; padding-top: 2rem; display: inline-flex; align-items: center; gap: .5rem; font-weight: 600; color: var(--hue); }
  .how-step .n { font: 1rem var(--font-mono); color: var(--hue); border-bottom: 2px solid var(--hue); padding-bottom: .5rem; display: block; }
  @media(max-width:767px) { .agent-list { gap: .5rem 1.25rem; font-size: 1rem; } .feature-directory { grid-template-columns: 1fr; gap: 1rem; } }
</style>

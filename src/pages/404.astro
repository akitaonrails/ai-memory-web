---
import Base from '@/layouts/Base.astro';
---
<Base title="Page not found" description="That page is not part of aimemory.io." noindex>
  <section class="wrap pt-44 pb-32" data-hue="violet">
    <h1 class="text-4xl max-w-[14ch]">This page was never captured.</h1>
    <p class="lede mt-6">The address does not match anything on the site. It may have moved.</p>
    <div class="mt-9 flex flex-wrap gap-3">
      <a href="/" class="btn btn-primary">Go to the homepage</a>
      <a href="/install/" class="btn btn-ghost">Quick setup</a>
      <a href="/integrations/" class="btn btn-ghost">Integrations</a>
    </div>
  </section>
</Base>

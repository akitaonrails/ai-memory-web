---
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/PageHero.astro';
import Section from '@/components/Section.astro';
import FeatureGrid from '@/components/FeatureGrid.astro';
import Figure from '@/components/Figure.astro';
import Callout from '@/components/Callout.astro';
import NextPages from '@/components/NextPages.astro';
import CtaBand from '@/components/CtaBand.astro';
import pipelineImg from '@/assets/img/gen/architecture-pipeline.webp';
import layersImg from '@/assets/img/gen/architecture-layers.webp';
import retrievalImg from '@/assets/img/gen/architecture-retrieval.webp';
import { site } from '@/data/site';

const tree = [
  { path: 'wiki/', note: 'Markdown pages with YAML frontmatter, in a git repository. The source of truth.', hue: 'green' },
  { path: 'db/memory.sqlite', note: 'The derived index: full text, entities, links, embeddings, sessions, audit. WAL mode.', hue: 'azure' },
  { path: 'raw/', note: 'Immutable, sanitized JSONL segments from managed ai-memory run sessions.', hue: 'teal' },
  { path: 'models/', note: 'The local embedding model, all-MiniLM-L6-v2, about 87 MB and SHA-256 pinned.', hue: 'violet' },
  { path: 'logs/', note: 'Rolling daily log output.', hue: 'rose' },
  { path: 'config.toml', note: 'Read once at startup. Every value has an AI_MEMORY_* override.', hue: 'amber' },
];

const pipeline = [
  { title: 'Hook', llm: false, text: 'The agent CLI fires a lifecycle hook. It is fire and forget with a 200 ms budget: native hooks spool the event locally and a detached helper delivers it. The server answers 202, or 429 when saturated.' },
  { title: 'Sanitize', llm: false, text: 'The /hook router strips secrets and caps sizes. This is the only path from untrusted text into the store.' },
  { title: 'Single writer', llm: false, text: 'The sanitized event goes onto one queue, drained by one thread that owns the only write connection.' },
  { title: 'Observations', llm: false, text: 'Events land in SQLite as an operational audit trail. It is a bounded projection of the session, never a full transcript.' },
  { title: 'Session end', llm: false, text: 'Rules, no model, turn the observations into sessions/<id>.md and open a Handoff row for the next agent, in one transaction.' },
  { title: 'Consolidation', llm: true, text: 'With a provider configured, an LLM rewrites the summary or fans it out into concepts/, decisions/, gotchas/ and procedures/. It runs from a retryable queue, outside hook latency.' },
  { title: 'Commit and index', llm: false, text: 'Each page write is atomic (tmp, rename, fsync), committed to git, and indexed in the same SQLite transaction as its row.' },
  { title: 'Query and briefing', llm: false, text: 'memory_query searches the index. At the next SessionStart the hook fetches the open handoff and a structured briefing for that directory.' },
];

const layers = [
  { title: 'Files are the truth', text: 'Pages are markdown with YAML frontmatter under wiki/<workspace>/<project>/. Open them in Obsidian, grep them, push them to a remote.', hue: 'green' as const },
  { title: 'SQLite is derived', text: 'Everything in memory.sqlite that describes a page can be rebuilt from the files with ai-memory reindex. A corrupt index is recoverable.', hue: 'azure' as const },
  { title: 'The server owns writes', text: 'Normal writes go through the wiki layer, which updates the file, the git history and the index together.', hue: 'amber' as const },
  { title: 'A watcher catches the rest', text: 'Edits from vim or Obsidian are picked up by a file watcher. A full diff every 30 seconds catches events it missed.', hue: 'teal' as const },
];

const streams = [
  { title: 'Full text', text: 'SQLite FTS5 over page titles and bodies, with stopwords filtered from bare queries.', hue: 'green' as const },
  { title: 'Entity match', text: 'A lexical index of names from frontmatter entities and tags, weighted by inverse page frequency.', hue: 'teal' as const },
  { title: 'Graph neighbours', text: 'One hop over the links table: wikilinks, markdown links, typed edges and cross-project links. Plain SQL, no graph database.', hue: 'azure' as const },
  { title: 'Vectors, optional', text: 'Cosine similarity over embeddings from the in-process local model. On by default since 2.0, never required, and brute force on purpose.', hue: 'violet' as const },
];

const afterFusion = [
  'Reciprocal Rank Fusion with k=60 merges the streams by rank, so no stream needs score calibration.',
  'A bounded authority multiplier then nudges close contests toward maintained rules, decisions, procedures and gotchas. Episodic and historical pages stay searchable, and nothing is excluded outright.',
  'Optional LLM rerank: one call per query over up to 30 titles and snippets. Any failure keeps the local order. There is no local reranker yet, and the project lists that as its most cited gap.',
  'If compiled pages miss entirely, a bounded search over raw observations returns raw_hits.',
  'Pass explain=true to see per-stream ranks, RRF contributions and the multiplier for every hit.',
];

const throughput = [
  { writers: 1, rate: 42, latency: '23.9 ms' },
  { writers: 8, rate: 295, latency: '3.4 ms' },
  { writers: 32, rate: 698, latency: '1.43 ms' },
  { writers: 128, rate: 700, latency: '1.43 ms' },
];

const crates = [
  ['ai-memory-core', 'Domain types, errors, ids. No IO.'],
  ['ai-memory-store', 'SQLite, the writer actor, the reader pool, decay math.'],
  ['ai-memory-wiki', 'Atomic markdown writes, the file watcher, git.'],
  ['ai-memory-mcp', 'MCP transport and tool router.'],
  ['ai-memory-hooks', 'Payload schemas, the sanitizer, /hook ingress.'],
  ['ai-memory-llm', 'Provider auth boundary, LLM and embedder traits.'],
  ['ai-memory-consolidate', 'Ingest, lint, sweep and the auto-improve pipeline.'],
  ['ai-memory-workstream', 'Read-only native transcript and launch adapters.'],
  ['ai-memory-cli', 'The ai-memory binary and its thin HTTP subcommands.'],
];

const tools = [
  { group: 'Recall', hue: 'violet', names: ['memory_query', 'memory_recent', 'memory_read_page', 'memory_read_session_observations', 'memory_briefing', 'memory_explore', 'memory_status'] },
  { group: 'Handoffs', hue: 'amber', names: ['memory_handoff_begin', 'memory_handoff_list', 'memory_handoff_accept', 'memory_handoff_cancel'] },
  { group: 'Cross-project messages', hue: 'teal', names: ['memory_message_send', 'memory_message_list', 'memory_message_pop', 'memory_message_cancel'] },
  { group: 'Write and maintain', hue: 'green', names: ['memory_write_page', 'memory_delete_page', 'memory_consolidate', 'memory_auto_improve', 'memory_feedback', 'memory_lint', 'memory_forget_sweep', 'memory_install_self_routing'] },
];
const toolCount = tools.reduce((n, t) => n + t.names.length, 0);

const faq = [
  { q: 'Where does ai-memory keep its data?', a: 'In one data directory: a git repository of markdown pages under wiki/, a derived SQLite index under db/, sanitized workstream segments under raw/, the local embedding model under models/, and logs.' },
  { q: 'Does ai-memory need an LLM?', a: 'No. Capture, session summaries, handoffs, indexing, search and the briefing run with no provider configured. LLM consolidation, auto-improvement and rerank are opt-in.' },
  { q: 'What happens if the SQLite index is lost or corrupted?', a: 'The markdown files are the source of truth. ai-memory reindex rebuilds the page index from them. There is no cross-resource transaction between the filesystem and SQLite, and reindex is also how crash windows are resolved.' },
  { q: 'How does retrieval rank results?', a: 'Four candidate streams (FTS5 full text, entity match, graph neighbours and optional vectors) are fused with Reciprocal Rank Fusion at k=60, then adjusted by a bounded source-authority multiplier. LLM rerank is optional, and raw observations are a fallback.' },
  { q: 'How many writes per second can it take?', a: 'The store measures 42 writes per second with one writer, 295 with 8, and a ceiling near 700 from 32 writers up. The numbers come from a fast local disk, and the test drives the store directly without the HTTP front door.' },
];
const schema = [{
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
}];
---
<Base
  title="Architecture: one binary, markdown, a derived index"
  description="How ai-memory works inside: fire-and-forget hooks, a single SQLite writer, markdown in git as the source of truth, and four retrieval streams fused with RRF."
  schema={schema}
>
  <PageHero
    hue="azure"
    kicker="Product"
    title="One binary, markdown files, a derived index"
    lede="Hooks capture what your agent does. Markdown in git holds what was learned. SQLite is a search index you can throw away and rebuild. This page walks the path from a hook to the next session’s briefing, and says where the design is still thin."
  >
    <a href={`${site.docs}/ARCHITECTURE.md`} class="btn btn-primary">Read ARCHITECTURE.md</a>
    <a href={`${site.docs}/design-decisions.md`} class="btn btn-ghost">Why it was built this way</a>
  </PageHero>

  <Section hue="azure" id="layout" title="One binary, one data directory." lede="SQLite is bundled, libgit2 is vendored and the embedder is pure Rust. There is no sidecar, no database server and no queue to run. Everything it knows is in one folder.">
    <div class="tree" role="list" aria-label="The ai-memory data directory">
      <p class="root"><code>&lt;data_dir&gt;/</code></p>
      {tree.map((t) => (
        <div class="node" role="listitem" data-hue={t.hue}>
          <code>{t.path}</code>
          <span>{t.note}</span>
        </div>
      ))}
    </div>
    <p class="mt-8 text-muted max-w-[40em]">The server binds <code class="cfg">127.0.0.1:49374</code> by default. Backing up means <code class="cfg">ai-memory backup</code>, or a git push of the wiki plus an rsync of the folder.</p>
  </Section>

  <Section hue="azure" id="pipeline" tint fill title="From a hook to the next briefing." lede="Seven of these eight steps run with no model and no API key. The LLM step is off until you configure a provider.">
    <Figure wide src={pipelineImg} alt="Diagram: a hook emits events that pass through a sanitize gate into a single writer, are stored as observations, become a session page, optionally fan out into more pages through an LLM, and are committed to the git wiki. A return arrow labelled Briefing runs from the wiki back to the next hook." caption="Only the dashed stage needs an LLM. The return arrow is the briefing injected at the next SessionStart." />
    <ol class="pipe">
      {pipeline.map((p, i) => (
        <li>
          <span class="n" aria-hidden="true">{i + 1}</span>
          <div class="min-w-0">
            <h3 class="text-xl flex flex-wrap items-center gap-x-3 gap-y-1">{p.title}
              <span class="badge" data-hue={p.llm ? 'violet' : 'green'}>{p.llm ? 'Optional LLM' : 'Zero LLM'}</span>
            </h3>
            <p class="mt-2 text-muted">{p.text}</p>
          </div>
        </li>
      ))}
    </ol>
  </Section>

  <Section hue="green" id="truth" title="Two layers, one source of truth." lede="If the files and the index disagree, the files win.">
    <div class="grid lg:grid-cols-[minmax(0,6fr)_minmax(0,6fr)] gap-x-14 items-center">
      <div class="layers-fig">
        <Figure src={layersImg} alt="Diagram: a shelf of markdown pages in git, marked Source of truth, sits above a SQLite index marked Derived. The writer feeds both. A dashed file watcher arrow and a solid reindex arrow both point from the markdown down to the index." />
      </div>
      <FeatureGrid cols={2} items={layers} />
    </div>
    <div class="mt-12">
      <Callout title="There is no transaction across the filesystem and SQLite" hue="amber">
        <p>The design document says it in those words. Index rows commit in the same SQLite transaction as their data, and file writes are atomic, but a crash between the two can leave them out of step. <code>ai-memory reindex</code> resolves those windows by rebuilding from the files.</p>
      </Callout>
    </div>
  </Section>

  <Section hue="violet" id="retrieval" tint title="Retrieval: four streams, one ranking.">
    <Figure src={retrievalImg} alt="Diagram: a query fans out into four lanes labelled FTS5, Entities, Graph and Vectors, with the vector lane dashed as optional. The lanes merge in a node labelled RRF k=60, pass through an Authority scale, and end as a ranked list of results." caption="The vector lane is dashed because search works without it." />
    <FeatureGrid cols={4} items={streams} />
    <h3 class="text-xl mt-16">After fusion</h3>
    <ul class="mt-4 space-y-3 text-muted max-w-[44em] dotlist">
      {afterFusion.map((t) => <li>{t}</li>)}
    </ul>

    <div class="mt-16 grid md:grid-cols-2 gap-x-14 gap-y-12">
      <div data-hue="azure" class="rule-top">
        <h3 class="text-xl">Time: <code class="cfg">as_of</code></h3>
        <ul class="mt-3 space-y-2.5 text-muted dotlist">
          <li>Pass an ISO date to ask what the wiki said about something back then.</li>
          <li>It records ingestion time only: when ai-memory learned a fact and when it replaced it, never when it was true in the world.</li>
          <li>It does not reproduce the ranking a search would have returned on that date.</li>
        </ul>
        <a class="mt-3 inline-block underline font-semibold" style="color:var(--hue)" href={`${site.docs}/temporal.md`}>Temporal validity in the docs</a>
      </div>
      <div data-hue="rose" class="rule-top">
        <h3 class="text-xl">Typed edges</h3>
        <ul class="mt-3 space-y-2.5 text-muted dotlist">
          <li>Frontmatter <code>relations:</code> accepts a closed set: <code>causes</code>, <code>fixes</code>, <code>contradicts</code>. A typo cannot mint a new kind.</li>
          <li><code>contradicts</code> feeds lint with no LLM and is reported until someone reconciles it.</li>
          <li>They are explain only. They join the graph as ordinary links and do not yet move ranking, because the benchmark showed no basis for a weight.</li>
        </ul>
        <a class="mt-3 inline-block underline font-semibold" style="color:var(--hue)" href={`${site.docs}/typed-edges.md`}>Typed edges in the docs</a>
      </div>
    </div>
  </Section>

  <Section hue="amber" id="concurrency" title="One claimant, one writer." lede="Two rules carry most of the correctness: a handoff can be claimed once, and only one thread writes to SQLite.">
    <div class="grid lg:grid-cols-2 gap-x-14 gap-y-16">
      <div class="min-w-0">
        <h3 class="text-xl">Handoffs are a protocol</h3>
        <div class="fsm" role="img" aria-label="State machine: a handoff starts open. Accepting it moves it to accepted, exactly once. Cancelling it, or a newer automatic handoff for the same directory being accepted, moves it to expired.">
          <span class="st" data-hue="amber">open</span>
          <span class="arrows" aria-hidden="true">
            <span class="edge"><i></i><b>accept, once</b></span>
            <span class="edge"><i></i><b>cancel or superseded</b></span>
          </span>
          <span class="ends">
            <span class="st" data-hue="green">accepted</span>
            <span class="st" data-hue="rose">expired</span>
          </span>
        </div>
        <ul class="mt-6 space-y-2.5 text-muted dotlist">
          <li>A handoff is a typed record: from and to agent, project, cwd, summary, open questions, files touched, next steps.</li>
          <li>Accepting is an atomic compare and set. A second agent asking gets nothing.</li>
          <li>The cwd matches on path boundaries: <code>/repo</code> covers <code>/repo/api</code> and never <code>/repo-other</code>.</li>
          <li>A manual handoff beats the automatic one. Accepting expires older automatic candidates in the same transaction.</li>
          <li>On a shared server a handoff belongs to its owner unless it is sent with <code>shared=true</code>.</li>
        </ul>
      </div>
      <div class="min-w-0" data-hue="azure">
        <h3 class="text-xl">The single-writer rule, measured</h3>
        <p class="mt-3 text-muted max-w-[36em]">All writes pass through one bounded queue of 1024 to one OS thread. Reads use a separate read-only pool. A burst slows its producers down, and no write is dropped.</p>
        <div class="bars mt-6" role="img" aria-label="Bar chart of store throughput: 42 writes per second with 1 writer, 295 with 8, 698 with 32 and 700 with 128.">
          {throughput.map((t) => (
            <div class="bar-row">
              <span class="lab">{t.writers} {t.writers === 1 ? 'writer' : 'writers'}</span>
              <span class="track"><span class="fillbar" style={`width:${Math.max(4, (t.rate / 700) * 100)}%`}></span></span>
              <span class="val tabular-nums">{t.rate}/s <small>{t.latency}</small></span>
            </div>
          ))}
        </div>
        <ul class="mt-6 space-y-2.5 text-muted dotlist">
          <li>The ceiling is about 700 writes per second, flat from 32 writers up. One writer is bound by fsync, not CPU.</li>
          <li>Measured on a fast local disk. A network or slow volume will be materially lower.</li>
          <li>The test drives the store directly and skips the HTTP front door.</li>
          <li>Reproduce it with <code>cargo test -p ai-memory-store --test writer_throughput -- --ignored --nocapture</code>.</li>
        </ul>
      </div>
    </div>
  </Section>

  <Section hue="azure" id="code" tint title="The code, by crate." lede="Nine crates, each with one job and a typed API, with no circular dependencies.">
    <div class="grid lg:grid-cols-[minmax(0,6fr)_minmax(0,6fr)] gap-x-12 gap-y-14 items-start">
      <div class="table-wrap">
        <table class="table-site">
          <thead><tr><th>Crate</th><th>Responsibility</th></tr></thead>
          <tbody>
            {crates.map(([name, job]) => (
              <tr><td><code class="whitespace-nowrap">{name}</code></td><td class="text-muted min-w-[14rem]">{job}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
      <div class="min-w-0">
        <h3 class="text-xl">{toolCount} MCP tools, narrow on purpose</h3>
        <p class="mt-3 text-muted max-w-[36em]">Hooks do the routine capture, so agents rarely need to call these by hand.</p>
        <div class="mt-6 grid gap-6">
          {tools.map((g) => (
            <div data-hue={g.hue}>
              <p class="font-semibold" style="color:var(--hue)">{g.group} <span class="text-muted font-normal">({g.names.length})</span></p>
              <ul class="mt-2 flex flex-wrap gap-1.5">
                {g.names.map((n) => <li><code class="tool">{n}</code></li>)}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </div>
    <p class="mt-12 flex flex-wrap gap-3">
      <a href={`${site.docs}/ARCHITECTURE.md`} class="btn btn-ghost">ARCHITECTURE.md, with all 15 invariants</a>
      <a href={`${site.docs}/design-decisions.md`} class="btn btn-ghost">Design decisions and rejected options</a>
    </p>
  </Section>

  <NextPages links={[
    { href: '/security/', title: 'Security', text: 'What the sanitizer keeps out, what can leave the machine, and how to harden a shared server.', hue: 'rose' },
    { href: '/research/', title: 'Research and rationale', text: 'Karpathy’s wiki, OKF, the prior art, and the published benchmark.', hue: 'violet' },
    { href: '/contribute/', title: 'Contribute', text: 'Where issues, pull requests and new harness adapters go.', hue: 'teal' },
  ]} />
  <CtaBand title="Read the files it writes." text="Install it, run one session, then open the wiki folder in your editor." />
</Base>

<style>
  .cfg, .dotlist code { background: var(--tint); border-radius: .35em; padding: .12em .4em; font-size: .9em; overflow-wrap: anywhere; }
  :global(.bg-tint) .cfg, :global(.bg-tint) .dotlist code { background: var(--surface); }
  .dotlist li { position: relative; padding-left: 1.4rem; }
  .dotlist li::before { content: ''; position: absolute; left: 0; top: .62em; width: .5rem; height: .5rem; border-radius: 50%; background: var(--hue-vivid); }
  .rule-top { border-top: 3px solid var(--hue-vivid); padding-top: 1.1rem; }

  /* Directory tree */
  .tree { max-width: 52rem; }
  .tree .root code { font-weight: 600; }
  .node { position: relative; display: grid; grid-template-columns: 11.5rem minmax(0, 1fr); gap: .25rem 1.25rem; margin-left: .6rem; padding: .85rem 0 .85rem 2rem; border-left: 2px solid var(--line); }
  .node:last-child { border-left-color: transparent; }
  .node::before { content: ''; position: absolute; left: -2px; top: 0; width: 1.4rem; height: 1.6rem; border-left: 2px solid var(--line); border-bottom: 2px solid var(--line); border-bottom-left-radius: .6rem; }
  .node code { color: var(--hue); font-weight: 600; }
  .node span { color: var(--muted); }
  @media (max-width: 40rem) { .node { grid-template-columns: minmax(0, 1fr); } }

  /* Pipeline steps */
  .pipe { display: grid; gap: 2.25rem 3rem; }
  @media (min-width: 48rem) { .pipe { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .pipe li { display: grid; grid-template-columns: 2.5rem minmax(0, 1fr); gap: 1rem; }
  .pipe .n { display: grid; place-items: center; width: 2.5rem; height: 2.5rem; border-radius: 50%; background: var(--hue-soft); color: var(--hue); font-family: var(--font-display); font-weight: 700; }

  .layers-fig :global(.fig) { margin-block: 0 2.5rem; }
  @media (min-width: 64rem) { .layers-fig :global(.fig) { margin-block: 0; } }

  /* Handoff state machine */
  .fsm { margin-top: 1.5rem; display: grid; grid-template-columns: auto minmax(0, 1fr) auto; align-items: center; gap: .75rem; max-width: 34rem; }
  .st { display: inline-block; padding: .5rem 1rem; border-radius: 999px; background: var(--hue-soft); color: var(--hue); font-weight: 600; border: 1.5px solid var(--hue-vivid); text-align: center; }
  .ends, .arrows { display: grid; gap: 1.75rem; }
  .edge { position: relative; display: block; text-align: center; font-size: .85rem; color: var(--muted); padding-bottom: .5rem; }
  .edge b { font-weight: 600; }
  .edge i { position: absolute; left: 0; right: .35rem; bottom: 0; height: 2px; background: var(--amber); }
  .edge i::after { content: ''; position: absolute; right: -.35rem; top: -4px; border: 5px solid transparent; border-left-color: var(--amber); border-right: 0; }

  /* Throughput bars */
  .bars { display: grid; gap: .7rem; max-width: 34rem; }
  .bar-row { display: grid; grid-template-columns: 5.8rem minmax(0, 1fr) 7.2rem; align-items: center; gap: .75rem; font-size: .92rem; }
  .bar-row .lab { color: var(--muted); }
  .bar-row .track { height: .8rem; border-radius: 999px; background: var(--tint); overflow: hidden; }
  .bar-row .fillbar { display: block; height: 100%; border-radius: 999px; background: var(--hue-vivid); }
  .bar-row .val { font-weight: 600; }
  .bar-row small { display: block; font-weight: 400; color: var(--muted); font-size: .8rem; }

  .tool { display: inline-block; background: var(--surface); border: 1px solid var(--line); border-radius: .5rem; padding: .15rem .5rem; font-size: .8rem; }
</style>

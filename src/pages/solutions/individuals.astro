---
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/PageHero.astro';
import Section from '@/components/Section.astro';
import FeatureGrid from '@/components/FeatureGrid.astro';
import CodeBlock from '@/components/CodeBlock.astro';
import Tabs from '@/components/Tabs.astro';
import Figure from '@/components/Figure.astro';
import Callout from '@/components/Callout.astro';
import NextPages from '@/components/NextPages.astro';
import CtaBand from '@/components/CtaBand.astro';
import handoffImg from '@/assets/img/gen/individuals-handoff.webp';
import machinesImg from '@/assets/img/gen/individuals-machines.webp';
import markdownImg from '@/assets/img/gen/individuals-markdown.webp';
import webUi from '@/assets/img/web-project-view.png';
import { site } from '@/data/site';
import { harnesses } from '@/data/support';

const managed = harnesses.filter((h) => h.run).length;

const handoff = [
  { hue: 'violet', title: 'Typed', text: 'A handoff carries a session summary, the next steps and the open questions. The next agent gets it at session start, before you type anything.' },
  { hue: 'amber', title: 'Claimed exactly once', text: 'The first session that starts in that directory takes the baton. A second one asking for it gets nothing, so two agents never resume the same work.' },
  { hue: 'azure', title: 'Automatic, with a manual override', text: 'Every session end writes one. Say "save context for the next session" to write your own, and yours outranks the automatic one.' },
];

const phrases = [
  { say: 'Where did we leave off?', does: 'Reads the pending handoff: summary, next steps, open questions.' },
  { say: 'Have we discussed X?', does: 'Searches the wiki with full text, entities, links and vectors fused into one ranking.' },
  { say: 'Catch me up. I have been away.', does: 'Builds a digest that gets longer the longer you were gone. It is prose with an LLM configured, structured data without one.' },
  { say: 'Remember this permanently.', does: 'Writes a durable, git-versioned page. Pin it and it never decays.' },
  { say: 'Remember this until Friday.', does: 'Writes the page with an expiry date. The forget sweep deletes it after that.' },
  { say: 'That page is out of date.', does: 'Records feedback that lowers the page in future rankings. Feedback never deletes anything.' },
];

const runCode = `cd /path/to/project
ai-memory run claude

# Quit Claude Code, then continue the same workstream in Codex.
ai-memory run codex --yolo

# From any directory: put me back where I was.
ai-memory continue`;

const backfillCode = `# See what would be imported, then import it
ai-memory backfill --dry-run
ai-memory backfill`;

const bootstrapCode = `# Needs an LLM provider on the server
ai-memory bootstrap --dry-run
ai-memory bootstrap`;

const clientCode = `# On the PC and on the notebook
export AI_MEMORY_SERVER_URL="http://<server-ip>:49374"
export AI_MEMORY_AUTH_TOKEN="$TOKEN"
ai-memory install-mcp   --client claude-code --apply
ai-memory install-hooks --agent  claude-code --apply`;

const webCode = `ai-memory serve --transport http --bind 127.0.0.1:49374 --enable-web
# then open http://127.0.0.1:49374/web`;

const wikiCode = `# Copy the wiki out of the container and open it in Obsidian
docker cp ai-memory:/data/wiki ./my-ai-memory-wiki

# Or read its history
git -C /data/wiki log --oneline`;

const defaults = [
  { hue: 'green', title: 'Zero LLM calls', text: 'Capture, session summaries, handoffs and search all run without a model. Summaries are rule based until you add a provider.' },
  { hue: 'teal', title: 'Embeddings run in the binary', text: 'A small local model (all-MiniLM-L6-v2, about 87 MB) downloads once in the background. Vector search turns on at the next restart. No key, no GPU.' },
  { hue: 'azure', title: 'Loopback only', text: 'The default server listens on 127.0.0.1:49374 with no account and no telemetry. Nothing else on the network can reach it.' },
];

const faq = [
  { q: 'Do I need an API key or an LLM to use ai-memory?', a: 'No. Capture, session summaries, handoffs and search work with zero LLM calls. Embeddings for vector search run in-process with a local model. An LLM provider is optional and adds richer consolidation, bootstrap and reranking.' },
  { q: 'Can I use the same memory on a PC and a notebook?', a: 'Yes. Run one ai-memory server on a homelab box or on one of the machines and point both at it. There is no replication between servers. If the notebook is offline, hook events spool locally and drain when the server is reachable again.' },
  { q: 'Is Claude Code’s built-in memory enough?', a: 'For one developer on one machine who only uses Claude Code, it may be. It stops being enough when you add a second agent, a second machine or a second person.' },
  { q: 'Where is my memory stored?', a: 'In a git-versioned folder of plain markdown files in the ai-memory data directory. SQLite holds a search index that can be rebuilt from the files.' },
];
const schema = [{
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
}];
---
<Base
  title="Memory across coding agents, for solo developers"
  description="Switch between Claude Code, Codex and other coding agents mid-task, on a PC or a notebook, without re-explaining your project. No API key, plain markdown."
  schema={schema}
>
  <PageHero
    hue="violet"
    kicker="Solutions"
    title="Stop re-explaining your project"
    lede="You quit one agent, open another, and it already knows the architecture, the approaches that failed and what is still open. It works the same from your PC and your notebook, and it needs no API key."
  >
    <a href="/install/" class="btn btn-primary">Set it up in 5 minutes</a>
    <a href="/integrations/#agents" class="btn btn-ghost">Check your agent</a>
  </PageHero>

  <Section title="Switch agents in the middle of a task" lede="Hit a rate limit in Claude Code at 4 PM. Open Codex in the same directory and keep going." hue="violet" fill>
    <Figure
      src={handoffImg}
      alt="Diagram: a Claude Code session ends and passes a handoff baton through ai-memory to a Codex session. The handoff holds a summary, next steps and open questions. A second terminal that reaches for the same baton is locked out because it was claimed once."
      caption="The handoff is matched by project directory, so the next agent only has to start in the same checkout."
    />
    <FeatureGrid items={handoff} />
    <p class="mt-10 text-muted max-w-[40em]">
      Two agents, Grok Build CLI and Zero, ignore what hooks print at session start. Ask them to accept the handoff and they fetch it over MCP. The <a class="underline font-semibold text-text" href="/integrations/#agents">integrations page lists every agent</a> and what each one supports.
    </p>
  </Section>

  <Section title="What you say day to day" lede="Most days you say nothing. Hooks capture the session, and the session end turns it into wiki pages. When you do want something, plain English is the interface." hue="violet" tint>
    <dl class="says">
      {phrases.map((p) => (
        <div class="row">
          <dt>“{p.say}”</dt>
          <dd>{p.does}</dd>
        </div>
      ))}
    </dl>
    <p class="mt-8 text-muted max-w-[40em]">The <a class="underline font-semibold text-text" href={site.docs + '/usage.md'}>usage guide on GitHub</a> has the full list of phrases and the MCP tool behind each one.</p>
  </Section>

  <Section title="One launcher, and a way in for old projects" hue="amber">
    <div class="grid lg:grid-cols-2 gap-x-12 gap-y-14">
      <div class="min-w-0">
        <h3 class="text-xl">Start your agent with ai-memory run</h3>
        <ul class="mt-4 space-y-2.5 text-muted ticks">
          <li>The first launch installs that agent’s hooks and MCP entry if they are missing. It does this once per agent.</li>
          <li>Switching agents resumes the same workstream, with the visible history on top of the summary handoff.</li>
          <li><code>ai-memory continue</code> finds your most recent checkout from any directory and resumes there.</li>
          <li>It covers {managed} agents today. Launching an agent directly keeps working, and hooks alone already carry the handoff.</li>
        </ul>
        <div class="mt-6"><CodeBlock title="switch harness, keep the workstream" code={runCode} /></div>
      </div>
      <div class="min-w-0">
        <h3 class="text-xl">Adopt a project you already have</h3>
        <p class="mt-4 text-muted max-w-[40em]">The first session in an empty project imports your local agent history once, capped at the newest 25 sessions. You can also run it by hand.</p>
        <div class="mt-6">
          <Tabs id="adopt" labels={['Backfill, no LLM', 'Bootstrap, with an LLM']}>
            <div slot="0">
              <CodeBlock title="import local agent history" code={backfillCode} />
              <p class="mt-4 text-sm text-muted max-w-[40em]">Opt out of the automatic first-run import with <code>AI_MEMORY_BACKFILL_ON_START=false</code>.</p>
            </div>
            <div slot="1">
              <CodeBlock title="seed the wiki from the repository" code={bootstrapCode} />
              <p class="mt-4 text-sm text-muted max-w-[40em]">Bootstrap reads the git log, the README, <code>docs/</code> and your rule files. The project measured a run at well under $0.20 with Kimi 2.6 through OpenRouter. It can write pages that sound right and are wrong, so read the dry run first.</p>
            </div>
          </Tabs>
        </div>
      </div>
    </div>
  </Section>

  <Section id="machines" title="The same memory on your PC and your notebook" lede="Run one small server and point every machine at it. A project is identified by its checkout name, so different paths on each machine land in the same memory." hue="azure" tint>
    <Figure
      src={machinesImg}
      alt="Diagram: a PC and a notebook both connect to one ai-memory server. The notebook is offline, so its events wait in a local spool and drain to the server later. There is only one server."
    />
    <div class="grid lg:grid-cols-2 gap-x-12 gap-y-10">
      <ul class="space-y-4 text-muted ticks max-w-[40em]">
        <li>Put the server on a homelab box, or on whichever machine stays on. It is one binary or one container.</li>
        <li>When the notebook is offline, hook events go to a local spool and drain when the server is reachable again. Each entry has an idempotency key, so nothing is stored twice.</li>
        <li><code>ai-memory status</code> shows how many events are pending and how old the oldest is.</li>
        <li>A server that listens beyond loopback requires a bearer token. The token does not encrypt traffic, so add TLS before leaving your LAN.</li>
      </ul>
      <div class="min-w-0">
        <CodeBlock title="point a machine at the server" code={clientCode} />
      </div>
    </div>
    <div class="mt-12">
      <Callout title="One server, no replication" hue="azure">
        <p>Machines share memory because they reach the same server. Two servers do not sync with each other, and pointing two servers at one synced data folder is unsupported because the wiki does not survive it. The <a href="/advanced/">advanced setup page</a> covers the homelab install, TLS and backups.</p>
      </Callout>
    </div>
  </Section>

  <Section title="No API key, and files you can read" lede="The default install costs nothing to run and stores everything as markdown in a git repository." hue="green">
    <FeatureGrid items={defaults} />
    <Figure
      src={markdownImg}
      alt="Diagram: a wiki folder of plain markdown files at the centre, with spokes to grep, Obsidian, a text editor and rsync, and a git history underneath."
      caption="Edit a page in Obsidian or vim and a file watcher updates the search index."
    />
    <div class="grid lg:grid-cols-2 gap-x-12 gap-y-10 items-start">
      <div class="min-w-0">
        <h3 class="text-xl">Take the files anywhere</h3>
        <p class="mt-3 text-muted max-w-[40em]">The SQLite index is derived from the files and can be rebuilt from them. Back up with <code>ai-memory backup</code>, rsync, or a git push to your own remote.</p>
        <div class="mt-5"><CodeBlock title="the wiki is a git repo" code={wikiCode} /></div>
      </div>
      <div class="min-w-0">
        <h3 class="text-xl">Or browse it in a read-only web UI</h3>
        <p class="mt-3 text-muted max-w-[40em]">One flag adds a browser view with the project list, the page tree, rendered markdown, search and clickable wiki links. It cannot edit anything.</p>
        <div class="mt-5"><CodeBlock title="enable the web UI" code={webCode} /></div>
      </div>
    </div>
    <Figure
      src={webUi}
      alt="Screenshot of the ai-memory web UI showing one project: a page tree grouped into concepts, decisions, gotchas and sessions on the left, and a recent activity list of markdown pages on the right."
      caption="The project view of the web UI. Pages are grouped into concepts, decisions, gotchas and sessions."
    />
  </Section>

  <Section title="Do you need this?" hue="amber" narrow>
    <Callout title="Claude Code’s built-in memory may be enough">
      <p>If you work alone, on one machine, and only use Claude Code, its built-in memory is already on and has no server to run. Stay with it.</p>
      <p>It stops being enough when you:</p>
      <ul class="ticks space-y-2">
        <li>add a second agent, because that memory belongs to Claude Code alone</li>
        <li>add a second machine, because it lives on one laptop</li>
        <li>want to search months of sessions, including what the tools did</li>
        <li>add a second person</li>
      </ul>
      <p>The <a href="/compare/">comparison page</a> covers this and the other memory tools, including where they are ahead.</p>
    </Callout>
    <p class="mt-10"><a href="/install/" class="btn btn-primary">Go to the quick setup</a></p>
  </Section>

  <NextPages links={[
    { href: '/install/', title: 'Quick setup', text: 'Install the binary, start the server, launch your agent through it.', hue: 'amber' },
    { href: '/integrations/', title: 'Agents and platforms', text: 'Which agents get hooks, MCP and the managed launcher, on which OS.', hue: 'violet' },
    { href: '/solutions/teams/', title: 'For teams', text: 'The same server, shared by a few people and all of their agents.', hue: 'teal' },
  ]} />
  <CtaBand title="Give your agents a memory today." text="Free and open source. No account, no API key, and the files stay yours." />
</Base>

<style>
  .says { border-top: 1px solid var(--line); max-width: 60rem; }
  .says .row { display: grid; gap: .35rem 2.5rem; padding-block: 1.1rem; border-bottom: 1px solid var(--line); }
  .says dt { font-family: var(--font-display); font-weight: 600; font-size: 1.1rem; color: var(--hue); }
  .says dd { color: var(--muted); }
  @media (min-width: 48rem) { .says .row { grid-template-columns: minmax(0, 5fr) minmax(0, 8fr); align-items: baseline; } }
  .ticks li { position: relative; padding-left: 1.5rem; }
  .ticks li::before { content: ''; position: absolute; left: 0; top: .7em; width: .8rem; height: 3px; border-radius: 3px; background: var(--hue-vivid); }
  .ticks :global(code), p :global(code) { background: var(--surface); border: 1px solid var(--line); border-radius: .35em; padding: .1em .4em; font-size: .88em; overflow-wrap: anywhere; }
</style>

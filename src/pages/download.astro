---
import { marked } from 'marked';
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/PageHero.astro';
import Section from '@/components/Section.astro';
import CodeBlock from '@/components/CodeBlock.astro';
import NextPages from '@/components/NextPages.astro';
import CtaBand from '@/components/CtaBand.astro';
import { site } from '@/data/site';
import { getGithub } from '@/data/github';

const gh = await getGithub();
const latest = gh.releases.find((r) => !r.prerelease) ?? gh.releases[0];
const day = (iso: string | null) => (iso ? new Date(iso).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' }) : '');
const mb = (n: number) => `${(n / 1048576).toFixed(1)} MB`;
const asset = (name: string) => latest.assets.find((a) => a.name === name);
const dl = (name: string) => `${site.repo}/releases/latest/download/${name}`;

const builds = [
  { os: 'linux', hue: 'green', name: 'Linux', files: [['x86_64', 'ai-memory-linux-x86_64.tar.gz'], ['ARM64', 'ai-memory-linux-aarch64.tar.gz']], note: 'Unpack, run ./ai-memory init, then serve.' },
  { os: 'mac', hue: 'azure', name: 'macOS', files: [['Apple Silicon', 'ai-memory-macos-aarch64.tar.gz'], ['Intel', 'ai-memory-macos-x86_64.tar.gz']], note: 'Includes a launchd agent. If you download with a browser, clear the quarantine flag first.' },
  { os: 'win', hue: 'violet', name: 'Windows', files: [['x86_64', 'ai-memory-windows-x86_64.zip']], note: 'Experimental. WSL2 with the Linux build is the supported path.' },
].map((b) => ({ ...b, files: b.files.map(([label, file]) => ({ label, file, size: asset(file)?.size })) }));

const channels = [
  { title: 'mise', code: 'mise use -g github:akitaonrails/ai-memory', note: 'Linux and macOS. Verifies the checksum for you. New releases can take about a day to appear.' },
  { title: 'Arch Linux (AUR)', code: 'yay -S ai-memory-bin    # prebuilt\nyay -S ai-memory        # from source', note: 'Installs systemd units for a user or a system service.' },
  { title: 'Docker or Podman', code: 'docker pull akitaonrails/ai-memory:latest', note: 'Multi-arch: linux/amd64 and linux/arm64, so Apple Silicon needs no emulation.' },
  { title: 'From source', code: 'git clone https://github.com/akitaonrails/ai-memory\ncd ai-memory && cargo build --release --workspace', note: 'Needs the Rust toolchain pinned in rust-toolchain.toml.' },
];

// Release notes are the project's own markdown. Raw HTML in them is dropped, never rendered.
marked.use({ renderer: { html: () => '' } });
const kinds = ['Added', 'Changed', 'Fixed', 'Security', 'Removed', 'Deprecated'] as const;
const entries = gh.changelog.map((e) => ({
  ...e,
  html: marked.parse(e.body.replace(/\(#(\d+)\)/g, `([#$1](${site.repo}/issues/$1))`)) as string,
  counts: kinds
    .map((k) => ({ k, n: (e.body.split(new RegExp(`^### ${k}\\s*$`, 'm'))[1]?.split(/^### /m)[0].match(/^- /gm) ?? []).length }))
    .filter((c) => c.n),
}));
---
<Base title="Download ai-memory and read the changelog" description={`Download ai-memory ${latest.tag} for Linux, macOS and Windows, or install it with mise, the AUR or Docker. Checksums, release history and the full changelog.`}>
  <PageHero hue="green" kicker="Developers" title={`Download ai-memory ${latest.tag}`} lede={`Released ${day(latest.date)}. One self-contained binary per platform, each with a SHA-256 checksum next to it. MIT licensed.`}>
    <a href="#builds" class="btn btn-primary">Pick your platform</a>
    <a href="#changelog" class="btn btn-ghost">What changed</a>
  </PageHero>

  <Section title="Binaries" id="builds" hue="green">
    <div class="grid md:grid-cols-3 gap-4">
      {builds.map((b) => (
        <article class="build" data-hue={b.hue} data-os={b.os}>
          <p class="yours badge" hidden>Looks like your system</p>
          <h3 class="text-2xl">{b.name}</h3>
          <ul class="mt-5 space-y-2.5">
            {b.files.map((f) => (
              <li>
                <a href={dl(f.file)} class="file">
                  <span><strong>{f.label}</strong><span class="block text-sm text-muted font-mono">{f.file}</span></span>
                  <span class="text-sm text-muted whitespace-nowrap">{f.size ? mb(f.size) : ''}</span>
                </a>
                <a href={dl(`${f.file}.sha256`)} class="text-sm text-muted underline ml-1">SHA-256 checksum</a>
              </li>
            ))}
          </ul>
          <p class="mt-5 text-muted text-[0.95rem]">{b.note}</p>
        </article>
      ))}
    </div>
    <div class="mt-10 max-w-3xl">
      <CodeBlock title="verify a download" code={`sha256sum -c ai-memory-linux-x86_64.tar.gz.sha256     # macOS: shasum -a 256 -c ...`} />
    </div>
    <p class="mt-6 text-muted">After unpacking, follow the <a class="underline font-semibold text-text" href="/install/">quick setup</a>. It takes three commands.</p>
  </Section>

  <Section title="Package managers and containers" id="channels" hue="azure" tint>
    <div class="grid lg:grid-cols-2 gap-x-8 gap-y-10">
      {channels.map((c) => (
        <div class="min-w-0">
          <h3 class="text-xl mb-3">{c.title}</h3>
          <CodeBlock title={c.title.toLowerCase()} code={c.code} />
          <p class="mt-3 text-muted text-[0.95rem]">{c.note}</p>
        </div>
      ))}
    </div>
    <p class="mt-10 text-muted max-w-[44em]">Client machines that only send hooks to a remote server do not need the full binary. The release also ships <code>ai-memory-install-hooks</code> and wrapper scripts for Docker on Linux, macOS and Windows. They are listed on the <a class="underline font-semibold text-text" href={latest.url}>release page</a>.</p>
  </Section>

  <Section title="Changelog" id="changelog" hue="green" lede={`The last ${entries.length} releases. The project follows semantic versioning since 2.0.`}>
    <div class="log">
      {entries.map((e, i) => (
        <details open={i === 0}>
          <summary>
            <span class="ver">{e.version}</span>
            <time datetime={e.date ?? undefined} class="text-muted">{day(e.date)}</time>
            <span class="counts">{e.counts.map((c) => <span class="badge" data-hue={c.k === 'Fixed' ? 'azure' : c.k === 'Added' ? 'green' : c.k === 'Security' ? 'rose' : 'violet'}>{c.n} {c.k.toLowerCase()}</span>)}</span>
          </summary>
          <div class="notes prose-site" set:html={e.html} />
        </details>
      ))}
    </div>
    <p class="mt-10 flex flex-wrap gap-3">
      <a href={`${site.repo}/blob/main/CHANGELOG.md`} class="btn btn-ghost">Full changelog on GitHub</a>
      <a href={`${site.repo}/releases`} class="btn btn-ghost">All releases</a>
      <a href={`${site.docs}/MIGRATION-2.0.md`} class="btn btn-ghost">Upgrading from 1.x</a>
    </p>
  </Section>

  <NextPages links={[
    { href: '/install/', title: 'Quick setup', text: 'From a binary to a working memory in three commands.', hue: 'amber' },
    { href: '/integrations/', title: 'Integrations', text: 'Check your agent and your operating system.', hue: 'violet' },
    { href: '/advanced/', title: 'Advanced setup', text: 'Services, TLS, backups and upgrades.', hue: 'azure' },
  ]} />
  <CtaBand />
</Base>

<script>
  // Point out the build that matches the visitor's system.
  const ua = navigator.userAgent;
  const os = /Windows/.test(ua) ? 'win' : /Mac/.test(ua) ? 'mac' : /Linux|X11/.test(ua) ? 'linux' : null;
  const card = os && document.querySelector<HTMLElement>(`[data-os="${os}"]`);
  if (card) {
    card.setAttribute('data-yours', '');
    card.querySelector<HTMLElement>('.yours')!.hidden = false;
  }
</script>

<style>
  .build { position: relative; padding: 1.75rem; border-radius: 1.5rem; border: 1px solid var(--line); background: var(--surface); }
  .build[data-yours] { border-color: var(--hue-vivid); box-shadow: 0 0 0 1px var(--hue-vivid), 0 20px 60px -30px var(--hue-vivid); }
  .yours { position: absolute; top: 1.6rem; right: 1.5rem; }
  .file { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: .8rem 1rem; border-radius: .9rem; background: var(--hue-soft); transition: transform .3s var(--ease-out-quint); }
  .file:hover { transform: translateX(3px); }
  .file strong { color: var(--hue); }
  .file .font-mono { font-size: .74rem; word-break: break-all; }

  .log { border-top: 1px solid var(--line); }
  details { border-bottom: 1px solid var(--line); }
  summary { display: flex; flex-wrap: wrap; align-items: baseline; gap: .5rem 1.25rem; padding: 1.2rem 0; cursor: pointer; list-style: none; }
  summary::-webkit-details-marker { display: none; }
  summary::after { content: ''; margin-left: auto; align-self: center; width: .6rem; height: .6rem; border-right: 2px solid var(--muted); border-bottom: 2px solid var(--muted); rotate: 45deg; transition: rotate .3s var(--ease-out-quint); }
  details[open] summary::after { rotate: -135deg; }
  .ver { font-family: var(--font-display); font-weight: 680; font-size: var(--text-xl); min-width: 4.5rem; }
  .counts { display: flex; flex-wrap: wrap; gap: .4rem; }
  .notes { padding: 0 0 2rem; font-size: .97rem; }
  .notes :global(h3) { font-size: 1.05rem; margin: 1.5rem 0 .6rem; color: var(--green); }
  .notes :global(ul) { list-style: disc; padding-left: 1.2rem; display: grid; gap: .6rem; max-width: 52em; }
  .notes :global(li) { color: var(--muted); }
  .notes :global(li strong), .notes :global(li code) { color: var(--text); }
  .notes :global(pre) { overflow-x: auto; background: var(--tint); padding: 1rem; border-radius: .75rem; margin-top: .6rem; }
</style>

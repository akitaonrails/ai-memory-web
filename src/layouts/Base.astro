---
import '@/styles/global.css';
import fontsHe from '@/styles/fonts-he.css?url';
import fontsJa from '@/styles/fonts-ja.css?url';
import fontsKo from '@/styles/fonts-ko.css?url';
import Nav from '@/components/Nav.astro';
import Footer from '@/components/Footer.astro';
import Analytics from '@/components/Analytics.astro';
import { site } from '@/data/site';
import ogImage from '@/assets/img/og.png';
import { getLatestRelease } from '@/data/github';
import { siteGraph } from '@/lib/schema';
import { useI18n, localizePath, stripLocale } from '@/i18n';
import { defaultLocale, localeCodes, locales } from '@/i18n/config';

interface Props {
  title?: string;
  description?: string;
  /** Extra schema.org objects for this page (FAQPage, HowTo, ...). */
  schema?: Record<string, unknown>[];
  noindex?: boolean;
}
const { t, locale, dir, htmlLang, href } = useI18n(Astro);
const { title, description = t('site.description'), schema = [], noindex = false } = Astro.props;
const tagline = t('site.tagline');
const fullTitle = title ? `${title} | ${site.name}` : `${site.name}: ${tagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const home = new URL(href('/'), Astro.site).href;
const latest = await getLatestRelease();

// The same page in every language, for <link rel="alternate" hreflang> and the language switcher.
const barePath = stripLocale(Astro.url.pathname);
const alternates = localeCodes.map((l) => ({ hreflang: locales[l].htmlLang, url: new URL(localizePath(l, barePath), Astro.site).href }));
const localeFonts = { he: fontsHe, ja: fontsJa, ko: fontsKo }[locale as string];

// Breadcrumbs from the URL: /pt-br/solutions/teams/ -> Início > Soluções > (page title)
const segments = noindex ? [] : barePath.split('/').filter(Boolean);
const crumbs = [{ name: t('crumbs.home'), path: '/' }, ...segments.map((seg, i) => ({
  name: i === segments.length - 1 && title ? title : t(`crumbs.${seg}`),
  path: `/${segments.slice(0, i + 1).join('/')}/`,
}))].map((c) => ({ name: c.name, url: new URL(href(c.path), Astro.site).href }));

const structuredData = siteGraph({
  home, canonical: canonical.href, htmlLang, tagline, description, fullTitle,
  version: latest?.tag.replace(/^v/, ''), crumbs, extra: schema,
});

// First-visit language detection for hosts without Netlify's edge redirect (and for `npm run preview`).
// Only English pages run it. The first language in the browser's list that the site supports wins;
// an `nf_lang` cookie, set by the language switcher, means the visitor already chose.
const detect = locale === defaultLocale && !noindex
  ? Object.fromEntries(localeCodes.flatMap((l) => locales[l].match.map((m) => [m, l])))
  : null;
---
<!doctype html>
<html lang={htmlLang} dir={dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {!noindex && alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.url} />)}
    {!noindex && <link rel="alternate" hreflang="x-default" href={new URL(barePath, Astro.site).href} />}
    {localeFonts && <link rel="stylesheet" href={localeFonts} />}
    <meta name="robots" content={noindex ? 'noindex' : 'index, follow, max-image-preview:large'} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="Site summary for language models" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#faf9fd" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0b0c1f" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content={locales[locale].og} />
    {localeCodes.filter((l) => l !== locale).map((l) => <meta property="og:locale:alternate" content={locales[l].og} />)}
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t('site.ogAlt')} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(ogImage.src, Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage.src, Astro.site)} />
    <meta name="author" content={site.author} />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    {detect && (
      <script is:inline define:vars={{ detect, defaultLocale }}>
        if (!/(?:^|; )nf_lang=/.test(document.cookie)) {
          for (const lang of navigator.languages || [navigator.language]) {
            const hit = detect[String(lang).toLowerCase().split('-')[0]];
            if (!hit) continue;
            if (hit !== defaultLocale) location.replace('/' + hit + location.pathname + location.search + location.hash);
            break;
          }
        }
      </script>
    )}
    <!-- Resolve the theme before first paint: saved choice, else the system setting. -->
    <script is:inline>
      (() => {
        let saved = null;
        try { saved = localStorage.getItem('theme'); } catch {}
        const system = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.dataset.theme = saved === 'light' || saved === 'dark' ? saved : system;
      })();
    </script>
    <noscript><style>[data-reveal],[data-fill]{opacity:1!important;transform:none!important}</style></noscript>
  </head>
  <body>
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:z-[100] focus:top-3 focus:start-3 btn btn-primary">{t('a11y.skip')}</a>
    <Nav />
    <main id="main"><slot /></main>
    <Footer />
    <Analytics />
    <script>
      import '@/scripts/theme';
      import '@/scripts/motion';
      import '@/scripts/github-live';
      import '@/scripts/copy';
    </script>
  </body>
</html>
